 "canonical_operator_semantics": {
  "correlation(x,y,d)": "time-serial correlation of x and y for the past d days",
  "covariance(x,y,d)": "time-serial covariance of x and y for the past d days",
  "rank(x)": "cross-sectional rank",
  "scale(x,a)": "rescaled x such that sum(abs(x)) = a; default a = 1",
  "decay_linear(x,d)": "weighted moving average over the past d days with linearly decaying weights d, d-1, ..., 1, rescaled to sum to 1",
  "indneutralize(x,g)": "x cross-sectionally DEMEANED within each group g -- demeaning only, NOT a regression residual and NOT a z-score",
  "min(x,d)": "= ts_min(x,d)",
  "max(x,d)": "= ts_max(x,d)",
  "non_integer_d": "'non-integer number of days d is converted to floor(d)' -- FLOOR, stated explicitly in Appendix A.1"
 },
