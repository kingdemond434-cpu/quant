-    lot = _lot_steps(max(float(raw_lot), 0.0))
+    # A NON-FINITE TARGET IS NO TARGET (ARCH-05 battery, 2026-10-07): `max(nan, 0.0)` is nan and
+    # `math.floor(nan)` raises, so a poisoned fraction surfaced as a ValueError at the call site.
+    raw = float(raw_lot)
+    if not math.isfinite(raw):
+        return 0.0
+    lot = _lot_steps(max(raw, 0.0))
     if not (lot > 0.0) or lot + 1e-9 < venue_min_lot(symbol, info):
         return 0.0
+    # THE VENUE'S OWN MAXIMUM BINDS TOO (ARCH-05 battery case `volume_max_desk_side`). The desk
+    # read `volume_min` and never `volume_max`, so a lot above it reached the broker and was
+    # refused there (10014) -- a rejected order, counted toward the auto-pause, where the
+    # largest order the venue accepts was available. Read from the live handle when it has one.
+    try:
+        vmax = float(getattr(info, "volume_max", 0.0) or 0.0)
+    except (TypeError, ValueError):
+        vmax = 0.0
+    if math.isfinite(vmax) and vmax > 0.0:
+        ceiling = min(ceiling, _lot_steps(vmax))
     return float(min(lot, ceiling))
 
 
