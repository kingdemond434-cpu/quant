diff --git a/desks/mt5/tests/test_lineage_quarantine.py b/desks/mt5/tests/test_lineage_quarantine.py
new file mode 100644
index 000000000..1a7cfa030
--- /dev/null
+++ b/desks/mt5/tests/test_lineage_quarantine.py
@@ -0,0 +1,51 @@
+"""The terms quarantine is a LINEAGE quarantine (PR #162 audit v2, 2026-10-07): the Reddit-judged
+USDJPY certificates are refused by name, the symbol stays open, and the forgone growth is a rail."""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+_DESK = Path(__file__).resolve().parents[1]
+for _p in (str(_DESK), str(_DESK / "research"), str(_DESK.parent.parent)):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+from mt5desk import live_policy  # noqa: E402
+
+
+def _pol(tmp_path, doc):
+    p = tmp_path / "pol.json"
+    p.write_text(json.dumps(doc), encoding="utf-8")
+    return live_policy.policy(p)
+
+
+def test_a_quarantined_name_is_refused_and_its_symbol_stays_open(tmp_path):
+    pol = _pol(tmp_path, {"live_symbols": ["USDJPY"], "quarantined_sleeves": {
+        "USDJPY.asia#rr=2.5": "reddit lineage"}})
+    why = live_policy.refuse({"symbol": "USDJPY", "name": "USDJPY.asia#rr=2.5"}, pol)
+    assert why and "lineage-quarantined" in why and "reddit lineage" in why
+    assert live_policy.refuse({"symbol": "USDJPY", "name": "usdjpy_clean_recert"}, pol) is None
+
+
+def test_the_shipped_policy_holds_every_reddit_judged_name_and_keeps_the_allowlist():
+    pol = live_policy.policy()
+    for name in ("USDJPY.asia#rr=2.5", "usdjpy_session_range_breakout_asia_rr25_wb12",
+                 "usdjpy_session_range_breakout_asia_session_range_breakout",
+                 "usdjpy_session_range_breakout_asia_5_wb_12",
+                 "usdjpy_session_range_breakout_asia_0_wb_12"):
+        assert name in pol.quarantined_sleeves
+    assert pol.live_sleeves.get("USDJPY")          # the principal's one-sleeve choice, unchanged
+    assert live_policy.refuse({"symbol": "XAUUSD", "name": "gold_asia"}, pol) is None
+
+
+def test_the_quarantine_is_a_billed_rail():
+    import missed_growth
+
+    from libs.portfolio import rails
+    r = rails.rail("terms_lineage_quarantine")
+    assert r.kind == "mandate" and r.measure in missed_growth.MEASURES
+    out = missed_growth.MEASURES[r.measure](r, {"book": {"a": 0.05}}, {})
+    assert out["verdict"] in (missed_growth.COSTS, missed_growth.EARNS,
+                              missed_growth.NOT_BINDING, missed_growth.UNMEASURED)
+    assert out.get("source")
