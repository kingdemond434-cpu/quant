diff --git a/desks/mt5/tests/test_promoter_terms_quarantine.py b/desks/mt5/tests/test_promoter_terms_quarantine.py
new file mode 100644
index 000000000..2513b3150
--- /dev/null
+++ b/desks/mt5/tests/test_promoter_terms_quarantine.py
@@ -0,0 +1,55 @@
+"""The promoter's terms door (PR #162 audit v2): a fence that does not load fails closed on the
+quarantined certificates ONLY, never on the whole book; the rr=2.5 live aliases resolve."""
+from __future__ import annotations
+
+import sys
+import types
+from pathlib import Path
+
+import pytest
+
+_DESK = Path(__file__).resolve().parents[1]
+for _p in (str(_DESK), str(_DESK / "research"), str(_DESK.parent.parent)):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+promoter = pytest.importorskip("promoter")
+
+
+@pytest.fixture()
+def no_fence(monkeypatch):
+    broken = types.ModuleType("libs.data")
+    monkeypatch.setitem(sys.modules, "libs.data", broken)      # `from libs.data import terms_fence`
+    monkeypatch.delitem(sys.modules, "libs.data.terms_fence", raising=False)
+
+
+def test_an_unloadable_fence_holds_only_the_quarantined_keys(no_fence):
+    held = promoter.terms_quarantine("external.USDJPY.session_range_breakout.rr=2.5_wb=12")
+    assert held and held.startswith("DOOR_ERROR") and "quarantined keys only" in held
+    assert promoter.terms_quarantine("USDJPY.session_range_breakout.rr=1.5_wb=12")
+    assert promoter.terms_quarantine("", sleeve="usdjpy_session_range_breakout_asia_0_wb_12")
+    assert promoter.terms_quarantine("external.XAUUSD.session_range_breakout.rr=2.5_wb=12") is None
+    assert promoter.terms_quarantine("gold_asia", sleeve="gold_asia") is None
+
+
+def test_the_rr25_live_aliases_resolve_to_the_quarantined_certificate(no_fence):
+    for alias in ("USDJPY.asia#rr=2.5", "usdjpy_session_range_breakout_asia_rr25_wb12"):
+        assert promoter.terms_quarantine("", sleeve=alias)
+        assert promoter.terms_quarantine(alias)
+
+
+def test_a_loaded_fence_is_asked_with_the_aliased_key(monkeypatch):
+    seen = {}
+    fence = types.ModuleType("libs.data.terms_fence")
+
+    def quarantined_certificate(key="", *, sleeve="", gated_at=None, spec=None):
+        seen["key"] = key
+        return "BLOCKED_TERMS" if "rr=2.5" in key else None
+    fence.quarantined_certificate = quarantined_certificate
+    pkg = types.ModuleType("libs.data")
+    pkg.terms_fence = fence
+    monkeypatch.setitem(sys.modules, "libs.data", pkg)
+    monkeypatch.setitem(sys.modules, "libs.data.terms_fence", fence)
+    assert promoter.terms_quarantine("", sleeve="USDJPY.asia#rr=2.5") == "BLOCKED_TERMS"
+    assert seen["key"] == "external.USDJPY.session_range_breakout.rr=2.5_wb=12"
+    assert promoter.terms_quarantine("EURZAR.overnight_gap_decay") is None
