+TERMS_QUARANTINE_FALLBACK: dict[str, str | None] = {
+    "external.USDJPY.session_range_breakout":
+        "usdjpy_session_range_breakout_asia_session_range_breakout",
+    "external.USDJPY.session_range_breakout.rr=1.5_wb=12":
+        "usdjpy_session_range_breakout_asia_5_wb_12",
+    "external.USDJPY.session_range_breakout.rr=2.0_wb=12":
+        "usdjpy_session_range_breakout_asia_0_wb_12",
+    "external.USDJPY.session_range_breakout.rr=2.5_wb=12": None,
+}
+#: Live names that carry a quarantined certificate whose fence row has no sleeve (sleeve=None):
+#: the forward clock's key and the explicit alias the live policy admits for rr=2.5 / wb=12.
+TERMS_QUARANTINE_ALIASES: dict[str, str] = {
+    "USDJPY.asia#rr=2.5": "external.USDJPY.session_range_breakout.rr=2.5_wb=12",
+    "usdjpy_session_range_breakout_asia_rr25_wb12":
+        "external.USDJPY.session_range_breakout.rr=2.5_wb=12",
+}
+
+
+def _terms_fallback(key: str, sleeve: str) -> str | None:
+    k = TERMS_QUARANTINE_ALIASES.get(sleeve) or TERMS_QUARANTINE_ALIASES.get(key) or key
+    hit = next((ck for ck, sl in TERMS_QUARANTINE_FALLBACK.items()
+                if k in (ck, ck.split(".", 1)[1]) or (sleeve and sleeve == sl)), None)
+    return None if hit is None else (
+        f"DOOR_ERROR: terms fence did not load; {hit} is a known Reddit-lineage certificate and "
+        "is held (fail closed on the quarantined keys only)")
+
+
+def terms_quarantine(key: str, *, sleeve: str = "") -> str | None:
+    """The terms-fence refusal for a certificate judged under a fenced lineage (PR #162,
+    libs/data/terms_fence.py), or None once it is re-certified (gated after its requeue). Same
+    door as `tier_s_block`: withholds promotion and capital, never sizes. A fence that does not
+    load FAILS CLOSED ON THE QUARANTINED KEYS ONLY (`TERMS_QUARANTINE_FALLBACK`); every other
+    certificate passes this door. Billed by the `terms_lineage_quarantine` rail."""
+    alias = TERMS_QUARANTINE_ALIASES.get(sleeve) or TERMS_QUARANTINE_ALIASES.get(key)
+    try:
+        root = str(Path(__file__).resolve().parents[3])
+        if root not in sys.path:
+            sys.path.insert(0, root)
+        from libs.data import terms_fence
+    except Exception:
+        return _terms_fallback(key, sleeve)
+    try:
+        surv = json.loads((BASE / "reports" / "UNIVERSAL_SURVIVORS.json")
+                          .read_text("utf-8")).get("survivors") or {}
+    except (OSError, ValueError):
+        surv = {}
+    k = alias or key
+    cert = surv.get(k) or surv.get(f"external.{k}") or {}
+    try:
+        return terms_fence.quarantined_certificate(k, sleeve=sleeve,
+                                                   gated_at=cert.get("gated_at"))
+    except Exception:
+        return _terms_fallback(key, sleeve)
+
+
