+++ b/desks/mt5/tests/test_lineage_quarantine.py
@@ -0,0 +1,41 @@
+"""The terms quarantine is a LINEAGE quarantine held at the doors (PR #162 audit v3, 2026-10-07).
+
+The promoter (research/promoter.terms_quarantine) and the allocator (pf_allocator's terms fence)
+hold the Reddit-judged USDJPY certificates by lineage and lift on re-certification. The live
+policy carries NO name list: a name list cannot see the fence, so a clean re-certification
+written under the same allowlisted name would be refused and then retired by the promoter's
+_apply_live_policy. These tests pin that the policy leaves the allowlisted names admissible and
+that the forgone growth is a billed rail."""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+_DESK = Path(__file__).resolve().parents[1]
+for _p in (str(_DESK), str(_DESK / "research"), str(_DESK.parent.parent)):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+from mt5desk import live_policy  # noqa: E402
+
+
+def test_the_live_policy_never_refuses_the_allowlisted_usdjpy_names():
+    pol = live_policy.policy()
+    allowed = pol.live_sleeves.get("USDJPY")
+    assert allowed                                   # the principal's one-sleeve choice, unchanged
+    for name in allowed:
+        why = live_policy.refuse({"symbol": "USDJPY", "name": name, "timeframe": "H1"}, pol)
+        assert why is None, why
+    assert "quarantined_sleeves" not in live_policy.policy().as_dict()
+
+
+def test_the_quarantine_is_a_billed_rail():
+    import missed_growth
+
+    from libs.portfolio import rails
+    r = rails.rail("terms_lineage_quarantine")
+    assert r.kind == "mandate" and r.measure in missed_growth.MEASURES
+    out = missed_growth.MEASURES[r.measure](r, {"book": {"a": 0.05}}, {})
+    assert out["verdict"] in (missed_growth.COSTS, missed_growth.EARNS,
+                              missed_growth.NOT_BINDING, missed_growth.UNMEASURED)
+    assert out.get("source")
