+def measure_terms_quarantine(r: Any, alloc: dict[str, Any],
+                             _fv: dict[str, Any]) -> dict[str, Any]:
+    """What the terms lineage quarantine forgoes: each held certificate's certified 3x-cost
+    expectancy (R per trade) times one sleeve's heat in the current book. A mandate is never
+    walked; this prices it."""
+    try:
+        from libs.data import terms_fence
+        keys = tuple(terms_fence.QUARANTINED_CERTIFICATES)
+        src = "libs.data.terms_fence"
+    except Exception:
+        keys, src = TERMS_QUARANTINE_FALLBACK, "fallback list (terms_fence not importable)"
+    surv = (_json(BASE / "reports" / "UNIVERSAL_SURVIVORS.json").get("survivors")
+            or _json(BASE / "data" / "UNIVERSAL_SURVIVORS.canon.json").get("survivors") or {})
+    held = {k: ((surv.get(k) or {}).get("gates") or {}).get("stress_costs", {}).get("exp_x3")
+            for k in keys if k in surv}
+    priced = [float(v) for v in held.values() if isinstance(v, (int, float))]
+    if not priced:
+        return {"verdict": NOT_BINDING if not held else UNMEASURED, "n": len(held),
+                "source": src, "why": "no held certificate carries a 3x-cost expectancy here"}
+    q = float(np.mean(list((alloc.get("book") or {}).values()) or [0.0]))
+    m = float(np.mean(priced))
+    return {"verdict": COSTS if m > 0 else EARNS, "n": len(held), "source": src,
+            "mean_held_exp_x3_r": round(m, 5), "value_logw_per_trade": round(m * q, 6),
+            "held": sorted(held)}
+
