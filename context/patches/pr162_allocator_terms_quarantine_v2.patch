+def _terms_fallback(sv: dict[str, Any]) -> str | None:
+    """The fail-closed refusal for a survivor on the fallback list, else None."""
+    def _norm(p: Any) -> dict[str, float]:
+        out: dict[str, float] = {}
+        for k, v in (p.items() if isinstance(p, dict) else []):
+            if k == "timeframe":
+                continue
+            try:
+                out[str(k)] = float(v)
+            except (TypeError, ValueError):
+                continue
+        return out
+    key = (str(sv.get("symbol") or "").upper(), str(sv.get("family") or ""),
+           str(sv.get("window") or ""), _norm(sv.get("params")))
+    if any(key[:3] == q[:3] and key[3] == q[3] for q in TERMS_QUARANTINE_FALLBACK):
+        return ("DOOR_ERROR: terms fence did not load; a known Reddit-lineage certificate is held "
+                "(fail closed on the quarantined keys only)")
+    return None
+
