--- /dev/null
+++ b/desks/mt5/tests/test_allocator_terms_quarantine.py
@@ -0,0 +1,50 @@
+"""The allocator's terms door (PR #162 audit v2): a fence that does not load holds the
+quarantined certificates ONLY; every other certificate is still priced."""
+from __future__ import annotations
+
+import sys
+import types
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+_DESK = Path(__file__).resolve().parents[1]
+for _p in (str(_DESK), str(_DESK / "research"), str(_DESK.parent.parent)):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+pfa = pytest.importorskip("pf_allocator")
+
+
+def test_an_unloadable_fence_prices_everything_but_the_quarantined(monkeypatch):
+    survivors = [
+        {"symbol": "USDJPY", "family": "session_range_breakout", "window": "asia",
+         "params": {"rr": 2.5, "wait_bars": 12}},
+        {"symbol": "EURZAR", "family": "overnight_gap_decay", "window": "asia", "params": {}},
+        {"symbol": "XAUUSD", "family": "session_range_breakout", "window": "asia",
+         "params": {"rr": 2.5, "wait_bars": 12}}]
+    gap = types.ModuleType("research.portfolio_gap")
+    gap.load_survivors = lambda: survivors
+    eg = types.ModuleType("external_gauntlet")
+    eg.build_cell = lambda sym, fam, params, meta: {"df": None, "sigs": [1], "costs": None}
+    eg.daily_series = lambda df, sigs, costs: pd.Series(
+        [0.1, -0.05, 0.2], index=pd.to_datetime(["2026-01-01", "2026-01-02", "2026-01-05"]))
+    monkeypatch.setitem(sys.modules, "research.portfolio_gap", gap)
+    monkeypatch.setitem(sys.modules, "external_gauntlet", eg)
+    monkeypatch.setitem(sys.modules, "libs.data", types.ModuleType("libs.data"))
+    monkeypatch.delitem(sys.modules, "libs.data.terms_fence", raising=False)
+    out, acct = pfa.certified_evidence()
+    assert set(out) == {"EURZAR_overnight_gap_decay_asia", "XAUUSD_session_range_breakout_asia"}
+    assert acct["terms_fence"].startswith("fallback list")
+    assert list(acct["terms_quarantined"]) == [
+        "USDJPY_session_range_breakout_asia:{'rr': 2.5, 'wait_bars': 12}"]
+    assert acct["priced"] == 2
+
+
+def test_the_fallback_matches_on_params_not_just_the_cell():
+    held = {"symbol": "USDJPY", "family": "session_range_breakout", "window": "asia",
+            "params": {"rr": "2.5", "wait_bars": 12, "timeframe": "H1"}}
+    other = {**held, "params": {"rr": 3.0, "wait_bars": 12}}
+    assert pfa._terms_fallback(held)
+    assert pfa._terms_fallback(other) is None
