# EVIDENCE: scripts/run_fusion_search.py + libs/research/fusion_search.py (built 2026-07-30)
# CONFIDENCE: committed-script (new this cycle)
8 5 * * * cd "$QUANT_ROOT" && flock -n data/.cron_fusion_search.lock .venv/bin/python scripts/run_fusion_search.py >> data/cro_ai_logs/fusion_search.log 2>&1

# STRATEGIC DIRECTOR (RANK 3): a runtime ROLE, not a doctrine document -- dossier -> prompt ->
