# EVIDENCE: scripts/check_miner_runway.py (built 2026-07-29); docs/GAP_REGISTER.md:226 (#29)
# CONFIDENCE: committed-script (new this cycle)
41 6 * * * cd "$QUANT_ROOT" && .venv/bin/python scripts/check_miner_runway.py --json >> data/cro_ai_logs/miner_runway.log 2>&1

# ALERT CANARY: hourly tick, self-throttled to one synthetic page every 6h, and it AUDITS the
