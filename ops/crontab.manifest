# CONFIDENCE: committed-script (new this cycle -- cadence chosen here, not observed on the box)
27 4 * * * cd "$QUANT_ROOT" && flock -n data/.cron_data_registry.lock .venv/bin/python scripts/build_data_registry.py --deep >> data/cro_ai_logs/data_registry.log 2>&1
52 4 * * * cd "$QUANT_ROOT" && flock -n data/.cron_labels.lock .venv/bin/python scripts/build_labels.py >> data/cro_ai_logs/label_factory.log 2>&1

# FUSION SEARCH (RANK 5): combinatorial dataset search, GATED so it cannot mine noise. Cheap by
