# equity had TWO sources of truth; every capacity band is a ratio to that number.
# EVIDENCE: scripts/check_utilisation.py -> data/utilisation.json; docs/CONSTITUTION.md L1.28a
# CONFIDENCE: committed-script (new this cycle)
27 */6 * * * cd "$QUANT_ROOT" && .venv/bin/python scripts/check_utilisation.py >> data/cro_ai_logs/utilisation.log 2>&1

