# EVIDENCE: scripts/run_alert_canary.py (built 2026-07-29, gap #38); docs/GAP_REGISTER.md:246
# CONFIDENCE: committed-script (new this cycle -- cadence chosen here, not observed on the box)
17 * * * * cd "$QUANT_ROOT" && .venv/bin/python scripts/run_alert_canary.py >> data/cro_ai_logs/alert_canary.log 2>&1

# EXECUTION INTELLIGENCE: cross-feed read over hedge integrity, trade forensics, cost model and
