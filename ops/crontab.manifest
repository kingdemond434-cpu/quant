# CONFIDENCE: committed-script (new this cycle)
23 */2 * * * cd "$QUANT_ROOT" && .venv/bin/python scripts/run_reality_gap.py >> data/cro_ai_logs/reality_gap.log 2>&1

# DATA ASSET REGISTRY + LABEL FACTORY (EXECUTION_QUEUE.md RANK 4 + RANK 6). Both also run inside
# run_intelligence_cycle (every 6h) because the organs there navigate by the registry; these daily
# slots exist so the artifacts are fresh even if a cycle is quota-killed, and because --deep is too
# expensive for a 6-hourly tick. GAP_REGISTER #77 is what happens when the map is stale: row counts
