# EVIDENCE: scripts/run_execution_intel.py (built 2026-07-29, triage #102)
# CONFIDENCE: committed-script (new this cycle)
*/20 * * * * cd "$QUANT_ROOT" && .venv/bin/python scripts/run_execution_intel.py >> data/cro_ai_logs/execution_intel.log 2>&1

