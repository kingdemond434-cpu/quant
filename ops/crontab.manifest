# daily research cycle at 02:00 UTC -- deliberately DUAL-scheduled with quant-cro.timer 08:01
# ("absorbed by idempotency but drift-prone" -- 20260729_infrastructure.md:317-319). One cron
# entry covers, via scripts/daily_research_cycle.py's step table, everything the register's
# row 58 lists as cycle-owned: ensure_recorder (:35), run_cadence (:42), run_nav_attest (:49),
# run_cost_model (:95), run_shadow_8h (:96), git_snapshot (:99), plus the forward shadows via
# run_daily_research.py (scripts/run_daily_research.py:35-54).
# EVIDENCE: docs/research/deep_sweep/20260729_alpha-discovery.md:465 ("daily cycle cron 02:00
#   confirmed via crontab -l"); .../20260729_data-intelligence.md:95 ("cron-started 02:00")
# CONFIDENCE: documented-cadence
0 2 * * * cd "$QUANT_ROOT" && flock -n data/.cron_daily_cycle.lock .venv/bin/python scripts/daily_research_cycle.py >> data/cro_ai_logs/daily_cycle_cron.log 2>&1

# organ catch-up: re-fires quota-killed claude organs, one per tick, flock-guarded.
# The docstring still says */30 (scripts/organ_catchup.py:1) but the live box probes every
# 5 min (dated log observation: 20260729_infrastructure.md:47-48; also
# docs/research/deep_sweep/20260726_data-intelligence.md:100 "organ_catchup cron (every 5 min)").
# The observed cadence wins; the stale docstring is noted, not copied.
# CONFIDENCE: documented-cadence
*/5 * * * * cd "$QUANT_ROOT" && flock -n data/.cron_organ_catchup.lock .venv/bin/python scripts/organ_catchup.py >> data/cro_ai_logs/organ_catchup.log 2>&1

# quota verdict: its own 3h cron so it can page the MOMENT the Pro-vs-Max signal is clear.
# EVIDENCE: scripts/quota_verdict.py:12 ("Runs on its own 3h cron");
#   20260729_infrastructure.md:246 ("still cron'd 8x/day" = every 3h). Minute slot inferred.
# CONFIDENCE: documented-cadence
0 */3 * * * cd "$QUANT_ROOT" && .venv/bin/python scripts/quota_verdict.py >> data/cro_ai_logs/quota_verdict_cron.log 2>&1

# max_audit: mechanical below-potential sweep, "run by cron and at every brain-cycle start"
# (scripts/max_audit.py:8). Cron cadence itself is not dated anywhere in-repo -> daily slot
# chosen here (07:00, clear of the 02:00 cycle and the 06:20/06:40 collectors).
# CONFIDENCE: inferred
0 7 * * * cd "$QUANT_ROOT" && .venv/bin/python scripts/max_audit.py >> data/cro_ai_logs/max_audit_cron.log 2>&1

# quota-free crypto hypothesis factory: pure python, 0 claude calls, so generation "always
# runs". Its live log name is crypto_factory_cron.log (ops/run_crypto_factory.sh:17) proving
# cron ownership; max_audit fences its product at <=30h (scripts/max_audit.py:1081), so at
# least daily. Slot chosen here.
# CONFIDENCE: inferred
30 1 * * * cd "$QUANT_ROOT" && flock -n data/.cron_crypto_factory.lock /bin/bash ops/run_crypto_factory.sh

# deep cold-audit organ: header says weekly (ops/run_deep_sweep.sh:2) yet dated artifacts
# landed 07-26/07-28/07-29 (docs/research/deep_sweep/) and organ_catchup re-fires it as an
# owed organ -- so the live cadence is at least daily-rotating perspectives. Daily slot chosen.
# CONFIDENCE: inferred
0 1 * * * cd "$QUANT_ROOT" && flock -n data/.cron_deep_sweep.lock /bin/bash ops/run_deep_sweep.sh

# headless AI brain cycles beyond the 08:45 timer: the full schedule is 4 cycles/day
# (scripts/quota_verdict.py:100 "4 cycles/day + 7 miners/day"), organs page on brain-auth
# failure "per crontab header" (20260729_infrastructure.md:156-157) -- so cron fires
# run_cro_ai.sh in slots the timer does not cover. 3 cron slots + the 08:45 timer = 4/day;
# exact live minutes unverified.
# CONFIDENCE: inferred
45 2,14,20 * * * cd "$QUANT_ROOT" && flock -n data/.cron_cro_ai.lock /bin/bash ops/run_cro_ai.sh

# --------------------------------------------------------------------------------------------
# SYSTEMD PLANE -- committed units first (schedules exact, read from the unit files),
# then units that live ONLY on the box (documented here; operator owes the unit files too).
# deploy/reconstitute_cron.sh enables the committed five when systemctl exists.
# --------------------------------------------------------------------------------------------

# EVIDENCE: ops/quant-blindrediscovery.timer:4 (OnCalendar=*-*-01 20:00:00, monthly);
#   ops/quant-blindrediscovery.service:12 (ExecStart). NOTE: the service Description still
#   says "quarterly" -- the timer is the truth (monthly, principal-dated in the timer header).
# CONFIDENCE: committed-unit
SYSTEMD unit="quant-blindrediscovery.timer" on="*-*-01 20:00:00" exec="ops/run_blindrediscovery_dig.sh"

# EVIDENCE: ops/quant-dataaxis.timer:4 (daily 14:00, "clear of the 08:45 brain slot");
