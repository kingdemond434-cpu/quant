SYSTEMD unit="quant-frontier.timer" on="*-*-* 15:00:00" exec="ops/run_frontier_rotation.sh"

# EVIDENCE: ops/quant-litminer.timer:5 (daily 19:00, max frequency, principal 2026-07-23);
