[Unit]
Description=Daily canon recertification under current costs

[Timer]
# 06:20 UTC -- after the overnight gauntlet sweeps and before the London session, so a
# certificate that no longer survives its own cost model is withdrawn before it can be sized.
OnCalendar=*-*-* 06:20:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
