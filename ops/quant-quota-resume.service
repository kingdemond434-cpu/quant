[Unit]
Description=Resume owed digs the moment LLM quota returns (not at the next fixed slot)

[Service]
Type=oneshot
# 2026-09-01 (corrected): sized from the TRUE 24h maximum (150M), not the most recent
# reading. An earlier pass sized off the last peak and left the throttle BELOW the real
# working set on nine units -- permanent reclaim, which is a slow kill, not a margin.
MemoryHigh=187M
MemoryMax=255M
WorkingDirectory=/home/quant/quant-platform
ExecStart=/home/quant/quant-platform/.venv/bin/python scripts/check_quota_resume.py
