[Unit]
# THE DEDICATED 24/7 MOAT MINER. Separate from the cadence on purpose: the cadence call is the
# FLOOR (it guarantees the miner runs at all), this is the CEILING (coverage converges in hours
# instead of in as many days as there are cycles). P26: under-exploration of owned data is a
# breach, and "we mine it once a day" is under-exploration when nothing but wall-clock stops it
# going faster.
Description=Quant dedicated moat miner (continuous, read-only over data/moat)
After=network-online.target
StartLimitIntervalSec=0

[Service]
User=quant
WorkingDirectory=/home/quant/quant-platform
Environment=PATH=/home/quant/.local/bin:/home/quant/quant-platform/.venv/bin:/usr/bin:/bin
# Per PASS, not per day: a small budget with continuous passes explores far more than a large
# budget once, and never blocks the box for minutes at a time.
Environment=MOAT_FILE_BUDGET=40
Environment=MOAT_MINER_INTERVAL=15
Type=simple
ExecStart=/bin/bash /home/quant/quant-platform/ops/run_moat_miner.sh
Restart=always
RestartSec=30
# Lowest priority on the box: mining must never compete with a recorder for I/O. Losing tape is
# permanent; a slower mining pass costs minutes.
Nice=15
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/quant/quant-platform/data
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
