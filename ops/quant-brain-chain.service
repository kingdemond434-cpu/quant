[Unit]
Description=Daily brain chain: CRO -> unified frontier -> video hunter, one cache window (token-economy order 2026-08-25)

[Service]
# Shares one memory budget with the other heavy organs (see ops/quant-heavy.slice): the
# per-unit caps stop a unit killing itself, the slice stops them collectively exhausting
# the box and getting an innocent neighbour killed by the global OOM killer.
Slice=quant-heavy.slice
# 2026-09-01: MemoryMax alone HARD-KILLS at the ceiling -- that was the normal failure
# mode here, not a runaway backstop. MemoryHigh throttles (reclaim + slow) below it, so
# a heavy run finishes slowly instead of dying and being retried forever. Ceiling is
# UNCHANGED at 2500M, so nothing that fits today is newly constrained.
MemoryHigh=2000M
MemoryMax=2500M
MemorySwapMax=0
CPUWeight=50
Type=oneshot
WorkingDirectory=/home/quant/quant-platform
ExecStart=/bin/bash /home/quant/quant-platform/ops/run_daily_brain_chain.sh
TimeoutStartSec=8h
