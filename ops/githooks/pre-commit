#!/bin/bash
# Money-path pre-commit guard (GAP 134): refuses ssh-context .py tramples and marker-stripping
# staged changes. See scripts/moneypath_precommit_guard.py. The content fence's own repair
# commits use --no-verify and skip this by design.
PY=.venv/bin/python
[ -x "$PY" ] || PY=python3
exec "$PY" scripts/moneypath_precommit_guard.py
