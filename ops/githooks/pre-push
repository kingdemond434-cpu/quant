#!/usr/bin/env bash
# PRE-PUSH GATE. Tracked in ops/githooks so all three builder seats get the same one; activate
# per clone with:  git config core.hooksPath ops/githooks
#
# Runs the three FAST gates (~1 min) plus the constitutional law fences (~30s, L1.37). The full
# suite is deliberately not run here: a 60-80 minute pre-push hook gets bypassed within a day, and
# a gate that is routinely bypassed is worse than none because everyone believes it ran. Run
# `ops/gates.sh --full` before any commit touching libs/, where the coverage ratchet applies.
#
# Historically deploy/git_hooks/pre-push carried the law-gate call and this file did not, and
# core.hooksPath pointed here -- so the law fences ran on deploy but never on an actual push from
# this checkout. Merged so one active hook enforces both.
#
# ESCAPE HATCH, ON PURPOSE AND NAMED: `git push --no-verify` skips this. That is correct for a
# genuine emergency and dishonest for routine work; the hook cannot tell the difference, and a
# hook with no escape hatch gets uninstalled instead of bypassed.
ROOT="$(git rev-parse --show-toplevel)"
# git hands the hook one line per ref on stdin; read it once, before anything else consumes it.
PUSH_REFS="$(cat)"

# THE INTERPRETER, ON BOTH KINDS OF HOST (2026-10-01). The trading box is Windows: its venv is
# .venv/Scripts/python.exe, never .venv/bin/python, and `python3` there may be absent or the
# Microsoft Store stub, which exits non-zero without running anything -- a law gate that "fails"
# and refuses the push with no fence having run. So: the venv in either layout first, then the
# first of python3 / python that actually starts. (Unmeasured on the box; the laptop checks.)
PY=""
for cand in "$ROOT/.venv/bin/python" "$ROOT/.venv/Scripts/python.exe"; do
    [ -x "$cand" ] && { PY="$cand"; break; }
done
if [ -z "$PY" ]; then
    for cand in python3 python; do
        if command -v "$cand" >/dev/null 2>&1 && "$cand" -c "import sys" >/dev/null 2>&1; then
            PY="$cand"; break
        fi
    done
fi
[ -n "$PY" ] || PY=python3

# A STATE-ONLY PUSH IS NOT JUDGED AS CODE (2026-10-06, post-merge audit of #181). The trading box
# publishes its own ledgers and reports (sync_shadow_to_git.ps1) as one commit of state blobs; the
# gates and law fences below judge CODE, and running them on that push only let an unrelated red
# fence anywhere in the box's tree refuse the box's evidence. scripts/push_scope.py exits 0 only
# when EVERY changed path is box state (libs.ops.release.is_state_path, minus docs/); one code
# path, an unmeasurable diff, or an interpreter that will not start, and the full gate runs.
if printf '%s\n' "$PUSH_REFS" | "$PY" "$ROOT/scripts/push_scope.py"; then
    exit 0
fi

"$ROOT/ops/gates.sh" || exit 1

if ! "$PY" "$ROOT/scripts/run_law_gate.py" --laws-only; then
    echo "" >&2
    echo "PUSH REFUSED: a constitutional law fence is failing (L1.37)." >&2
    echo "Fix the breach, or push with --no-verify and record why." >&2
    exit 1
fi
