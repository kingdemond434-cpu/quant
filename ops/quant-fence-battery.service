[Unit]
Description=Daily fence battery (bar_span, recoverability, disposition-landed, frozen-values, knob-sensitivity, ledger-reversion)

[Service]
# 2026-08-31: was unbounded, and an unbounded unit on a swapless 3.7GB box does not
# fail alone -- it drives the box to global OOM and the kernel kills a NEIGHBOUR that
# fit perfectly well. Measured 24h peak here: 580M.
# MemoryHigh THROTTLES (reclaim + slow down), it does not kill; MemoryMax is only the
# far backstop for a genuine runaway. So a heavy run gets slower, never SIGKILLed, and
# it can no longer take out the units around it.
MemoryHigh=800M
MemoryMax=1100M
Type=oneshot
WorkingDirectory=/home/quant/quant-platform
ExecStart=/usr/bin/bash /home/quant/quant-platform/ops/run_fence_battery.sh
StandardOutput=append:/home/quant/quant-platform/data/cro_ai_logs/fence_battery.log
StandardError=append:/home/quant/quant-platform/data/cro_ai_logs/fence_battery.log
TimeoutStartSec=2400
