{
  "name": "master-and-production-only-by-promotion",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/master",
        "refs/heads/production"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_type": "Integration",
      "actor_id": 0,
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "update",
      "parameters": {
        "update_allows_fetch_and_merge": false
      }
    }
  ]
}
