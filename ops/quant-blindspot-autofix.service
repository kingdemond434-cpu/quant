[Unit]
Description=Quant Blind Spot Auto-Fix (every 6 hours)
After=network-online.target
Wants=network-online.target

[Service]
# Shares one memory budget with the other heavy organs (see ops/quant-heavy.slice): the
# per-unit caps stop a unit killing itself, the slice stops them collectively exhausting
# the box and getting an innocent neighbour killed by the global OOM killer.
Slice=quant-heavy.slice
# 2026-09-01 (corrected): sized from the TRUE 24h maximum (778M), not the most recent
# reading. An earlier pass sized off the last peak and left the throttle BELOW the real
# working set on nine units -- permanent reclaim, which is a slow kill, not a margin.
MemoryHigh=972M
MemoryMax=1322M
Type=oneshot
User=quant
WorkingDirectory=/home/quant/quant-platform
Environment=PATH=/home/quant/quant-platform/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/quant/quant-platform/.venv/bin/python scripts/blindspot_autofix.py
StandardOutput=journal
StandardError=journal
TimeoutSec=1800
# No [Install]: timer-driven (see the .timer beside this file) and enabled THROUGH the timer;
# a WantedBy here let `systemctl enable` arm a boot-time one-shot that ran once while
# `is-enabled` said "enabled" -- the convention tests/scripts/test_enforcement.py pins.
