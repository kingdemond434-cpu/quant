[Unit]
Description=Quant Blind Spot Auto-Fix (every 6 hours)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quant
WorkingDirectory=/home/quant/quant-platform
Environment=PATH=/home/quant/quant-platform/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/quant/quant-platform/.venv/bin/python scripts/blindspot_autofix.py
StandardOutput=journal
StandardError=journal
TimeoutSec=1800

[Install]
WantedBy=multi-user.target