[Unit]
Description=Recertify the canon under the CURRENT cost model -- a certificate is not a fact forever

[Service]
Type=oneshot
WorkingDirectory=/home/quant/quant-platform/desks/mt5
TimeoutStartSec=90min

# WHY THIS EXISTS ON A TIMER AT ALL. recertification_audit.json was last written 2026-08-29 and
# still is, seven days later, because nothing ever ran this script twice. In that stale audit 15
# of 17 re-judged certificates were COST_REGRADE_FAIL: they had been certified under a cost model
# the desk has since corrected, and nothing re-examined them. Certificates grew 23 -> 66 over the
# same week, so the desk's confidence grew while its evidence aged.
#
# A certificate is a claim under a cost model. When the cost model changes the claim must be
# re-judged or withdrawn -- that is the whole point of a sealed lockbox, and a lockbox that is
# only ever opened once is just a filing cabinet.

# A CEILING ABOVE THE WORKING SET, NOT THROUGH IT (learned 2026-09-04: MemoryHigh below a job's
# working set makes it swap-thrash at 20% CPU rather than protecting anything).
#
# BUT 4G ON A 4GB BOX IS NOT A CEILING ABOVE THE WORKING SET -- IT IS THE WHOLE MACHINE, and a
# unit that may take every page cannot protect anything either. When it does, the global OOM
# killer picks the largest process it can see, which on this host is routinely the dashboard
# server or cloudflared rather than the organ that overran. quant-heavy.slice was built on
# 2026-09-01 to bound exactly this and this unit was never put in it; the 06:20 firing can also
# still overlap the 06:00 nightly catch-up, which carried the same 4G.
#
# NO PER-UNIT CEILING, DELIBERATELY: the slice governs, and `ops/size_memory_budget.sh` derives
# its budget from the host's own MemTotal. That keeps the ceiling ABOVE the working set on any
# host -- the lesson above -- without a constant that is correct for one machine and silently
# wrong after the next resize or move.
Slice=quant-heavy.slice

# Absolute path, as quant-regime-monitor.service and quant-sge-premium.service already do: the
# scheduler-manifest fence maps ExecStart onto the repo by stripping the VPS root, so a
# cwd-relative path resolves to a file that "does not exist in repo" and the unit goes invisible
# to the DR floor while running perfectly well on the box. WorkingDirectory still governs the
# process's cwd; only the fence's view of WHICH script this is depends on the path being absolute.
ExecStart=/home/quant/quant-platform/.venv/bin/python -u -W ignore /home/quant/quant-platform/desks/mt5/scripts/recertify_canon.py
