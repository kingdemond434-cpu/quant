[Unit]
Description=Disk + memory guard: rotate rebuildable artifacts, never touch irreplaceable ones

[Service]
Type=oneshot
# 2026-09-01: MemoryMax alone HARD-KILLS at the ceiling -- that was the normal failure
# mode here, not a runaway backstop. MemoryHigh throttles (reclaim + slow) below it, so
# a heavy run finishes slowly instead of dying and being retried forever. Ceiling is
# UNCHANGED at 300M, so nothing that fits today is newly constrained.
MemoryHigh=240M
MemoryMax=300M
WorkingDirectory=/home/quant/quant-platform
ExecStart=/home/quant/quant-platform/.venv/bin/python scripts/disk_guard.py
SuccessExitStatus=0 1
