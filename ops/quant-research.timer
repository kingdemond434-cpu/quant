[Unit]
Description=Midnight renewable research frontier (sweep -> cycle -> handoff)

[Timer]
# Start at local midnight so the full dependency-ordered cycle works through the overnight window.
# The service uses one lock, nice/BLAS limits and recorder-first ordering; duplicate launchers exit.
OnCalendar=*-*-* 00:00:00 Europe/London
Persistent=true

[Install]
WantedBy=timers.target
