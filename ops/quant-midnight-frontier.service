[Unit]
Description=Midnight Codex frontier -- continue, sweep, reason, verify and hand off
After=network-online.target

[Service]
# 2026-08-31: was unbounded, and an unbounded unit on a swapless 3.7GB box does not
# fail alone -- it drives the box to global OOM and the kernel kills a NEIGHBOUR that
# fit perfectly well. Measured 24h peak here: 301M.
# MemoryHigh THROTTLES (reclaim + slow down), it does not kill; MemoryMax is only the
# far backstop for a genuine runaway. So a heavy run gets slower, never SIGKILLed, and
# it can no longer take out the units around it.
MemoryHigh=460M
MemoryMax=640M
Type=oneshot
TimeoutStartSec=18h
KillMode=control-group
Environment="PATH=/home/quant/quant-platform/.venv/bin:/home/quant/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="CODEX_NIGHTLY_MODEL=gpt-5.6-terra"
Environment="CODEX_NIGHTLY_REASONING_EFFORT=medium"
WorkingDirectory=/home/quant/quant-platform
ExecStart=/bin/bash /home/quant/quant-platform/ops/run_midnight_frontier.sh
