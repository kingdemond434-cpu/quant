[Unit]
Description=Quant Autodiscovery H8 (10 symbols, 3x annualization)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quant
WorkingDirectory=/home/quant/quant-platform
Environment=PATH=/home/quant/quant-platform/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/quant/quant-platform/.venv/bin/python scripts/run_crypto_research.py --db data/sor_crypto.sqlite --timeframe H8 --max-symbols 10 --offset 0
StandardOutput=journal
StandardError=journal
TimeoutSec=1800

[Install]
WantedBy=multi-user.target
