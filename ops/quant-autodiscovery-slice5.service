# RETIRED 2026-08-19 (principal standing order: "crypto specific venue focus should be
# fully dead and 100% mt5 everywhere"). This unit runs scripts/run_crypto_research.py, a
# crypto-sleeve discovery slice -- abandoned along with cash-and-carry and every other
# crypto-venue-specific sleeve. NOT reinstalled on a fresh VPS provision from this point.
# OWED VPS-SIDE ACTION (cannot be done from this sandbox -- no SSH/VPS access):
#   systemctl disable --now quant-autodiscovery-slice{0..9}.service quant-autodiscovery-slice{0..9}.timer
# The MT5-native replacement is scheduled in ops/crontab.manifest (full_hunt.py,
# run_cot_screen.py, run_research_lake.py, run_crossasset_robust.py, run_crossasset_shadow.py).
[Unit]
Description=Quant Autodiscovery Slice 5 (symbols 150-179)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quant
WorkingDirectory=/home/quant/quant-platform
Environment=PATH=/home/quant/quant-platform/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/quant/quant-platform/.venv/bin/python scripts/run_crypto_research.py --db data/sor_crypto.sqlite --timeframe D1 --max-symbols 30 --offset 150
StandardOutput=journal
StandardError=journal
TimeoutSec=1800
MemoryMax=500M
MemoryHigh=450M

[Install]
WantedBy=multi-user.target
