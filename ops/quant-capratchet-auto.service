[Unit]
Description=Quant Capability Ratchet Auto-Run (every 12 hours)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quant
WorkingDirectory=/home/quant/quant-platform
Environment=PATH=/home/quant/quant-platform/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/quant/quant-platform/.venv/bin/python scripts/run_capability_ratchet.py
StandardOutput=journal
StandardError=journal
TimeoutSec=1800
SuccessExitStatus=0 2
# No [Install]: timer-driven (see the .timer beside this file) and enabled THROUGH the timer;
# a WantedBy here let `systemctl enable` arm a boot-time one-shot that ran once while
# `is-enabled` said "enabled" -- the convention tests/scripts/test_enforcement.py pins.
