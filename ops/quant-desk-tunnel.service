[Unit]
Description=Public HTTPS tunnel for the desk dashboard (quick tunnel, no root required)
After=network-online.target quant-desk-web.service
Wants=quant-desk-web.service

[Service]
Type=simple
WorkingDirectory=/home/quant/quant-platform
ExecStart=/bin/bash /home/quant/quant-platform/ops/run_desk_tunnel.sh
Restart=always
RestartSec=10
# 2026-09-01: MemoryMax alone HARD-KILLS at the ceiling -- that was the normal failure
# mode here, not a runaway backstop. MemoryHigh throttles (reclaim + slow) below it, so
# a heavy run finishes slowly instead of dying and being retried forever. Ceiling is
# UNCHANGED at 250M, so nothing that fits today is newly constrained.
MemoryHigh=200M
MemoryMax=250M

[Install]
WantedBy=default.target
