[Unit]
Description=MT5 desk suite ratchet (GAP 143): the money path's tests, which nothing else runs

[Service]
# 2026-08-31: was unbounded, and an unbounded unit on a swapless 3.7GB box does not
# fail alone -- it drives the box to global OOM and the kernel kills a NEIGHBOUR that
# fit perfectly well. Measured 24h peak here: 356M.
# MemoryHigh THROTTLES (reclaim + slow down), it does not kill; MemoryMax is only the
# far backstop for a genuine runaway. So a heavy run gets slower, never SIGKILLed, and
# it can no longer take out the units around it.
MemoryHigh=520M
MemoryMax=720M
Type=oneshot
WorkingDirectory=/home/quant/quant-platform
ExecStart=/home/quant/quant-platform/.venv/bin/python scripts/check_mt5_suite.py
