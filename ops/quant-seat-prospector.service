[Unit]
Description=Early-window seat: prospector (manifest slot re-homed; root timer fires into the exhausted quota window)

[Service]
# Shares one memory budget with the other heavy organs (see ops/quant-heavy.slice): the
# per-unit caps stop a unit killing itself, the slice stops them collectively exhausting
# the box and getting an innocent neighbour killed by the global OOM killer.
Slice=quant-heavy.slice
Type=oneshot
WorkingDirectory=/home/quant/quant-platform
TimeoutStartSec=3h
SuccessExitStatus=0
ExecStart=/bin/bash -c 'flock -n /tmp/seat_prospector.lock /bin/bash ops/run_prospector_dig.sh >> data/cro_ai_logs/seat_prospector.log 2>&1'
