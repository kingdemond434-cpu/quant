[Unit]
Description=Quota-resume watcher, every 5 minutes
# Cheap by design: it reads log tails and a JSON file. It never probes the vendor to discover
# availability -- the exhaustion message already states the reset time, and hammering a
# rate-limited endpoint to find out costs the very window it is trying to save.

[Timer]
OnBootSec=180
OnUnitActiveSec=300
AccuracySec=30s

[Install]
WantedBy=timers.target
