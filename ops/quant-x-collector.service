[Unit]
Description=Quant X/Twitter Signal Collector (hourly)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quant
WorkingDirectory=/home/quant/quant-platform
Environment=PATH=/home/quant/quant-platform/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/quant/quant-platform/.venv/bin/python scripts/collect_x_signals.py
StandardOutput=journal
StandardError=journal
TimeoutSec=600

[Install]
WantedBy=multi-user.target