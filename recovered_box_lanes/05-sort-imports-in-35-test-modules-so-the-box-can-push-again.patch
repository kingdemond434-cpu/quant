+def log_score(p: Sequence[float], y: Sequence[float]) -> float:
+    n = len(y)
+    if n == 0:
+        return 0.0
+    tot = 0.0
+    for i in range(n):
+        q = min(1 - EPS, max(EPS, p[i]))
+        tot += y[i] * math.log(q) + (1 - y[i]) * math.log(1 - q)
+    return tot / n
