+    scheme = ""
+    if "://" in raw:
+        scheme, raw = raw.split("://", 1)
+    raw = raw.split("#", 1)[0]
+    query = ""
+    if "?" in raw:
+        raw, query = raw.split("?", 1)
+    hostport, _, path = raw.partition("/")
+    host, _, port = hostport.partition(":")
+    return scheme.lower(), host.lower(), port, ("/" + path if path else "/"), query
