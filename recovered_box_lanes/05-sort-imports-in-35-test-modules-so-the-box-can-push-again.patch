+def _eligible() -> list[Path]:
+    out: list[Path] = []
+    for g in INCLUDE_GLOBS:
+        for p in ROOT.glob(g):
+            if not p.is_file():
+                continue
+            rel = p.relative_to(ROOT).as_posix()
+            if any(x in rel for x in EXCLUDE_PARTS):
+                continue
+            if p.suffix in EXCLUDE_SUFFIX or ".bak-" in rel:
+                continue
+            out.append(p)
+    return sorted(set(out))
 
 
