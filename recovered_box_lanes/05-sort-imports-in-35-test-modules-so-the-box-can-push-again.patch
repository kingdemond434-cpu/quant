+def panel_nodes(expr: Expr) -> list[Expr]:
+    """Every PANEL subtree, innermost first, each once."""
+    out: list[Expr] = []
+    seen: set[str] = set()
+
+    def _walk(x: Expr) -> None:
+        if not isinstance(x, (list, tuple)):
+            return
+        for c in x[1:]:
+            _walk(c)
+        if str(x[0]) in ag.PANEL and ag.key(x) not in seen:
+            seen.add(ag.key(x))
+            out.append(x)
+    _walk(expr)
+    return out
 
