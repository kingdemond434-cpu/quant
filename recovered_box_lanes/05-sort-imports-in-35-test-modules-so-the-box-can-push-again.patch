+        "access_class": access,
+        "replication": rep,
+        "cost": cost,
+        "regions": regions[:8],
+        "region_priority": round(region_p, 6),
+        "desk_record": f"{survived} survivor(s) from {worked} attempt(s) in these regions",
+        "unmeasured": unmeasured,
+        "why": (
