+                        ) -> Edge:
+        """What the lab writes after measuring an edge on the desk's own series."""
+        edge = self.edges[eid]
+        if evidence not in EVIDENCE_STATES:
+            raise ValueError(f"evidence {evidence!r} not one of {EVIDENCE_STATES}")
