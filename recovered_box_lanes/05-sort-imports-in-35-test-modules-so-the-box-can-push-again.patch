+                    kurt: float = 3.0) -> float:
+    """PSR against the expected-max-Sharpe benchmark over n_configs (Bailey & Lopez de Prado)."""
+    from scipy.stats import norm
+    if n_obs < 2 or n_configs < 1:
+        return 0.0
+    e = np.euler_gamma
+    var_sr = 1.0 / n_obs
