-            rows.append(row)
-            continue
-        task, artifact = declared
-        row["task"] = task
-        row["artifact"] = artifact
-        status, why = task_state(task)
-        row["status"] = status
-        row["why"] = why
-        path = DESK / artifact
-        if path.exists():
