-def token_cosine(a: Iterable[str], b: Iterable[str]) -> float:
-    """Set cosine: |A and B| / sqrt(|A| |B|). 1.0 is the same bag of words in any order."""
-    sa, sb = frozenset(a), frozenset(b)
-    if not sa or not sb:
-        return 0.0
-    return len(sa & sb) / math.sqrt(len(sa) * len(sb))
-
