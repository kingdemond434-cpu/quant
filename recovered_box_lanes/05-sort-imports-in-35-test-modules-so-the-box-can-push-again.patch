+    if isinstance(n, Binary | Compare):
+        return replace(n, left=kids[0], right=kids[1])
+    if isinstance(n, Cond):
+        return replace(n, when=kids[0], then=kids[1], otherwise=kids[2])
+    if isinstance(n, State):
+        it = iter(kids)
