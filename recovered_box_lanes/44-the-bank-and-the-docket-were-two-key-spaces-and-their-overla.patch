+    still unjudged. `docket_cell_id` is now the one row->cell rule, and it lives beside `cell_id`
+    so a reader cannot import one without meeting the other.
     """
     try:
         desk = str(BASE)
         if desk not in sys.path:
             sys.path.insert(0, desk)
-        from research.frontier_identity import cell_id
