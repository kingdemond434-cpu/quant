+    the attribution axis uses, and the reason this fence can never be passed by guessing.
+    """
+    canon = root / "desks" / "mt5" / "data" / "UNIVERSAL_SURVIVORS.canon.json"
+    if not canon.exists():
+        canon = root / "desks" / "mt5" / "reports" / "UNIVERSAL_SURVIVORS.json"
+    doc = _json(canon)
