+def seal_blocking_paths(root: Path | None = None, *,
+                        dirty: list[str] | None = None) -> list[str]:
+    """THE ONE ANSWER TO "what stops a seal": tracked paths that differ from HEAD and are
+    neither desk state nor regenerated build output.
+
+    WHY THIS EXISTS, MEASURED ON THE TRADING BOX 2026-09-24. Three copies of this one
+    classification were live at once -- `STATE_PREFIXES`/`STATE_FILES` here, a private
+    `$statePrefixes`/`$buildArtifacts` pair inside `Adopt-And-Seal.ps1`, and a third list in
+    `mt5desk/release_identity.py` -- and a seal needed ALL THREE to agree. They did not:
+
+        dist/quant-platform.zip        known to the script, unknown here      -> seal() raised
+        desks/mt5/swap_exposure.json   known here (STATE_FILES), not to it    -> exit 3, 15:19Z
+        desks/mt5/docs/*.md            known to NONE of them                  -> exit 3, 15:19Z
+        frontier_intel/, side_channels/  known here, not to release_identity  -> verdict REFUSED
+
+    Every one of those paths is rewritten by an organ on a clock, so every disagreement is
+    PERMANENT. The box sealed at 05:53Z and refused every seal for the rest of that day; the
+    gateway's release interlock therefore refused every placement from 10:00Z onward, and
+    `gold_london_am` and `gold_afternoon` placed nothing. Since 2026-09-07 that pattern cost 19
+    sleeve-days of gold placement against 22 that landed, and 1,200 refusal rows nobody read.
+
+    THIS DOES NOT WIDEN WHAT THE SEAL PROTECTS. Every path it sets aside is one an organ
+    regenerates; the identity verdict still holds the money path, the signed judge manifest and
+    the survivor canon to their own per-file digests, and a real code edit still blocks the seal
+    exactly as before. `dirty` lets a caller that already paid for `git status` reuse it, so the
+    rule cannot drift between the two readings taken in one pass.
+    """
+    paths = dirty_paths(root) if dirty is None else dirty
+    return [p for p in paths if not is_state_path(p) and not is_build_artifact(p)]
