+# ---------------------------------------------------------- the third copy of "what is code"
+def test_the_box_side_classifier_carries_the_same_state_rules() -> None:
+    """`release_identity._is_state_path` is the classifier the GATEWAY asks, and it was the one
+    copy of this rule nothing pinned: `STATE_FILES` existed in `libs.ops.release` and in
+    `Adopt-Release.ps1`, with a test tying those two together, while the module `decision_core`
+    reads had no such list at all. So an adoption would correctly keep the box's own
+    `swap_exposure.json` as state and the gateway would then read that same path as unreleased
+    CODE and refuse new risk on it."""
+    import importlib.util
+    import sys
+    root = Path(release.__file__).resolve().parents[2]
+    spec = importlib.util.spec_from_file_location(
+        "release_identity_state_mirror", root / "desks/mt5/mt5desk/release_identity.py")
+    assert spec is not None and spec.loader is not None
+    ri = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = ri
+    spec.loader.exec_module(ri)
+
+    assert ri.STATE_FILES == release.STATE_FILES
+    assert set(release.STATE_PREFIXES) <= set(ri.STATE_PREFIXES)
+    assert ri.ABSENT == release.ABSENT
+    for rel in (*release.STATE_FILES, "desks/mt5/data/x.json", "desks/mt5/frontier_intel/data/q"):
+        assert ri._is_state_path(rel) is release.is_state_path(rel) is True, rel
+    for rel in (GATEWAY, SIZING, "desks/mt5/research/free_shadows.py"):
+        assert ri._is_state_path(rel) is release.is_state_path(rel) is False, rel
