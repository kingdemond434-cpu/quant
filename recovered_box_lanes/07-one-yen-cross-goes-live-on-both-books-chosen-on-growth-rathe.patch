+    assert "discovered" in pol.banned_families
+    assert lp.refuse({"symbol": "USDJPY", "name": CHOSEN_MT5}, pol) is None
+    assert lp.refuse({"symbol": "EURJPY", "name": "eurjpy_session_range_breakout_asia_0_wb_12"},
