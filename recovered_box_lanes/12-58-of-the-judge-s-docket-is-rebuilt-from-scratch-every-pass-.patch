@@ -587,14 +588,55 @@ UNRUNNABLE_BANK = HYP / "unrunnable_specs.json"
 UNIVERSE = BASE / "data" / "universe"
 
 
-def _bar_bytes(sym: str) -> int:
-    """The symbol's H1 bar file size -- the cheap monotone proxy for "the history grew"."""
+def _bar_bytes(sym: str, timeframe: str = "H1") -> int:
+    """The bar file size on the cell's OWN chart -- the cheap monotone proxy for "history grew".
+
+    Defaults to H1 so a row banked before this took a timeframe is still re-opened against
+    exactly the file it was parked against; a cell judged on M5 is now measured on M5, because
+    re-admitting an M5 cell because the H1 frame grew would be a different symbol's answer.
+    """
+    tf = str(timeframe or "H1").upper()
     try:
-        return (UNIVERSE / f"{sym}_H1.parquet").stat().st_size
+        return (UNIVERSE / f"{sym}_{tf}.parquet").stat().st_size
     except OSError:
         return 0
 
 
+#: The signal-construction code a BUILD outcome depends on. A cell that could not be built failed
+#: inside `families.family_<name>` or the orthogonal registry, so the failure is a fact about that
+#: CODE as much as about the bars. Banking it on the bar size alone would park a cell for ever
+#: that the next fix to a family would have built -- a permanently-cached failure that should have
+#: become a pass, which is strictly worse than the waste it saves. The fingerprint is the second
+#: re-open condition and it is why this class may be banked at all.
+_FAMILY_CODE: tuple[str, ...] = ("mt5desk/families.py", "mt5desk/families_orthogonal.py",
+                                 "mt5desk/family_call.py")
+
+
+def _code_fingerprint() -> str:
+    """A digest of the family modules' size and mtime. An unreadable module is named, never
+    skipped: a fingerprint that silently ignores a missing file would stop re-opening the bank
+    the day that file moved."""
+    parts = []
+    for rel in _FAMILY_CODE:
+        try:
+            st = (BASE / rel).stat()
+            parts.append(f"{rel}:{st.st_size}:{st.st_mtime_ns}")
+        except OSError:
+            parts.append(f"{rel}:absent")
+    return hashlib.sha256("|".join(parts).encode("utf-8")).hexdigest()[:16]
+
+
+def _tf_from_cell(cell: str, row: dict[str, Any]) -> str:
+    """The chart the cell was judged on. The judge's own cell id spells it `SYM@TF.family.p=...`
+    and that is the authority; the verdict row is the fallback."""
+    head = cell.split(".", 1)[0]
+    if "@" in head:
+        tf = head.rsplit("@", 1)[1].strip().upper()
+        if tf:
+            return tf
+    return _tf_of(row)
+
+
 def name_unknowns(path: Path | None = None) -> dict[str, dict[str, Any]]:
     """EVERY UNKNOWN GETS A NAMED REASON. The class stops existing as a category.
 
@@ -632,6 +674,43 @@ def name_unknowns(path: Path | None = None) -> dict[str, dict[str, Any]]:
                                          "about the search, re-admitted when the history grows")
         out[cell] = {"reason": reason, "route": route, "sym": sym, "family": v.get("family"),
                      "days": days, "bar_bytes": bars, "why": why[:200]}
+    # THE BUILD FAILURES, which carry no `unmeasured` flag and were therefore invisible to the
+    # loop above (measured 2026-09-24: 81,588 of 140,090 docket cells, 58.2%, every pass). The
+    # judge submits them to its pre-warm pool, `build_cell` returns nothing because signal
+    # construction produced no executable cell, and the next pass submits all 81,588 again --
+    # work redone because its result was never made durable, the same defect shape as the HMM
+    # cache that flushed only on its last line. They are banked here with the same key, the same
+    # bar-growth re-open condition, and the family-code fingerprint that the bar size cannot
+    # supply. NOTHING IS DELETED and no verdict is lost: a build failure is `NOT_RUN`, never a
+    # pass or a fail, so filtering it moves no trial and cannot move a gate.
+    code_fp = _code_fingerprint()
+    for v in verdicts:
+        if not isinstance(v, dict):
+            continue
+        cell = str(v.get("cell") or "")
+        if not cell or cell in out:
+            continue
+        if not str(v.get("downstream_status") or "").startswith("NOT_RUN_BUILD_FAILED"):
+            continue
+        sym = str(v.get("sym") or "")
+        tf = _tf_from_cell(cell, v)
+        bars = _bar_bytes(sym, tf)
+        if not bars:
+            out[cell] = {"reason": "missing_bars", "sym": sym, "family": v.get("family"),
+                         "timeframe": tf, "days": 0, "bar_bytes": 0,
+                         "route": ("no bar file on this cell's own chart: the conversion organ's "
+                                   "bar supply owns it, so it is named and NOT filtered here"),
+                         "why": str(v.get("why") or "")[:200]}
+            continue
+        out[cell] = {
+            "reason": "build_failed", "sym": sym, "family": v.get("family"), "timeframe": tf,
+            "days": 0, "bar_bytes": bars, "code_fp": code_fp,
+            "route": ("signal construction returned no executable cell on bars that ARE "
+                      "present: filtered at intake so the judge stops rebuilding it every "
+                      "pass, and re-admitted the moment this chart's history grows OR the "
+                      "family code changes"),
+            "why": str(v.get("why") or "")[:200],
+        }
     return out
 
 
@@ -647,8 +726,16 @@ def update_unrunnable_bank(named: dict[str, dict[str, Any]], *, at: str,
     """Park every newly-named unrunnable cell, and RE-ADMIT any whose bars have since grown."""
     target = path or UNRUNNABLE_BANK
     bank = unrunnable_bank(target)
-    readmitted = [cell for cell, row in bank.items()
-                  if _bar_bytes(str(row.get("sym") or "")) > int(row.get("bar_bytes") or 0)]
+    code_fp = _code_fingerprint()
+    readmitted = [
+        cell for cell, row in bank.items()
+        if _bar_bytes(str(row.get("sym") or ""), str(row.get("timeframe") or "H1"))
+        > int(row.get("bar_bytes") or 0)
+        # A BUILD failure is also a fact about the family code: when that changes, every cell
+        # parked against the old code goes back to the judge rather than staying parked on a
+        # verdict the new code was never asked for.
+        or (row.get("reason") == "build_failed" and str(row.get("code_fp") or "") != code_fp)
+    ]
     for cell in readmitted:
         bank.pop(cell, None)
     added = 0
