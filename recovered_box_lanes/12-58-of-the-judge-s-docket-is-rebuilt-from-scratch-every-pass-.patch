+# --------------------------------------------------------------- the build-failure bank
+def _gates_report(tmp_path, verdicts):
+    p = tmp_path / "universal_gates_external.json"
+    p.write_text(json.dumps({"verdicts": verdicts}), "utf-8")
+    return p
+
+
+def test_build_failures_are_named_so_they_can_be_banked(tmp_path, monkeypatch):
+    """81,588 of 140,090 docket cells returned NOT_RUN_BUILD_FAILED every pass and were
+    re-attempted from scratch on the next one: they carry `downstream_status`, never
+    `unmeasured`, so the harvest that only read `unmeasured` never saw them at all."""
+    uni = tmp_path / "universe"
+    uni.mkdir()
+    (uni / "US2000_M5.parquet").write_bytes(b"PAR1" + b"x" * 500 + b"PAR1")
+    monkeypatch.setattr(jc, "UNIVERSE", uni)
+
+    rep = _gates_report(tmp_path, [{
+        "cell": "US2000@M5.anti_donchian_breakout.p=840102a22e999484",
+        "sym": "US2000", "family": "anti_donchian_breakout", "days": 0, "passed": None,
+        "stages": {}, "downstream_status": "NOT_RUN_BUILD_FAILED",
+        "why": "signal construction returned no executable cell"}])
+    named = jc.name_unknowns(rep)
+    row = named["US2000@M5.anti_donchian_breakout.p=840102a22e999484"]
+    assert row["reason"] == "build_failed"
+    assert row["timeframe"] == "M5", "the chart comes from the judge's own cell id"
+    assert row["bar_bytes"] == 508
+    assert row["code_fp"], "a build failure is banked against the family code that produced it"
+
+
+def test_a_build_failure_with_no_bars_is_named_but_never_filtered(tmp_path, monkeypatch):
+    """`missing_bars` belongs to the conversion organ's bar supply. Filtering it here would park
+    a cell for a reason this bank does not own."""
+    uni = tmp_path / "universe"
+    uni.mkdir()
+    monkeypatch.setattr(jc, "UNIVERSE", uni)
+    rep = _gates_report(tmp_path, [{
+        "cell": "NOBARS@H4.carry.p=deadbeef", "sym": "NOBARS", "family": "carry",
+        "downstream_status": "NOT_RUN_BUILD_FAILED", "why": "x"}])
+    named = jc.name_unknowns(rep)
+    assert named["NOBARS@H4.carry.p=deadbeef"]["reason"] == "missing_bars"
+    bank = tmp_path / "bank.json"
+    jc.update_unrunnable_bank(named, at="2026-09-24T18:00:00", path=bank)
+    assert jc.unrunnable_bank(bank) == {}, "missing_bars is never parked"
+
+
+def test_a_banked_build_failure_is_re_admitted_when_the_family_code_changes(tmp_path,
+                                                                           monkeypatch):
+    """THE GUARD THE COORDINATOR ASKED FOR: a permanently-cached failure that should have become
+    a pass is worse than the waste. Bar size alone cannot see a fix to a family, so the bank
+    carries the family code's fingerprint and re-opens on it."""
+    uni = tmp_path / "universe"
+    uni.mkdir()
+    (uni / "EURUSD_H1.parquet").write_bytes(b"z" * 900)
+    monkeypatch.setattr(jc, "UNIVERSE", uni)
+    bank = tmp_path / "bank.json"
+    row = {"reason": "build_failed", "sym": "EURUSD", "family": "carry", "timeframe": "H1",
+           "bar_bytes": 900, "code_fp": "stale-fingerprint"}
+    out = jc.update_unrunnable_bank({"EURUSD@H1.carry.p=1": row}, at="T0", path=bank)
+    assert out["bank_size"] == 1
+    # same bars, but the fingerprint on the row no longer matches the live family code
+    out = jc.update_unrunnable_bank({}, at="T1", path=bank)
+    assert out["readmitted_on_bar_growth"] == 1
+    assert jc.unrunnable_bank(bank) == {}
+
+
+def test_a_banked_build_failure_stays_parked_while_bars_and_code_are_unchanged(tmp_path,
+                                                                              monkeypatch):
+    """Measured on the box: bar file sizes are byte-stable hour to hour (grew=0 of 69,401 rows),
+    so the bank actually bites instead of flushing itself every pass."""
+    uni = tmp_path / "universe"
+    uni.mkdir()
+    (uni / "EURUSD_M15.parquet").write_bytes(b"z" * 900)
+    monkeypatch.setattr(jc, "UNIVERSE", uni)
+    bank = tmp_path / "bank.json"
+    row = {"reason": "build_failed", "sym": "EURUSD", "family": "carry", "timeframe": "M15",
+           "bar_bytes": 900, "code_fp": jc._code_fingerprint()}
+    jc.update_unrunnable_bank({"EURUSD@M15.carry.p=1": row}, at="T0", path=bank)
+    out = jc.update_unrunnable_bank({}, at="T1", path=bank)
+    assert out["readmitted_on_bar_growth"] == 0
+    assert set(jc.unrunnable_bank(bank)) == {"EURUSD@M15.carry.p=1"}
+    # and it DOES re-open when that chart's own history grows
+    (uni / "EURUSD_M15.parquet").write_bytes(b"z" * 1200)
+    out = jc.update_unrunnable_bank({}, at="T2", path=bank)
+    assert out["readmitted_on_bar_growth"] == 1
+
+
+def test_bar_bytes_reads_the_cells_own_chart_not_always_h1(tmp_path, monkeypatch):
+    """Re-admitting an M5 cell because the H1 frame grew is a different symbol's answer."""
+    uni = tmp_path / "universe"
+    uni.mkdir()
+    (uni / "XAUUSD_H1.parquet").write_bytes(b"h" * 100)
+    (uni / "XAUUSD_M5.parquet").write_bytes(b"m" * 700)
+    monkeypatch.setattr(jc, "UNIVERSE", uni)
+    assert jc._bar_bytes("XAUUSD") == 100            # default stays H1 for rows banked before
+    assert jc._bar_bytes("XAUUSD", "M5") == 700
+    assert jc._bar_bytes("XAUUSD", "D1") == 0        # absent chart is 0, never an exception
+
+
+def test_the_bank_never_filters_a_judged_verdict(tmp_path, monkeypatch):
+    """A build failure is NOT_RUN -- never a pass and never a fail -- so filtering it moves no
+    trial and cannot move a gate. A verdict that was actually judged must never be banked."""
+    uni = tmp_path / "universe"
+    uni.mkdir()
+    (uni / "EURUSD_H1.parquet").write_bytes(b"z" * 900)
+    monkeypatch.setattr(jc, "UNIVERSE", uni)
+    rep = _gates_report(tmp_path, [
+        {"cell": "EURUSD@H1.carry.p=1", "sym": "EURUSD", "family": "carry", "passed": False,
+         "terminal_gate": "deflated_sharpe", "days": 400},
+        {"cell": "EURUSD@H1.carry.p=2", "sym": "EURUSD", "family": "carry", "passed": True,
+         "terminal_gate": "PASSED", "days": 400},
+    ])
+    assert jc.name_unknowns(rep) == {}
