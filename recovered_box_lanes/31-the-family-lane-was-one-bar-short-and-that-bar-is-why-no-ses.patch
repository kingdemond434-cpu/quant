+"""E8 MIRRORS WHAT MT5 HAS ACTUALLY TRADED, NOT WHAT IT HAS MERELY BEEN ALLOCATED.
+
+Principal 2026-09-24: "Make them all trade in mt5 account first if they're doing well we put them
+on e8 too." MT5 is EUR 771; E8 is USD 98,759 against a hard 8% drawdown and an evaluation a bad
+run ends outright. So a sleeve earns E8 on REALISED broker fills from account 495044 -- never on
+a certificate, a shadow clock or a backtest, because every piece of evidence for and against
+`session_range_breakout` is bar simulation and a fill is the one thing simulation cannot produce.
+
+The gate is measured, so promotion stays automatic (principal 2026-09-04): nobody flips it.
+"""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+BASE = Path(__file__).resolve().parents[1]
+if str(BASE) not in sys.path:
+    sys.path.insert(0, str(BASE))
+
+from prop import e8_book as bk  # noqa: E402
+
+# THE GATE LIVES WITH THE MIRROR AND SKIPS LOUDLY WITHOUT IT, rather than taking collection down.
+# `e8_book.mirror` is in flight on another lane and has been reverted in this tree once already;
+# the gate has nothing to guard while E8 is not mirroring the MT5 roster, because then no MT5 row
+# reaches the prop account at all. A skip here is a REPORT that the gate is unwired (III.16), not
+# a pass -- when the mirror lands and this file still skips, that is the defect showing itself.
+if not hasattr(bk, "realised_gate"):                                # pragma: no cover
+    pytest.skip("prop/e8_book.py on this tree carries no `realised_gate`: the MT5->E8 mirror has "
+                "been reverted, so the realised-fill door is NOT wired. Re-land it with the "
+                "mirror -- without it a sleeve that has never filled on 495044 reaches the "
+                "funded prop account the moment it starts placing.",
+                allow_module_level=True)
+
+
+def _ledger(tmp_path: Path, rows: list[dict]) -> Path:
+    p = tmp_path / "live_ledger.jsonl"
+    p.write_text("\n".join(json.dumps(r) for r in rows), encoding="utf-8")
+    return p
+
+
+def _deal(sleeve: str, r: float, account: int = bk.MT5_LIVE_ACCOUNT) -> dict:
+    return {"sleeve": sleeve, "r_multiple": r, "account": account, "account_kind": "live"}
+
+
+def test_a_sleeve_with_no_realised_fill_is_withheld_from_e8(tmp_path: Path) -> None:
+    led = _ledger(tmp_path, [_deal("gold_asia", 0.5)])
+    ok, why, m = bk.realised_gate("xauusd_session_range_breakout_asia_5_wb_12", ledger=led)
+    assert ok is False
+    assert m["n"] == 0
+    assert "never traded" in why
+
+
+def test_enough_positive_fills_open_the_door_with_no_human_act(tmp_path: Path) -> None:
+    rows = [_deal("winner_sleeve", 0.4) for _ in range(bk.MIN_REALISED_FILLS)]
+    ok, why, m = bk.realised_gate("winner_sleeve", ledger=_ledger(tmp_path, rows))
+    assert ok is True and why == ""
+    assert m["n"] == bk.MIN_REALISED_FILLS and m["sum_r"] > 0
+
+
+def test_enough_fills_but_losing_stays_mt5_only(tmp_path: Path) -> None:
+    rows = [_deal("loser_sleeve", -0.4) for _ in range(bk.MIN_REALISED_FILLS + 3)]
+    ok, why, _ = bk.realised_gate("loser_sleeve", ledger=_ledger(tmp_path, rows))
+    assert ok is False and "not 'doing well'" in why
+
+
+def test_another_account_is_not_evidence_about_this_one(tmp_path: Path) -> None:
+    """A prop fill must never unlock the prop account."""
+    rows = [_deal("borrowed", 1.0, account=2478877) for _ in range(20)]
+    ok, _, m = bk.realised_gate("borrowed", ledger=_ledger(tmp_path, rows))
+    assert ok is False and m["n"] == 0
+
+
+def test_the_brokers_27_character_truncation_is_joined_and_named(tmp_path: Path) -> None:
+    """MT5 truncates the sleeve to the order comment, which is the ledger's only identity."""
+    name = "xauusd_session_range_breakout_asia_5_wb_12"
+    sibling = "xauusd_session_range_breakout_asia_0_wb_12"
+    rows = [_deal(name[:27], 0.6) for _ in range(bk.MIN_REALISED_FILLS)]
+    ok, _, m = bk.realised_gate(name, roster=[name, sibling], ledger=_ledger(tmp_path, rows))
+    assert ok is True, "a truncated comment must still join, or no sleeve could ever qualify"
+    assert m["n"] == bk.MIN_REALISED_FILLS
+    assert sibling in m["ambiguous_with"], (
+        "two rows sharing a truncated comment are indistinguishable at the broker and the "
+        "measurement must say so rather than guess")
+
+
+def test_the_gold_window_lane_never_reaches_the_gate() -> None:
+    """E8's existing gross is untouched: window rows are routed out before the test."""
+    rows = [{"name": "gold_asia", "symbol": "XAUUSD", "window": "asia", "risk_frac": 0.0114},
+            {"name": "gold_london_am", "symbol": "XAUUSD", "window": "london_am",
+             "risk_frac": 0.0127},
+            {"name": "gold_afternoon", "symbol": "XAUUSD", "window": "afternoon",
+             "risk_frac": 0.0127}]
+    doc = bk.mirror(tradeable={"XAUUSD"}, rows=rows, params_by_cell={})
+    assert doc["gold_windows"], "the gold lane must survive the mirror"
+    assert not doc["realised_gate"]["withheld"]
+    assert sum(doc["gold_windows"].values()) > 0
+
+
+def test_a_never_filled_family_row_is_withheld_but_named(tmp_path: Path) -> None:
+    rows = [{"name": "gold_asia", "symbol": "XAUUSD", "window": "asia", "risk_frac": 0.0114},
+            {"name": "gold_london_am", "symbol": "XAUUSD", "window": "london_am",
+             "risk_frac": 0.0127},
+            {"name": "gold_afternoon", "symbol": "XAUUSD", "window": "afternoon",
+             "risk_frac": 0.0127},
+            {"name": "xauusd_session_range_breakout_asia_5_wb_12", "symbol": "XAUUSD",
+             "family": "session_range_breakout", "selector": "asia", "exec": "family_market",
+             "risk_frac": 0.011398,
+             "certificate": {"cell": "external.XAUUSD.session_range_breakout.rr=1.5_wb=12"}}]
+    doc = bk.mirror(tradeable={"XAUUSD"}, rows=rows, params_by_cell={})
+    assert doc["realised_gate"]["withheld"] == ["xauusd_session_range_breakout_asia_5_wb_12"]
+    assert not any(r["key"].startswith("xauusd_session_range") for r in doc["sleeves"])
+    why = next(r["why"] for r in doc["refused"] if "session_range" in r["name"])
+    assert "realised fill" in why
