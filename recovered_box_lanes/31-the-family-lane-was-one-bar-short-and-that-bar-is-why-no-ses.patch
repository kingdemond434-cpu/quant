+def _held_side(symbol: str, pending: dict[str, float] | None = None) -> int | None:
+    """The direction the desk's book already runs on `symbol`: +1, -1, or None when flat or even.
+
+    THIS CHOOSES BETWEEN THE TWO LEGS OF ONE BREAKOUT, AND CHOOSES NOTHING ELSE. A
+    `session_range_breakout` bar carries a long at the range high AND a short at the range low;
+    exactly one is taken either way, and `family_signal_step` used to take whichever the family
+    appended last (always the short). Handed this, it takes the leg that AGREES with the book
+    and skips only the opposing one -- the principal's standing structure, and the reason it
+    matters here is that three SRB rows sit on XAUUSD beside three gold bracket windows.
+
+    NOT A CAP, A THROTTLE OR A VETO: the same one order is sent whatever this returns. It is
+    read from the same desk-tagged positions `same_side_count` reads, plus this pass's own
+    pending lots, so a pass that has already decided one leg does not then take the other.
+    """
+    net = float((pending or {}).get(symbol, 0.0))
+    try:
+        for p in mt5.positions_get() or []:
+            if str(getattr(p, "symbol", "") or "") != symbol:
+                continue
+            if not str(getattr(p, "comment", "") or "").startswith("DW"):
+                continue
+            vol = float(getattr(p, "volume", 0.0) or 0.0)
+            net += -vol if int(getattr(p, "type", -1)) == 1 else vol
+    except Exception:
+        return None
+    return 1 if net > 0 else (-1 if net < 0 else None)
+
+
