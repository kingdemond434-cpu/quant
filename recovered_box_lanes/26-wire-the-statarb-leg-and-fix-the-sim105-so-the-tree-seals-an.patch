+def statarb() -> dict:
+    """`statarb`: the statistical-arbitrage / mean-reversion screen and its regime gate.
+
+    THE SECOND MECHANISM, AND THAT IS THE POINT. The canon is 15 of 28 in
+    `session_range_breakout`, and E8 pass probability is counted in INDEPENDENT MECHANISMS --
+    three or four independent give ~92%, four CORRELATED give 77%. Breakout needs a trend and
+    mean reversion needs a dislocation without one, so this is independence one level up from
+    "another instrument", which is the level the pass probability is actually counted at.
+
+    IT READS A HAND-WRITTEN RELATIONSHIP LIST AND NEVER GENERATES ONE. 44 instruments would be
+    946 pairs, every one a trial against the same family-wise error budget that already collapsed
+    the 28-certificate canon to zero once charged honestly. `data/statarb_relationships.json`
+    names 36, each with an economic reason recorded before any number was computed, and
+    `tests/test_statarb_screen.py::test_the_screen_never_generates_pairs` is the fence.
+
+    It donates survivors through `proposer_common.donate` and judges nothing itself.
+    """
+    return _producer("statarb", "research/statarb_screen.py", "--budget-s", "600")
+
+
 def cost_to_edge() -> dict:
     """`cost_to_edge`: what each live sleeve PAYS to trade, against what it earns.
 
