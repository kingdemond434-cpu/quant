+def _standdown_log(monkeypatch, tmp_path: Path) -> Path:
+    """Stand-downs go to a temp log: a test never appends to the desk's own artifact."""
+    log = tmp_path / "standdowns.jsonl"
+    monkeypatch.setenv("QUANT_REFERENCE_STANDDOWN_LOG", str(log))
+    return log
+
