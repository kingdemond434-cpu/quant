+def test_a_stale_authority_retires_nothing_even_when_every_other_clause_says_settled(
+        desk: Path, monkeypatch, tmp_path: Path):
+    """LAWS 7, THE HALF `lane_settled` NEVER COVERED. The authority here is EXACT, holds three
+    rows and has nothing restorable -- settled by every clause the migration used to check -- and
+    its own stamp is three weeks old against its lease. That is the shape measured on the trading
+    box on 2026-09-24 (52 rows, EXACT, 3.2h against a 2.0h lease) with 264 unbacked clocks and 67
+    ledger claims standing ready to retire on it. A store past its lease is UNMEASURED, and
+    UNMEASURED never authorises a removal (L1.28a)."""
+    log = _standdown_log(monkeypatch, tmp_path)
+    paths = CT.Paths.at(desk)
+    for p in (paths.canon, paths.seal):
+        d = _r(p)
+        d["swept_at"] = "2026-09-01T00:00:00+00:00"          # older than any lease this desk sets
+        _w(p, d)
+    doc = CT.audit(paths)
+    assert doc["canon"]["status"] == "EXACT" and doc["canon"]["n"] > 0
+    assert doc["canon"]["restorable_n"] == 0
+    out = CT.apply(paths, doc)
+    assert out["reference"]["verdict"] == "STALE" and out["reference"]["live"] is False
+    assert out["lane_settled"] is False
+    # the clocks the settled lane would have retired are all still standing
+    reg = _r(paths.registry)["sleeves"]
+    assert reg["CHFNOK.carry.asia#input_symbol=CHFNOK"]["status"] == "LIVE"
+    assert out["skipped"]["unbacked_on_unmeasured_canon"] > 0
+    assert "stale" in out["retirement_withheld"]["reason"]
+    # and the refusal is on the record where an operator meets it without asking
+    assert log.exists() and "certificate_truth.apply" in log.read_text("utf-8")
+    # the ban is a decision, not a measurement: banned rows still leave
+    assert reg["EURCHF.discovered.asia#band=[0.9, 1.0]_feature=ru_24"]["status"] == "RETIRED"
+
