index 000000000..17d7fb556
--- /dev/null
+++ b/desks/mt5/tests/test_t8_bar_universal_gate_fragility_hunt12.py
@@ -0,0 +1,166 @@
+"""THE T8 BAR REACHES EVERY DEFLATED-SHARPE SITE, NOT ONLY THE SEALED JUDGE (principal, 2026-10-13).
+
+    "make sure the bars never raise never ever penalty never inflation due to trials"
+
+The T8 patch fixed external_gauntlet at sr0 = sqrt(1/(T-1)) x E[max of N=5 normals]. Three more
+sites still charged a moving N: universal_gate (the campaign charge AND the sweep variance),
+fragility (N = the hunt's cell count) and run_hunt12 (E_MAX = E[max t] over the grid size); and
+research/multiplicity (family and total test counts), plus universal_gate's remote worker
+(side_channels/ug_remote) and calibration twin (side_channels/gate_calibration). These tests pin
+N=5 in each, and that no sweep size or sweep variance moves the bar.
+"""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+DESK = Path(__file__).resolve().parent.parent
+for _p in (DESK, DESK / "research", DESK.parent.parent):
+    if str(_p) not in sys.path:
+        sys.path.insert(0, str(_p))
+
+import fragility  # noqa: E402
+import gate_policy as gp  # noqa: E402
+import universal_gate as ug  # noqa: E402
+from libs.validation.dsr import expected_max_sharpe  # noqa: E402
+from research import multiplicity as rm  # noqa: E402
+from research import run_hunt12 as h12  # noqa: E402
+
+
+def _verdict(n_trials: int, sh_var: float, n: int = 319) -> dict:
+    arr = np.random.default_rng(7).normal(0.2, 1.0, n)
+    return ug._ug_verdict(("c0", "XAUUSD", arr, arr, np.array([]), True, 0.1, True, 0.01,
+                           n_trials, sh_var))
+
+
+def test_universal_gate_charges_n5_and_the_cell_null_whatever_the_sweep() -> None:
+    assert gp.DSR_FIXED_TRIALS == 5
+    a = _verdict(109, 0.0002)["stages"]["deflated_sharpe"]
+    b = _verdict(1_000_000, 0.5)["stages"]["deflated_sharpe"]
+    assert a["n_trials"] == b["n_trials"] == 5
+    assert a["sr0"] == b["sr0"] == round(expected_max_sharpe(5, 1 / 318), 4)
+    assert a["trial_basis"].startswith("fixed_per_cell_bar(N=5")
+    assert b["campaign_trials_reported"] == 1_000_000, "the campaign count is reported, not charged"
+
+
+def test_universal_gate_source_no_longer_feeds_the_sweep_into_the_verdict() -> None:
+    src = Path(ug.__file__).read_text("utf-8")
+    assert "deflated_sharpe_ratio(arr, n_trials=n_trials" not in src
+    assert "dsr_hurdle_inputs(len(arr))" in src
+
+
+def test_fragility_sr0_is_the_t8_bar_and_ignores_the_cell_count(tmp_path, monkeypatch) -> None:
+    assert fragility.fixed_sr0(319) == pytest.approx(expected_max_sharpe(5, 1 / 318), rel=1e-6)
+    assert fragility.fixed_sr0(319) == pytest.approx(0.0669, abs=5e-5)
+    for n_cells in (40, 4_000):
+        doc = {"all": [{"n": 300, "t": float(t)} for t in np.linspace(-3, 3, n_cells)]}
+        (tmp_path / "h.json").write_text(json.dumps(doc), "utf-8")
+        monkeypatch.setattr(fragility, "REPORTS", tmp_path)
+        rep = fragility.dsr_for_hunt("h.json")
+        assert rep["n_trials"] == 5 and rep["n_cells_reported"] == n_cells
+        assert "sr0" not in rep, "no hunt-level sr0 sized to the cell count"
+    src = Path(fragility.__file__).read_text("utf-8")
+    assert "phi_inv(1 - 1.0 / n_cells)" not in src
+
+
+def test_hunt12_e_max_is_n5_and_never_the_grid_size() -> None:
+    assert h12.E_MAX == pytest.approx(gp.fixed_bar_deflation())
+    assert h12.E_MAX == pytest.approx(expected_max_sharpe(5, 1.0))
+    src = Path(h12.__file__).read_text("utf-8")
+    assert "E_MAX = deflation(sweep_size(" not in src
+    assert src.count("E_MAX = fixed_bar_deflation()") == 2
+
+
+def test_hunt12_battery_screen_is_the_tier_s_bar_not_e_max_plus_two() -> None:
+    """`defl > 2` was t > 3.163; the battery now clears exactly t > 2.837, the Tier-S bar."""
+    assert h12.BAR_MARGIN == pytest.approx(1.6448536, abs=1e-6)
+    assert h12.E_MAX + h12.BAR_MARGIN == pytest.approx(gp.fixed_bar_t())
+    src = Path(h12.__file__).read_text("utf-8")
+    assert "defl > 2 " not in src and "defl > BAR_MARGIN" in src
+
+
+def test_one_deflation_is_the_judges_bailey_form_and_the_bar_is_2_837() -> None:
+    """ONE number, not three (1.163 exact, 1.193 Bailey, 0.956 asymptotic): the judge's sr0 is
+    sqrt(1/(T-1)) x gate_policy.fixed_bar_deflation(), and the bar in t units is 2.837."""
+    assert gp.fixed_bar_deflation() == pytest.approx(expected_max_sharpe(5, 1.0), rel=1e-12)
+    assert gp.fixed_bar_deflation() == pytest.approx(1.1926, abs=5e-5)
+    assert gp.fixed_bar_t() == pytest.approx(2.8374, abs=5e-5)
+    for n_obs in (61, 319, 5_000):
+        _, var, _ = gp.dsr_hurdle_inputs(n_obs)
+        assert np.sqrt(var) * gp.fixed_bar_deflation() == pytest.approx(
+            expected_max_sharpe(5, var), rel=1e-12)
+        assert fragility.fixed_sr0(n_obs) == pytest.approx(expected_max_sharpe(5, var), rel=1e-12)
+
+
+def test_multiplicity_deflates_at_n5_whatever_the_family_or_total_count(tmp_path, monkeypatch):
+    rows = [{"family": "big" if i % 50 else "small", "t_stat": 4.0, "gate": True}
+            for i in range(5_000)]
+    (tmp_path / "rep.json").write_text(json.dumps({"all": rows}), "utf-8")
+    monkeypatch.setattr(rm, "BASE", tmp_path)
+    rep = rm.annotate_report("rep.json")
+    e5 = gp.fixed_bar_deflation()
+    for r in rep["all"]:
+        assert r["t_deflated_family"] == r["t_deflated_total"] == pytest.approx(4.0 - e5)
+    assert rep["all"][0]["n_tests_total"] == 5_000, "the count is reported, not charged"
+    assert rep["multiplicity"]["expected_max_z_total"] == pytest.approx(e5)
+    assert rep["multiplicity"]["expected_max_z_family_max"] == pytest.approx(e5)
+    assert rep["multiplicity"]["trials_charged"] == gp.DSR_FIXED_TRIALS == 5
+
+
+@pytest.mark.parametrize(("t", "admitted"), [(2.80, False), (2.85, True)])
+def test_multiplicity_gate_ds_is_the_tier_s_bar(tmp_path, monkeypatch, t, admitted) -> None:
+    """gate_ds was deflated > 2 at the asymptotic 0.956 (t > 2.956); it is now t > 2.837."""
+    (tmp_path / "rep.json").write_text(
+        json.dumps({"all": [{"family": "f", "t_stat": t, "gate": True}] * 3_000}), "utf-8")
+    monkeypatch.setattr(rm, "BASE", tmp_path)
+    rep = rm.annotate_report("rep.json")
+    assert all(r["gate_ds"] is admitted for r in rep["all"])
+    assert rep["multiplicity"]["bar_t"] == pytest.approx(gp.fixed_bar_t())
+
+
+def test_qquant_gates_worker_uses_the_fixed_per_cell_bar(monkeypatch) -> None:
+    """qquant_gates is not in IMMUTABLE_MANIFEST; it charged the campaign n_trials (109) plus the
+    sweep variance, dormant only under HOLD_qquant_gates. It now uses dsr_hurdle_inputs."""
+    import pandas as pd
+    import qquant_gates as qg
+
+    idx = pd.date_range("2020-01-01", periods=319, freq="D")
+    arr = np.random.default_rng(7).normal(0.2, 1.0, 319)
+    key = ("XAUUSD", "f", "LONG", "asia", "s")
+    monkeypatch.setitem(qg._worker_ctx, "cell_map",
+                        {key: {str(d.date()): float(x) for d, x in zip(idx, arr, strict=True)}})
+    row = {"sym": "XAUUSD", "fam": "f", "side": "LONG", "win": "asia", "state": "s"}
+    a = qg.worker_eval(row, 0.1, 0.01, 109, np.array([0.01, 0.02, 0.03]))
+    b = qg.worker_eval(row, 0.1, 0.01, 1_000_000, np.array([0.0, 1.0, 2.0]))
+    da, db = a["stages"]["deflated_sharpe"], b["stages"]["deflated_sharpe"]
+    assert da["n_trials"] == db["n_trials"] == 5
+    assert da["sr0"] == db["sr0"] == round(expected_max_sharpe(5, 1 / 318), 4)
+    assert db["campaign_trials_reported"] == 1_000_000, "reported, not charged"
+    src = Path(qg.__file__).read_text("utf-8")
+    assert "deflated_sharpe_ratio(arr, n_trials=n_trials" not in src
+    assert "dsr_hurdle_inputs(len(arr))" in src
+
+
+def test_ug_remote_is_the_same_t8_bar_as_universal_gate() -> None:
+    sys.path.insert(0, str(DESK / "side_channels"))
+    import ug_remote
+
+    arr = np.random.default_rng(7).normal(0.2, 1.0, 319)
+    remote = ug_remote._ug_verdict(("c0", "XAUUSD", arr, arr, True, 0.1, True, 0.01,
+                                    1_000_000, 0.5))["stages"]["deflated_sharpe"]
+    local = _verdict(109, 0.0002)["stages"]["deflated_sharpe"]
+    assert remote["n_trials"] == local["n_trials"] == 5
+    assert remote["sr0"] == local["sr0"] == round(expected_max_sharpe(5, 1 / 318), 4)
+
+
+def test_gate_calibration_uses_the_production_t8_bar() -> None:
+    from desks.mt5.side_channels import gate_calibration as gc
+
+    rets = np.random.default_rng(3).normal(0.05, 1.0, 400)
+    ds = gc.run_gate_evaluation(rets, gc.CalibrationConfig(true_sharpe=0.05))["deflated_sharpe"]
+    assert ds["n_trials"] == 5
+    assert ds["sr0"] == pytest.approx(expected_max_sharpe(5, 1 / 399))
