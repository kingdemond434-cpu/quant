--- /dev/null
+++ b/desks/mt5/tests/test_dsr_fixed_per_cell_bar.py
@@ -0,0 +1,103 @@
+"""THE DEFLATED-SHARPE BAR IS FIXED AND NEVER INFLATED BY A TRIAL COUNT (principal, 2026-10-07).
+
+    "we never charge trials like that everything is always fixed n no extra penalty trials
+     inflated charges anything ever all is always set as original"
+
+Until that ruling the judge charged max(campaign, family lifetime, lifetime UNION) read from
+EXPERIMENT_LEDGER.json, and on any host without that file every cell failed closed. The hurdle is
+now sr0 = sqrt(1/(T-1)) x E[max of N standard normals] at the spec's constant N and the cell's own
+T. These tests pin: the charge is the constant whatever the docket size; the verdict path never
+reads the ledger; a missing ledger fails nothing; and the bar at T=319 is the one live applied.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import pytest
+
+DESK = Path(__file__).resolve().parent.parent
+for _p in (DESK, DESK.parent.parent):
+    if str(_p) not in sys.path:
+        sys.path.insert(0, str(_p))
+
+from libs.validation.dsr import deflated_sharpe_ratio, expected_max_sharpe  # noqa: E402
+from research import gate_policy as gp  # noqa: E402
+from scripts import external_gauntlet as eg  # noqa: E402
+
+
+def _cell(family: str) -> dict:
+    return {"sym": "XAUUSD", "family": family, "params": {}, "mechanism_status": "NAMED",
+            "df": None, "sigs": [], "costs": None}
+
+
+def _strong(monkeypatch, n: int = 400) -> None:
+    rng = np.random.default_rng(11)
+    daily = pd.Series(rng.normal(0.3, 1.0, n), index=pd.date_range("2024-01-01", periods=n))
+    monkeypatch.setattr(eg, "daily_series", lambda *_a, **_kw: daily)
+
+
+def test_the_trial_input_is_the_spec_constant_and_ignores_docket_size(monkeypatch) -> None:
+    assert gp.DSR_FIXED_TRIALS == 5
+    assert gp._PARAMS["deflated_sharpe"]["fixed_dsr_trials"] == gp.DSR_FIXED_TRIALS
+    _strong(monkeypatch)
+    one = eg.run_gauntlet([_cell("carry")], "one", {})
+    many = eg.run_gauntlet([_cell(f"fam{i}") for i in range(6)], "six", {})
+    for res in (one, many):
+        for v in res["verdicts"]:
+            ds = v["stages"]["deflated_sharpe"]
+            assert ds["n_trials"] == gp.DSR_FIXED_TRIALS, ds
+            assert ds["trial_basis"].startswith(f"fixed_per_cell_bar(N={gp.DSR_FIXED_TRIALS}")
+    assert (one["verdicts"][0]["stages"]["deflated_sharpe"]["sr0"]
+            == many["verdicts"][0]["stages"]["deflated_sharpe"]["sr0"])
+    for raw in (1, 10, 10_000, 1_000_000):
+        assert gp.dsr_hurdle_inputs(319)[0] == gp.DSR_FIXED_TRIALS, raw
+
+
+def test_the_verdict_path_never_reads_the_experiment_ledger(monkeypatch) -> None:
+    calls: list[object] = []
+
+    def _refuse(*a, **k):
+        calls.append(a)
+        raise AssertionError("EXPERIMENT_LEDGER read")
+
+    from libs.research import experiment_ledger as el
+    monkeypatch.setattr(eg, "lifetime_trial_report", _refuse)
+    monkeypatch.setattr(el, "lifetime", _refuse)
+    monkeypatch.setattr(el, "family_trials", _refuse, raising=False)
+    _strong(monkeypatch)
+    res = eg.run_gauntlet([_cell("carry")], "no-ledger-read", {})
+    ds = res["verdicts"][0]["stages"]["deflated_sharpe"]
+    assert ds["passed"] is True and ds["n_trials"] == gp.DSR_FIXED_TRIALS
+    # The only caller is the REPORT annotation, which records its own failure and nothing else.
+    assert len(calls) <= 1 and res["trial_ledger"]["status"] == "UNMEASURED"
+    src = Path(eg.__file__).read_text("utf-8")
+    assert "charged_lifetime_trials" not in src
+    assert "_lifetime = lifetime_trial_report" not in src
+
+
+def test_a_missing_ledger_does_not_fail_the_deflated_sharpe(monkeypatch, tmp_path) -> None:
+    from libs.research import experiment_ledger as el
+    absent = tmp_path / "EXPERIMENT_LEDGER.json"
+    monkeypatch.setattr(el, "OUT", absent)
+    _strong(monkeypatch)
+    res = eg.run_gauntlet([_cell("carry")], "absent-ledger", {})
+    ds = res["verdicts"][0]["stages"]["deflated_sharpe"]
+    assert ds["passed"] is True and np.isfinite(ds["sr0"]), ds
+    assert res["trial_ledger"]["status"] == "UNMEASURED"
+    assert res["verdicts"][0]["stages"]["lockbox"].get("hurdle_sr0") == ds["sr0"]
+    assert not absent.exists(), "the judge must never write another organ's ledger"
+
+
+def test_sr0_at_t319_is_the_bar_live_applied() -> None:
+    n, var, _ = gp.dsr_hurdle_inputs(319)
+    arr = np.random.default_rng(0).normal(0.0, 1.0, 319)
+    sr0 = deflated_sharpe_ratio(arr, n_trials=n, variance_of_sharpes=var).sr0_threshold
+    live = expected_max_sharpe(234_977, 0.0002)          # lifetime union x variance 0.0002
+    assert round(live, 4) == 0.0647
+    assert sr0 == pytest.approx(0.0669, abs=5e-5)
+    assert abs(sr0 - live) < 0.0025, (sr0, live)
+    # As a t-stat: PSR >= 0.95 adds ~1.645 standard errors over sr0's ~1.19.
+    assert 2.7 < sr0 * np.sqrt(318) + 1.645 < 2.9
