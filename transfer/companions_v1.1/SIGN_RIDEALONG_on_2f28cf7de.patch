@@ -0,0 +1,157 @@
+"""The build loop keys a cell to its chart's data-day without re-reading the chart per spec.
+
+Box sweep 23324 (2026-10-20): 14 build shards spent 4,383-4,579 s each re-reading parquet only to
+learn `frame.index[-1]` for ~22k cache keys, after the pool had already spent the budget. These
+pin that the day is the same day `_bars_for` gives, read once, and that the pool's day is the
+day the shards look the cell up under.
+"""
+from __future__ import annotations
+
+import pandas as pd
+import pytest
+from desks.mt5.scripts import external_gauntlet as G
+
+
+@pytest.fixture(autouse=True)
+def _fresh_memo():
+    G._LAST_DAY.clear()
+    G._FRAME_CACHE.clear()
+    yield
+    G._LAST_DAY.clear()
+    G._FRAME_CACHE.clear()
+
+
+def _charts():
+    return sorted(G.UNI.glob("*_*.parquet"))[:40]
+
+
+@pytest.mark.parametrize("pq", _charts(), ids=lambda p: p.stem)
+def test_index_read_is_the_bars_for_day(pq) -> None:
+    sym, tf = pq.stem.rsplit("_", 1)
+    want = G._bars_for(sym, tf)
+    want_day = None if want is None or len(want) == 0 else want.index[-1].normalize()
+    got = G._index_last_day(pq)
+    # None means "not provably the same read": the caller then asks `_bars_for` itself.
+    assert got is None or got == want_day
+    G._FRAME_CACHE.clear()
+    assert G._cell_last_day(sym, tf) == want_day
+
+
+def test_unsorted_or_naive_index_falls_back_or_matches(tmp_path, monkeypatch) -> None:
+    monkeypatch.setattr(G, "UNI", tmp_path)
+    idx = pd.date_range("2026-10-01", periods=48, freq="h")
+    df = pd.DataFrame({"open": 1.0, "high": 1.0, "low": 1.0, "close": 1.0}, index=idx)
+    df.iloc[::-1].to_parquet(tmp_path / "XXX_H1.parquet")
+    assert G._index_last_day(tmp_path / "XXX_H1.parquet") is None
+    assert G._cell_last_day("XXX", "H1") == G._bars_for("XXX", "H1").index[-1].normalize()
+    df.to_parquet(tmp_path / "YYY_H1.parquet")
+    assert G._index_last_day(tmp_path / "YYY_H1.parquet") == pd.Timestamp("2026-10-02", tz="UTC")
+
+
+def test_one_read_per_chart_per_process(monkeypatch) -> None:
+    pq = _charts()[0]
+    sym, tf = pq.stem.rsplit("_", 1)
+    first = G._cell_last_day(sym, tf)
+
+    def boom(*a, **k):
+        raise AssertionError("a memoised chart must not be read again")
+
+    monkeypatch.setattr(G, "_index_last_day", boom)
+    monkeypatch.setattr(G, "_bars_for", boom)
+    assert G._cell_last_day(sym, tf) == first
+
+
+def test_deferral_after_the_budget_reads_no_bars(monkeypatch) -> None:
+    day = pd.Timestamp("2026-10-20", tz="UTC")
+    G._LAST_DAY[("AAA", "H1")] = day
+    monkeypatch.setattr(G, "_bars_for", lambda *a, **k: (_ for _ in ()).throw(
+        AssertionError("deferral must not load bars")))
+    monkeypatch.setattr(G, "cache_load", lambda key: None)
+    specs = [{"sym": "AAA", "family": "carry", "params": {"n": i}} for i in range(50)]
+    out = G._build_specs(specs, {}, 0.0, G.stage0_new_summary(), {}, set(), [])
+    assert len(out["deferred"]) == 50 and out["built_fresh"] == 0
+
+
+def test_the_shard_looks_up_the_pools_key(monkeypatch) -> None:
+    """The pool's day for a chart is the day the loop keys the same cell to."""
+    day = pd.Timestamp("2026-10-20", tz="UTC")
+    spec = {"sym": "AAA", "family": "carry", "params": {}}
+    want = G._cache_key("AAA", "carry", {}, str(day.date()), "H1")
+    G._LAST_DAY[("AAA", "H1")] = day
+    seen = []
+    monkeypatch.setattr(G, "cache_load", lambda key: seen.append(key) or (
+        pd.Series([0.0]), pd.Series([0.0])))
+    monkeypatch.setattr(G, "stage0_record", lambda *a, **k: None)
+    out = G._build_specs([spec], {}, 0.0, G.stage0_new_summary(), {}, set(), [])
+    assert seen == [want] and out["cache_hits"] == 1
+
+
+# ------------------------------------------- audit MUST-FIX: a fresh build is keyed by its frame
+MEMO_DAY = pd.Timestamp("2026-10-09", tz="UTC")
+FRESH_DAY = pd.Timestamp("2026-10-17", tz="UTC")
+
+
+def _moved_frame():
+    idx = pd.date_range("2026-09-01", "2026-10-17 15:00", freq="h", tz="UTC")
+    return pd.DataFrame({"open": 1.0, "high": 1.0, "low": 1.0, "close": 1.0}, index=idx)
+
+
