@@ -0,0 +1,171 @@
+"""THE LOOK-AHEAD GUARD BINDS AT THE GAUNTLET: an LLM-born cell is judged on post-guard days only.
+
+  * a cell in the lab's evidence-start map loses every day before its start, in BOTH cost arms,
+    whether its series came fresh or from the cache, and the cache keeps the FULL series;
+  * a match survives the compiler filling in default params;
+  * a cell's own `lookahead_guard` stamp binds even when the map lost it, and the later date wins;
+  * it FAILS CLOSED: an LLM-born cell with an unparseable start, or any LLM-born cell while the
+    map is unreadable, is HELD (empty series, UNMEASURED with the reason);
+  * only a cell with no LLM provenance and no map entry is untouched.
+"""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import pytest
+
+_DESK = Path(__file__).resolve().parents[1]
+_ROOT = _DESK.parent.parent
+for _p in (str(_DESK), str(_DESK / "research"), str(_ROOT)):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+from desks.mt5.scripts import external_gauntlet as G  # noqa: E402
+
+
+def _ds() -> pd.Series:
+    idx = pd.date_range("2026-01-01", periods=300, freq="D")
+    return pd.Series(np.linspace(-1, 1, 300), index=idx)
+
+
+@pytest.fixture()
+def guard_map(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
+    p = tmp_path / "evidence_start.json"
+    monkeypatch.setattr(G, "EVIDENCE_START", p)
+    G._EVIDENCE_CACHE.update({"mtime": None, "map": {}, "by_cell": {}, "error": ""})
+    return p
+
+
+def _write(p: Path, cell: dict, start: str, params: dict | None = None) -> None:
+    cid = G.cell_id({"sym": cell["sym"], "family": cell["family"], "params": cell["params"]})
+    p.write_text(json.dumps({cid: {"from": start, "sym": cell["sym"], "family": cell["family"],
+                                   "params": params if params is not None else cell["params"]}}))
+
+
+def test_days_before_the_evidence_start_are_dropped(guard_map: Path) -> None:
+    cell = {"sym": "EURUSD", "family": "formula", "params": {"expr": "rank(ret)"}}
+    _write(guard_map, cell, "2026-06-01")
+    kept = G.evidence_trim(cell, _ds())
+    assert kept.index.min() == pd.Timestamp("2026-06-01") and len(kept) == 300 - 151
+    assert cell["_evidence_from"] == "2026-06-01" and cell["_evidence_dropped_days"] == 151
+    tz = _ds().tz_localize("UTC")
+    assert G.evidence_trim(dict(cell), tz).index.min() == pd.Timestamp("2026-06-01", tz="UTC")
+
+
+def test_a_match_survives_compiler_filled_params(guard_map: Path) -> None:
+    donated = {"sym": "USDJPY", "family": "exogenous_conditioner",
+               "params": {"source": "cb_tone_boj", "signal": "tone_llm_clean"}}
+    _write(guard_map, donated, "2026-09-01")
+    judged = {**donated, "params": {**donated["params"], "transform": "level_z", "lag_hours": 24}}
+    assert G.evidence_from(judged) == "2026-09-01"
+    assert G.evidence_from({**judged, "sym": "EURJPY"}) is None
+
+
+def test_human_cells_are_untouched_by_an_absent_or_unreadable_map(guard_map: Path) -> None:
+    cell = {"sym": "EURUSD", "family": "carry", "params": {}}
+    ds = _ds()
+    assert G.evidence_trim(cell, ds) is ds, "absent map"
+    guard_map.write_text("{not json")
+    assert G.evidence_trim(dict(cell), ds) is ds, "no LLM provenance: nothing to guard"
+
+
+def test_the_cells_own_stamp_binds_and_the_later_date_wins(guard_map: Path) -> None:
+    cell = {"sym": "EURUSD", "family": "formula", "params": {"expr": "rank(ret)"},
+            "lookahead_guard": {"evidence_from": "2026-07-01"}}
+    assert G.evidence_from(dict(cell)) == "2026-07-01", "no map entry: the stamp alone binds"
+    _write(guard_map, cell, "2026-06-01")
+    assert G.evidence_from(dict(cell)) == "2026-07-01"
+    _write(guard_map, cell, "2026-08-01")
+    assert G.evidence_from(dict(cell)) == "2026-08-01"
+
+
+@pytest.mark.parametrize("cell", [
+    {"sym": "EURUSD", "family": "formula", "params": {}, "lookahead_guard": {}},
+    {"sym": "EURUSD", "family": "formula", "params": {},
+     "lookahead_guard": {"evidence_from": "UNMEASURED"}},
+    {"sym": "EURUSD", "family": "formula", "params": {}, "producer": "llm_lab"},
+])
+def test_an_llm_born_cell_without_a_readable_start_is_held(guard_map: Path, cell: dict) -> None:
+    """Audit must-fix 3: the guard fails CLOSED."""
+    held = G.evidence_trim(cell, _ds())
+    assert len(held) == 0 and cell["_evidence_from"] == "UNMEASURED"
+    assert "look-ahead guard" in cell["_series_error"]
+
+
+def test_an_unreadable_map_holds_every_llm_born_cell(guard_map: Path) -> None:
+    guard_map.write_text("{not json")
+    cell = {"sym": "EURUSD", "family": "formula", "params": {},
+            "lookahead_guard": {"evidence_from": "2026-06-01"}}
+    assert len(G.evidence_trim(cell, _ds())) == 0
+
+
+def test_a_bad_date_in_the_map_holds_the_cell(guard_map: Path) -> None:
+    cell = {"sym": "EURUSD", "family": "formula", "params": {"expr": "x"}}
+    _write(guard_map, cell, "soon")
+    assert G.evidence_from(cell) == G.EVIDENCE_HOLD
+
+
+def test_provenance_rides_from_the_row_through_the_docket_onto_the_cell() -> None:
+    """Audit HOLD on e7547165: the docket dict dropped the three keys, so the guard failed open.
+    Every rebuild now carries CARRIED_SPEC_KEYS, and the docket folds each row in."""
+    src = Path(G.__file__).read_text(encoding="utf-8")
+    assert set(G.CARRIED_SPEC_KEYS) >= {"screen_read_until", "lookahead_guard", "producer",
+                                         "source"}
+    assert src.count("for _k in CARRIED_SPEC_KEYS") == 1
+    assert src.count("for k in CARRIED_SPEC_KEYS if spec.get(k)") == 1
+    assert src.count("merge_llm_provenance(cells[key], h)") == 2
+    spec: dict = {"sym": "EURUSD", "family": "formula", "params": {}}
+    G.merge_llm_provenance(spec, {"producer": "llm_lab.style",
+                                  "lookahead_guard": {"evidence_from": "2026-03-01"}})
+    assert G.llm_born(spec) and spec["lookahead_guard"]["evidence_from"] == "2026-03-01"
+
+
+def test_duplicate_rows_fold_closed(guard_map: Path) -> None:
+    spec: dict = {"sym": "EURUSD", "family": "formula", "params": {}}
+    G.merge_llm_provenance(spec, {"lookahead_guard": {"evidence_from": "2026-03-01"}})
+    G.merge_llm_provenance(spec, {"lookahead_guard": {"evidence_from": "2026-05-01"}})
+    G.merge_llm_provenance(spec, {"lookahead_guard": {"evidence_from": "2026-02-01"}})
+    assert spec["lookahead_guard"]["evidence_from"] == "2026-05-01", "the latest start wins"
+    G.merge_llm_provenance(spec, {"lookahead_guard": {"evidence_from": "soon"}})
+    assert G.evidence_from(spec) == G.EVIDENCE_HOLD, "an unreadable start holds the cell"
+    human: dict = {"sym": "EURUSD", "family": "formula", "params": {}, "producer": "miner"}
+    G.merge_llm_provenance(human, {"producer": "llm_lab.style"})
+    assert G.llm_born(human), "an llm_lab producer on any duplicate row marks the cell"
+    G.merge_llm_provenance(human, {"producer": "miner"})
+    assert G.llm_born(human), "and a later human row never clears it"
+
+
+def test_a_too_late_evidence_start_fails_closed(guard_map: Path) -> None:
+    """A start after the last day leaves no post-guard day: held with the reason."""
+    cell = {"sym": "EURUSD", "family": "formula", "params": {},
+            "lookahead_guard": {"evidence_from": "2027-06-01"}}
+    out = G.evidence_trim(cell, _ds())
+    assert len(out) == 0 and cell["_evidence_dropped_days"] == 300
+    assert "after the last day" in cell["_series_error"]
+    assert G.classify_unknown(out, None, None, errored=True) != "", "recorded UNMEASURED"
+
+
+def test_both_cost_arms_are_trimmed_and_the_cache_keeps_the_full_series(
+        guard_map: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    cell = {"sym": "EURUSD", "family": "formula", "params": {"expr": "rank(ret)"},
+            "_cached_ds": _ds(), "_cached_ds3": _ds(), "sigs": [], "df": None, "costs": None}
+    _write(guard_map, cell, "2026-06-01")
+    daily, hits = G._cell_series([cell], meta={})
+    x3 = G._cell_series_x3([cell])
+    assert hits == 1 and daily[0].index.min() == x3[0].index.min() == pd.Timestamp("2026-06-01")
+    fresh = {"sym": "EURUSD", "family": "formula", "params": {"expr": "rank(ret)"},
+             "sigs": [1], "df": "frame", "costs": "c", "_last_day": None, "_ckey": "k"}
+    monkeypatch.setattr(G, "daily_series", lambda df, sigs, costs: _ds())
+    monkeypatch.setattr(G, "costs_for", lambda sym, meta, mult=1.0: "c3")
+    # the hour-of-entry stack prices the stress arm through _stress_costs when present
+    monkeypatch.setattr(G, "_stress_costs", lambda *a, **k: "c3", raising=False)
+    saved: dict = {}
+    monkeypatch.setattr(G, "cache_save", lambda key, a, b: saved.update(key=key, a=a, b=b))
+    daily, _ = G._cell_series([fresh], meta={})
+    x3 = G._cell_series_x3([fresh])
+    assert daily[0].index.min() == x3[0].index.min() == pd.Timestamp("2026-06-01")
+    assert len(saved["a"]) == len(saved["b"]) == 300, "the cache stores the untrimmed series"
