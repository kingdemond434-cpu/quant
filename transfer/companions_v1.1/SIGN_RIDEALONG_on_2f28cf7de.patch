@@ -0,0 +1,39 @@
+"""The judge's restore loop never re-stamps a pre-v4 row (sealed patch, 2026-10-20).
+
+A retired row whose retirement reason stops holding is restored under the CURRENT attestation;
+when its gate 9 was never carved under the attestation's lockbox basis that is a re-stamp, so it
+goes to pending_rejudge instead. And when moving rows out empties the retired set, the stale
+`retired_certificates` block is cleared rather than kept.
+"""
+from __future__ import annotations
+
+import inspect
+
+from desks.mt5.research.gate_policy import ATTESTATION
+from desks.mt5.scripts import external_gauntlet as gauntlet
+
+V4 = {"gates": {"lockbox": {"passed": True, "lockbox_sharpe": 0.3, "cut": "2024-12-19",
+                            "basis": ATTESTATION["lockbox_basis"]}}}
+
+
+def test_a_pre_v4_row_would_be_restamped_a_v4_row_would_not() -> None:
+    assert gauntlet.restore_would_restamp({"gates": {"lockbox": {"passed": True,
+                                                                 "lockbox_sharpe": 0.3}}},
+                                          ATTESTATION)
+    assert gauntlet.restore_would_restamp({"gates": {"lockbox": {
+        "passed": True, "cut": "2024-12-19", "basis": "another basis"}}}, ATTESTATION)
+    assert gauntlet.restore_would_restamp({}, ATTESTATION)
+    assert not gauntlet.restore_would_restamp(V4, ATTESTATION)
+    # an attestation that reserves no lockbox restores exactly as before
+    assert not gauntlet.restore_would_restamp({}, {"version": "old"})
+
+
+def test_the_restore_loop_uses_it_and_an_emptied_retired_set_is_cleared() -> None:
+    # `main` IS SPLIT INTO ITS PHASES by the plan-resume patch (B2), its bodies moved verbatim:
+    # the steps are read across main, then the plan phase, then the judge phase, in that order.
+    src = "\n".join(inspect.getsource(getattr(gauntlet, f)) for f in
+                        ("main", "_plan_phase", "_judge_phase") if hasattr(gauntlet, f))
+    assert "if restore_would_restamp(row, ATTESTATION):" in src
+    assert '_remint["pending"][key] = back' in src
+    assert 'elif "retired_certificates" in old_doc:' in src
+    assert 'doc["retired_certificates"] = {}' in src
