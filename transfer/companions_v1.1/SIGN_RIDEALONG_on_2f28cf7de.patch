@@ -0,0 +1,116 @@
+"""A re-judge that could not measure a certificate never retires it (audit 2026-10-13).
+
+`remint_partition` lifts every row judged under an older attestation out of the survivor set and
+re-judges it. A verdict whose gates RULED against the cell retires it; one that measured nothing
+(UNMEASURED observations, an UNKNOWN terminal gate, a lockbox with no held-out evidence) is no
+evidence against the edge and must wait in `pending_rejudge`, judged first again.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+DESK = Path(__file__).resolve().parents[1]
+for _p in (str(DESK.parents[1]), str(DESK), str(DESK / "scripts"), str(DESK / "research")):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+import external_gauntlet as eg  # noqa: E402
+
+NOW = "2026-10-13T17:00:00+00:00"
+OLD = {"survivors": {"external.A.carry.p=1": {"cell": "A.carry.p=1", "gates": {"x": {}}}},
+       "gate_policy": {"version": "old"}}
+
+
+def _part(verdict):
+    survivors = {"external.A.carry.p=1": dict(OLD["survivors"]["external.A.carry.p=1"])}
+    return eg.remint_partition(OLD, survivors, [verdict], set(), set(),
+                               lambda gp: False, "new", NOW), survivors
+
+
+def _v(**kw):
+    return {"cell": "A.carry.p=1", "passed": False, **kw}
+
+
+def test_an_unmeasured_rejudge_keeps_the_certificate_pending() -> None:
+    out, survivors = _part(_v(unmeasured=True, terminal_gate="observations",
+                              unknown_reason="observations_under_60_days",
+                              stages={"observations": {"passed": False, "days": 12}}))
+    assert not out["retired"]
+    assert "external.A.carry.p=1" in out["pending"]
+    assert "could not rule" in out["pending"]["external.A.carry.p=1"]["pending_reason"]
+    assert out["record"]["rejudged_unmeasured_kept_pending"] == 1
+    assert "external.A.carry.p=1" not in survivors      # still outside the survivor set
+
+
+def test_an_unknown_terminal_gate_keeps_the_certificate_pending() -> None:
+    out, _ = _part(_v(terminal_gate="UNKNOWN",
+                      stages={"lockbox": {"passed": False, "unmeasured": True,
+                                          "lockbox_sharpe": None}}))
+    assert not out["retired"] and out["pending"]
+
+
+def test_a_lockbox_with_no_held_out_evidence_is_not_a_failure() -> None:
+    """Live `lockbox_stage` under its day floor: passed False, lockbox_sharpe None, no flag."""
+    out, _ = _part(_v(terminal_gate="lockbox",
+                      stages={"deflated_sharpe": {"passed": True},
+                              "lockbox": {"passed": False, "lockbox_sharpe": None,
+                                          "n_days": 20}}))
+    assert not out["retired"] and out["pending"]
+
+
+def test_a_measured_failure_still_retires() -> None:
+    out, _ = _part(_v(terminal_gate="deflated_sharpe",
+                      stages={"deflated_sharpe": {"passed": False, "dsr": 0.4},
+                              "lockbox": {"passed": False, "lockbox_sharpe": None}}))
+    assert "external.A.carry.p=1" in out["retired"]
+    assert not out["pending"]
+    assert "deflated_sharpe" in out["retired"]["external.A.carry.p=1"]["retired_reason"]
+
+
+def test_a_measured_lockbox_failure_still_retires() -> None:
+    out, _ = _part(_v(terminal_gate="lockbox",
+                      stages={"lockbox": {"passed": False, "lockbox_sharpe": -0.2}}))
+    assert out["retired"] and not out["pending"]
+
+
+def test_an_unpriced_cost_is_not_a_ruling() -> None:
+    """Audit 2026-10-13 MF1: `swap_cost` writes passed False with measured False."""
+    out, _ = _part(_v(terminal_gate="swap_cost",
+                      stages={"deflated_sharpe": {"passed": True},
+                              "swap_cost": {"passed": False, "measured": False,
+                                            "why": "UNMEASURED cost fails closed"}}))
+    assert not out["retired"] and out["pending"]
+
+
+def test_a_measured_cost_refusal_still_retires() -> None:
+    out, _ = _part(_v(terminal_gate="swap_cost",
+                      stages={"swap_cost": {"passed": False, "measured": True,
+                                            "why": "cost exceeds the edge"}}))
+    assert out["retired"] and not out["pending"]
+
+
+def test_the_canon_fronts_its_own_pending_rows() -> None:
+    """Audit 2026-10-13 MF2: no organ writes priority_remint.json; the canon is the source."""
+    doc = {"gate_policy": {"version": "new"},
+           "pending_rejudge": {"external.A.carry.p=1": {"cell": "A.carry.p=1"}},
+           "survivors": {"external.B.carry.p=2": {"cell": "B.carry.p=2"}}}
+    cells, keys = eg.canon_remint_cells(doc, lambda gp: True)
+    assert cells == {"A.carry.p=1"} and keys == {"external.A.carry.p=1"}
+
+
+def test_in_the_reseal_window_every_old_header_survivor_is_fronted() -> None:
+    doc = {"gate_policy": {"version": "old"},
+           "survivors": {"external.B.carry.p=2": {"cell": "B.carry.p=2"}}}
+    cells, keys = eg.canon_remint_cells(doc, lambda gp: False)
+    assert cells == {"B.carry.p=2"} and keys == {"external.B.carry.p=2"}
+
+
+def test_remint_cells_reads_the_canon_without_a_priority_file(tmp_path) -> None:
+    import json
+    canon = tmp_path / "UNIVERSAL_SURVIVORS.json"
+    canon.write_text(json.dumps({"gate_policy": {"version": "x"}, "survivors": {},
+                                 "pending_rejudge": {"external.A.carry.p=1":
+                                                     {"cell": "A.carry.p=1"}}}), "utf-8")
+    cells, keys = eg.remint_cells(tmp_path / "absent.json", canon)
+    assert "A.carry.p=1" in cells and "external.A.carry.p=1" in keys
