+SWEEP_PLAN_PROTOCOL = 1
+PLAN_RESUME_MAX_AGE_S = float(os.environ.get("GAUNTLET_PLAN_RESUME_MAX_AGE_S", str(24 * 3600)))
+#: A plan whose lockbox cut keeps moving after this many shard rebuilds is rebuilt whole.
