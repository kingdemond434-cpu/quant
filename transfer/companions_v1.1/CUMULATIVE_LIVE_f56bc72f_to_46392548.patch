+    for sp in st["eligible_specs"]:
+        cid = _cid(sp)
+        if cid not in gone:
+            planned.append(sp)
+        elif new_of_old.get(cid) in ready_by_id:
+            planned.append(ready_by_id.pop(new_of_old[cid]))  # re-planned in place
