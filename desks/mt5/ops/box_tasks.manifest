# THE DEPARTMENTS (2026-09-16): each research mission on its own hourly clock at full throughput
# (HOURLY_PLAN=dept:<name>) as 24/7 RESIDENTS (department_resident.py: singleton lock, a pass
# restarts the moment the last one ends, BELOW_NORMAL child, memory guard); the trigger is a
# keep-alive that is a no-op while the resident lives. MT5-Hourly is the discovery resident.
# Unlimited ExecutionTimeLimit, IgnoreNew, SYSTEM. Principal 2026-09-17: "pure 24/7".
TASK name="MT5-Dept-Data" trigger="at startup + every 10 minutes (keep-alive of a 24/7 resident)" runs="desks/mt5/research/department_resident.py" installer="NONE" lane="research"
TASK name="MT5-Dept-Intel" trigger="at startup + every 10 minutes (keep-alive of a 24/7 resident)" runs="desks/mt5/research/department_resident.py" installer="NONE" lane="research"
TASK name="MT5-Dept-Validate" trigger="at startup + every 10 minutes (keep-alive of a 24/7 resident)" runs="desks/mt5/research/department_resident.py" installer="NONE" lane="research"
