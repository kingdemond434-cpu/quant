TASK name="MT5-ResearchReports" trigger="at system start-up (resident)" runs="desks/mt5/scripts/run_research_reports.py" installer="NONE" lane="research"
TASK name="MT5-RiskUnitsFence" trigger="every 1 hour, at :02" runs="scripts/check_risk_units.py" installer="NONE" lane="ops"
