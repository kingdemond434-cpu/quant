+                        "params": spec.get("params") or {}})
+    except Exception:
+        name = (f"{spec.get('sym')}.{spec.get('family')}."
+                f"{json.dumps(spec.get('params') or {}, sort_keys=True, default=str)}")
+    return int(hashlib.sha256(str(name).encode("utf-8")).hexdigest()[:16], 16) % int(n_shards)
