{
 "note": "SEEDS for desks/mt5/research/github_repo_miner.py, the scheduled public-GitHub repo miner. A seed is where the walk STARTS, never where it ends: lists are walked for the repositories they link, searches page forward on a pushed-date cursor, and every repository found is queued in the miner's own state (data/github_repo_miner_state.json). Concepts are reimplemented through the compiler's door; no fetched code is executed or copied, and a quote is kept only under a copy-permitted licence (libs.data.datahub.COPY_PERMITTED).",
 "policy": {
  "files_per_repo": 6,
  "max_file_bytes": 400000,
  "max_readme_bytes": 400000,
  "max_links_per_list": 400,
  "list_depth": 2,
  "rescan_after_h": 168,
  "code_extensions": [".py", ".pine", ".mq5", ".mq4"],
  "code_path_pattern": "(?i)(strateg|signal|alpha|factor|indicator|backtest|trade|rule)"
 },
 "lists": [
