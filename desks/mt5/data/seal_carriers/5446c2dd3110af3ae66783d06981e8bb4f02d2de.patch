+def _prune_cache() -> dict:
+    """Delete cache files older than three days. Returns {scanned, removed, seconds}.
+
+    MEASURED 2026-11-11 (hourly pass idea 594): the old `glob` + `Path.stat()` + `unlink` loop
+    took 661 s of a 1,065 s sweep plan, all of it on the plan's critical path. `os.scandir`
+    hands back the directory listing's own stat on Windows (no extra call per file), and this
+    now runs on a background thread. The rule is the same > 3 days by mtime that
+    `stall_watch`'s gauntlet_cache tier mirrors. A file removed under a reader is a cache miss,
+    which `cache_load` already treats as a recompute.
+    """
+    import time as _t
+
+    t0 = _t.time()
+    out = {"scanned": 0, "removed": 0, "seconds": 0.0}
+    try:
+        with os.scandir(CACHE_DIR) as it:
+            for _e in it:
+                if not _e.name.endswith(".npz"):
+                    continue
+                out["scanned"] += 1
+                try:
+                    if _t.time() - _e.stat().st_mtime > 3 * 86400:
+                        Path(_e.path).unlink(missing_ok=True)
+                        out["removed"] += 1
+                except OSError:
+                    continue
+    except OSError:
+        pass
+    out["seconds"] = round(_t.time() - t0, 1)
+    return out
+
+
+def _prune_cache_in_background() -> None:
+    """Run `_prune_cache` on a daemon thread so the sweep plan never waits for it. A sweep that
+    exits first just leaves the rest for the next sweep's prune."""
+    import threading
+
+    threading.Thread(target=_prune_cache, name="gauntlet-cache-prune", daemon=True).start()
+
