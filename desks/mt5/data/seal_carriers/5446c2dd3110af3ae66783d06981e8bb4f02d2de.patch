diff --git a/desks/mt5/tests/test_prewarm_cache_io.py b/desks/mt5/tests/test_prewarm_cache_io.py
new file mode 100644
index 0000000000000000000000000000000000000000..ad22efd7a23545bfa3581c7a0b9068a484c9e050
--- /dev/null
+++ b/desks/mt5/tests/test_prewarm_cache_io.py
@@ -0,0 +1,136 @@
+"""The pre-warm's cache I/O (idea 600): a HIT decompresses nothing, a WARM is not re-loaded.
+
+Before: `_warm_one` asked "is this cached?" with `cache_load` (both series decompressed and built
+as pandas objects, then thrown away), and after every save it loaded the file it had just written
+to check it. The main loop loads each entry again to use it. These pin that the HIT test reads
+only the zip directory, the save's own return replaces the re-load, the main loop still replaces
+an entry that failed to load, and the sweep reports its cache bytes.
+"""
+from __future__ import annotations
+
+import sys
+import time
+import zipfile
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import pytest
+
+_DESK = Path(__file__).resolve().parents[1]
+_ROOT = _DESK.parent.parent
+for _p in (str(_DESK / "scripts"), str(_DESK), str(_ROOT)):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+from desks.mt5.scripts import external_gauntlet as G  # noqa: E402
+
+
+def _series(n: int = 30, scale: float = 1.0) -> pd.Series:
+    idx = pd.date_range("2026-01-01", periods=n, freq="D")
+    return pd.Series(np.arange(n, dtype=float) * scale, index=idx)
+
+
+def test_save_returns_the_entry_size_and_present_agrees(tmp_path, monkeypatch) -> None:
+    monkeypatch.setattr(G, "CACHE_DIR", tmp_path)
+    s = _series()
+    n = G.cache_save("k", s, s)
+    f = tmp_path / "k.npz"
+    assert n == f.stat().st_size > 0
+    assert G.cache_present("k") == n
+    got = G.cache_load("k")
+    assert got is not None and np.array_equal(got[0].to_numpy(), s.to_numpy())
+    assert not list(tmp_path.glob("*.tmp"))
+
+
+def test_present_is_zero_for_absent_garbage_and_incomplete_entries(tmp_path,
+                                                                   monkeypatch) -> None:
+    monkeypatch.setattr(G, "CACHE_DIR", tmp_path)
+    assert G.cache_present("absent") == 0
+    (tmp_path / "garbage.npz").write_bytes(b"not a zip at all")
+    assert G.cache_present("garbage") == 0
+    with zipfile.ZipFile(tmp_path / "half.npz", "w") as z:
+        z.writestr("dates.npy", b"x")
+        z.writestr("v1.npy", b"x")
+    assert G.cache_present("half") == 0
+
+
+def test_save_failure_returns_zero(tmp_path, monkeypatch) -> None:
+    monkeypatch.setattr(G, "CACHE_DIR", tmp_path / "file")
+    (tmp_path / "file").write_text("a file where the directory should be")
+    s = _series()
+    assert G.cache_save("k", s, s) == 0
+
+
+def test_save_always_replaces_an_entry_the_main_loop_could_not_load(tmp_path,
+                                                                    monkeypatch) -> None:
+    """The main loop saves only after `cache_load` returned None; a listed-but-unreadable entry
+    must be overwritten, never kept because its name is there."""
+    monkeypatch.setattr(G, "CACHE_DIR", tmp_path)
+    with zipfile.ZipFile(tmp_path / "k.npz", "w") as z:
+        for m in ("dates.npy", "v1.npy", "v3.npy"):
+            z.writestr(m, b"torn")
+    assert G.cache_present("k") > 0 and G.cache_load("k") is None
+    s = _series(scale=2.0)
+    assert G.cache_save("k", s, s) > 0
+    got = G.cache_load("k")
+    assert got is not None and np.array_equal(got[1].to_numpy(), s.to_numpy())
+
+
+def _warm_fixture(tmp_path, monkeypatch):
+    monkeypatch.setattr(G, "CACHE_DIR", tmp_path)
+    idx = pd.date_range("2025-01-01", periods=24 * 60, freq="h", tz="UTC")
+    frame = pd.DataFrame({"open": 1.0, "high": 1.1, "low": 0.9, "close": 1.0}, index=idx)
+    monkeypatch.setattr(G, "_bars_for", lambda sym, tf: frame)
+    monkeypatch.setattr(G, "build_cell",
+                        lambda sym, fam, params, meta: {"df": frame, "sigs": [], "costs": None})
+    monkeypatch.setattr(G, "daily_series", lambda df, sigs, costs: _series())
+    monkeypatch.setattr(G, "costs_for", lambda sym, meta, mult=1.0: None)
+    monkeypatch.setattr(G, "_series_trim_partial", lambda s, last_day: s)
+
+
+def test_warm_trusts_its_save_and_hit_decompresses_nothing(tmp_path, monkeypatch) -> None:
+    _warm_fixture(tmp_path, monkeypatch)
+
+    def _no_load(key):
+        raise AssertionError("the pre-warm must not decompress a cache entry")
+
+    monkeypatch.setattr(G, "cache_load", _no_load)
+    spec = {"sym": "EURUSD", "family": "fam", "params": {"timeframe": "H1"}}
+    first = G._warm_one(spec, {})
+    assert first["status"] == "WARMED", first
+    size = (tmp_path / f"{first['ckey']}.npz").stat().st_size
+    assert first["bytes_written"] == size
+    again = G._warm_one(spec, {})
+    assert again["status"] == "HIT"
+    assert again["bytes_not_decompressed"] == size
+
+
+def test_a_failed_save_is_save_failed(tmp_path, monkeypatch) -> None:
+    _warm_fixture(tmp_path, monkeypatch)
+    monkeypatch.setattr(G, "cache_save", lambda key, a, b: 0)
+    out = G._warm_one({"sym": "EURUSD", "family": "fam", "params": {"timeframe": "H1"}}, {})
+    assert out["status"] == "SAVE_FAILED"
+
+
+def _fake_warm(spec, meta):                          # module level: picklable for the pool
+    k = spec["params"]["k"]
+    if k.startswith("w"):
+        return {"status": "WARMED", "bytes_written": 1000}
+    return {"status": "HIT", "bytes_not_decompressed": 400}
+
+
+def test_the_sweep_reports_its_cache_bytes(monkeypatch) -> None:
+    import multiprocessing as mp
+    if mp.get_start_method(allow_none=True) not in (None, "fork") or sys.platform == "win32":
+        pytest.skip("the fake worker is installed by fork")
+    monkeypatch.setattr(G, "_warm_one", _fake_warm)
+    monkeypatch.setattr(G, "WORKERS", 2)
+    specs = [{"sym": "S", "family": "f", "params": {"k": f"{c}{i}"}}
+             for i, c in enumerate("wwwhh")]
+    out = G._prewarm_cache(specs, {}, time.time() + 600)
+    io = out["io"]
+    assert (out["warmed"], out["hit"]) == (3, 2)
+    assert io["bytes_written"] == 3000 == io["verify_bytes_not_reloaded"]
+    assert io["hit_bytes_not_decompressed"] == 800
+    assert io["bytes_per_warmed_cell"] == 1000
