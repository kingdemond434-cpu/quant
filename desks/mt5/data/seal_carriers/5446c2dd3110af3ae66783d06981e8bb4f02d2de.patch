+#: THE E[log W]-PER-CPU-SECOND BLEND (idea 617, 2026-11-11). The forward department publishes
+#: `reports/DOCKET_ELOG_PRIORITY.json` (`research/docket_elog_priority.py`): per family, the median
+#: of prior ΔE[log W] per day over estimated CPU seconds per cell. A family whose CPU cost is
+#: MEASURED (the prewarm meter) and whose ΔE[log W] has a PRIOR or MEASURED basis, with at least
+#: `ELOG_MIN_CELLS` SCORED cells (`n_scored`: the median's own sample), gets its yield weight multiplied by m = 1 + K*(2r - 1), r its rank in
+#: [0, 1] among such families; every other family gets m = 1. It RESHARES the build budget; it
+#: never drops a cell, and the floor, ceiling, exploration and orthogonality add-backs run after it
+#: unchanged. No trial count, gate or threshold is read or written. Bounded at K so a prior never
+#: overrules measured survivor yield by more than a factor of three between the extremes.
+ELOG_PRIORITY = REPORTS / "DOCKET_ELOG_PRIORITY.json"
+ELOG_BLEND_K = 0.5
+ELOG_MIN_CELLS = 30
+#: An older file is read as absent: a stale ranking steering this hour's budget is worse than none.
+ELOG_MAX_AGE_S = 6 * 3600
+
+
+def _elog_multipliers(families: list[str], path: Path | None = None,
+                      now: float | None = None) -> tuple[dict[str, float], dict]:
+    """Per-family budget multiplier from the E[log W]-per-CPU file; 1.0 wherever unmeasured."""
+    ones = {f: 1.0 for f in families}
+    src = path or ELOG_PRIORITY
+    try:
+        doc = json.loads(src.read_text("utf-8"))
+        fams = doc["families"]
+        at = datetime.fromisoformat(str(doc["at"]).replace("Z", "+00:00")).timestamp()
+    except (OSError, ValueError, TypeError, KeyError):
+        return ones, {"status": "UNMEASURED", "why": f"{src.name} absent or unreadable"}
+    age = (time.time() if now is None else now) - at
+    if not isinstance(fams, dict) or age > ELOG_MAX_AGE_S or age < -600:
+        return ones, {"status": "UNMEASURED", "why": f"{src.name} stale or malformed",
+                      "age_s": round(age)}
+    scored: dict[str, float] = {}
+    for f in families:
+        row = fams.get(f)
+        if not isinstance(row, dict):
+            continue
+        try:
+            v = float(row.get("score_median"))
+            n = int(row.get("n_scored") or 0)
+        except (TypeError, ValueError):
+            continue
+        if (row.get("basis_cpu") == "MEASURED"
+                and row.get("basis_d_elog") in ("PRIOR", "MEASURED")
+                and n >= ELOG_MIN_CELLS and math.isfinite(v)):
+            scored[f] = v
+    if len(scored) < 2:
+        return ones, {"status": "UNMEASURED", "why": f"{len(scored)} family(ies) scored; need 2",
+                      "n_scored": len(scored)}
+    vals = sorted(scored.values())
+    hi = len(vals) - 1
+    out = dict(ones)
+    for f, v in scored.items():
+        lo_i = vals.index(v)
+        hi_i = hi - vals[::-1].index(v)
+        r = ((lo_i + hi_i) / 2.0) / hi
+        out[f] = 1.0 + ELOG_BLEND_K * (2.0 * r - 1.0)
+    return out, {"status": "MEASURED", "n_scored": len(scored), "k": ELOG_BLEND_K}
+
 
