+def cache_present(key: str) -> int:
+    """The entry's size in bytes when its zip directory lists every member, else 0. I/O-light.
+
+    THE PRE-WARM'S HIT TEST (idea 600, 2026-11-11). `_warm_one` used `cache_load` to ask "is this
+    cell already cached?", which decompresses both series and builds two pandas Series only to
+    throw them away; the main loop then loads the same file again to use it. This reads the zip's
+    central directory (a few hundred bytes at the end of the file) and decompresses nothing.
+    Entries are written atomically (`os.replace`), so a listed entry is a whole one; should a
+    member still fail to decompress, the main loop's own `cache_load` returns None and the cell
+    takes the fresh branch it has always taken for an uncached cell. No verdict reads this."""
+    import zipfile
+    f = CACHE_DIR / f"{key}.npz"
+    try:
+        with zipfile.ZipFile(f) as z:
+            names = set(z.namelist())
+        if all(m in names for m in _CACHE_MEMBERS):
+            return f.stat().st_size
+    except (OSError, ValueError, zipfile.BadZipFile):
+        return 0
+    return 0
+
 
