+"""The pre-warm's per-family cost record: report-only, and it never needs a worker's help."""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+DESK = Path(__file__).resolve().parents[1]
+for p in (str(DESK), str(DESK / "scripts"), str(DESK.parent.parent)):
+    if p not in sys.path:
+        sys.path.insert(0, p)
+
+import external_gauntlet as eg  # noqa: E402
+
+
+def _summary() -> dict:
+    return {"worker_seconds": {}, "by_family": {}}
+
+
+def test_seconds_are_summed_per_status_and_family() -> None:
+    s = _summary()
+    eg._cost(s, {"family": "a"}, "WARMED", 2.0)
+    eg._cost(s, {"family": "a"}, "HIT", 0.5)
+    eg._cost(s, {"family": "b"}, "WARMED", 7.25)
+    assert s["worker_seconds"] == {"WARMED": 9.25, "HIT": 0.5}
+    assert s["by_family"]["a"] == {"n": 2, "s": 2.5, "max_s": 2.0, "warmed": 1}
+    assert s["by_family"]["b"]["max_s"] == 7.25
+
+
+def test_a_result_without_seconds_is_not_counted() -> None:
+    s = _summary()
+    eg._cost(s, {"family": "a"}, "WARMED", None)
+    assert s == _summary()
+
+
+def test_the_published_table_keeps_the_costliest_and_folds_the_rest() -> None:
+    s = _summary()
+    for i in range(eg.PREWARM_COST_TOP + 3):
+        eg._cost(s, {"family": f"f{i}"}, "WARMED", float(i + 1))
+    top = eg._top_families(s["by_family"])
+    assert list(top)[0] == f"f{eg.PREWARM_COST_TOP + 2}"
+    assert top["_rest"] == {"families": 3, "n": 3, "s": 6.0}
+
+
+def test_warm_one_reports_its_own_seconds(monkeypatch) -> None:
+    monkeypatch.setattr(eg, "_bars_for", lambda sym, tf: None)
+    out = eg._warm_one_timed({"sym": "EURUSD", "family": "x", "params": {}}, {})
+    assert out["status"] == "NOT_RUN_DATA_MISSING" and out["seconds"] >= 0.0
+
+
+def test_the_pool_gets_meta_once_at_start_up_never_per_task() -> None:
+    """Meta crosses to each worker once (initializer); a task carries only its spec."""
+    import inspect
+
+    src = inspect.getsource(eg._prewarm_cache)
+    assert "initializer=_init_prewarm_worker" in src and "initargs=(meta,)" in src
+    assert "pool.submit(_warm_one_pooled, sp)" in src
+    assert "pool.submit(_warm_one_timed, sp, meta)" not in src
+
+
+def test_a_pooled_worker_uses_the_meta_it_was_started_with(monkeypatch) -> None:
+    seen = {}
+
+    def fake(spec, meta):
+        seen["meta"] = meta
+        return {"status": "HIT", "seconds": 0.0}
+
+    monkeypatch.setattr(eg, "_warm_one_timed", fake)
+    monkeypatch.setattr(eg, "_WORKER_META", None)
+    assert eg._warm_one_pooled({"sym": "X"})["status"] == "ERROR"
+    meta = {"costs": 1}
+    eg._init_prewarm_worker(meta)
+    try:
+        assert eg._warm_one_pooled({"sym": "X"})["status"] == "HIT"
+        assert seen["meta"] is meta
+    finally:
+        eg._WORKER_META = None
+
+
+def test_the_cache_prune_removes_only_files_past_three_days(tmp_path, monkeypatch) -> None:
+    import os
+    import time
+
+    monkeypatch.setattr(eg, "CACHE_DIR", tmp_path)
+    old, new, other = tmp_path / "a.npz", tmp_path / "b.npz", tmp_path / "c.tmp"
+    for f in (old, new, other):
+        f.write_bytes(b"x")
+    past = time.time() - 4 * 86400
+    os.utime(old, (past, past))
+    os.utime(other, (past, past))
+    out = eg._prune_cache()
+    assert (out["scanned"], out["removed"]) == (2, 1)
+    assert not old.exists() and new.exists() and other.exists()
+
+
+def test_the_sweep_plan_does_not_wait_for_the_prune() -> None:
+    import inspect
+
+    src = inspect.getsource(eg)
+    assert "    _prune_cache_in_background()\n" in src
+    assert 'CACHE_DIR.glob("*.npz")' not in src
+    bg = inspect.getsource(eg._prune_cache_in_background)
+    assert "daemon=True" in bg and "target=_prune_cache" in bg
