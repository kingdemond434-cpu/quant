diff --git a/desks/mt5/tests/test_gauntlet_elog_blend.py b/desks/mt5/tests/test_gauntlet_elog_blend.py
new file mode 100644
index 0000000000000000000000000000000000000000..699aefba389726d8ef84fbae3fa4281052e9b1ec
--- /dev/null
+++ b/desks/mt5/tests/test_gauntlet_elog_blend.py
@@ -0,0 +1,105 @@
+"""The E[log W]-per-CPU blend in the sealed `allocate_by_yield` (idea 617).
+
+It reshares the build budget between families and never drops a cell; every unmeasured,
+stale or thin input leaves the multiplier at exactly 1.0, so the sweep is unchanged today.
+"""
+from __future__ import annotations
+
+import json
+import sys
+import time
+from datetime import UTC, datetime
+from pathlib import Path
+
+DESK = Path(__file__).resolve().parents[1]
+for p in (DESK / "scripts", DESK):
+    if str(p) not in sys.path:
+        sys.path.insert(0, str(p))
+
+import external_gauntlet as G  # noqa: E402
+
+
+def _write(path: Path, fams: dict, *, at: float | None = None) -> Path:
+    ts = datetime.fromtimestamp(time.time() if at is None else at, tz=UTC).isoformat()
+    path.write_text(json.dumps({"at": ts, "families": fams}), "utf-8")
+    return path
+
+
+def _row(score, *, cpu="MEASURED", elog="PRIOR", n=100):
+    return {"score_median": score, "basis_cpu": cpu, "basis_d_elog": elog, "n_scored": n,
+            "n_cells": n + 50}
+
+
+def test_absent_file_is_all_ones(tmp_path):
+    m, st = G._elog_multipliers(["a", "b"], path=tmp_path / "none.json")
+    assert m == {"a": 1.0, "b": 1.0} and st["status"] == "UNMEASURED"
+
+
+def test_stale_file_is_all_ones(tmp_path):
+    p = _write(tmp_path / "f.json", {"a": _row(1.0), "b": _row(2.0)},
+               at=time.time() - G.ELOG_MAX_AGE_S - 60)
+    m, st = G._elog_multipliers(["a", "b"], path=p)
+    assert m == {"a": 1.0, "b": 1.0} and st["status"] == "UNMEASURED"
+
+
+def test_unmeasured_cpu_thin_or_null_rows_stay_at_one(tmp_path):
+    p = _write(tmp_path / "f.json", {
+        "a": _row(1.0), "b": _row(3.0),
+        "c": _row(9.0, cpu="PRIOR"), "d": _row(9.0, elog="UNMEASURED"),
+        "e": _row(9.0, n=G.ELOG_MIN_CELLS - 1), "f": _row(None)})
+    m, st = G._elog_multipliers(list("abcdef"), path=p)
+    assert st["status"] == "MEASURED" and st["n_scored"] == 2
+    assert m["a"] == 1.0 - G.ELOG_BLEND_K and m["b"] == 1.0 + G.ELOG_BLEND_K
+    assert all(m[f] == 1.0 for f in "cdef")
+
+
+def test_one_scored_family_moves_nothing(tmp_path):
+    p = _write(tmp_path / "f.json", {"a": _row(1.0)})
+    m, _ = G._elog_multipliers(["a", "b"], path=p)
+    assert m == {"a": 1.0, "b": 1.0}
+
+
+def test_multipliers_are_bounded_and_ties_share_a_rank(tmp_path):
+    p = _write(tmp_path / "f.json", {"a": _row(1.0), "b": _row(1.0), "c": _row(5.0)})
+    m, _ = G._elog_multipliers(["a", "b", "c"], path=p)
+    assert m["a"] == m["b"]
+    assert all(1.0 - G.ELOG_BLEND_K <= v <= 1.0 + G.ELOG_BLEND_K for v in m.values())
+
+
+def test_the_blend_reshares_and_never_drops_a_cell(tmp_path, monkeypatch):
+    p = _write(tmp_path / "f.json", {"a": _row(1.0), "b": _row(9.0)})
+    monkeypatch.setattr(G, "ELOG_PRIORITY", p)
+    monkeypatch.setattr(G, "REPORTS", tmp_path)
+    monkeypatch.setattr(G, "_family_yield", lambda root=None: {})
+    monkeypatch.setattr(G, "_house_yield", lambda: 0.01)
+    monkeypatch.setattr(G, "_explore_unmeasured_axes", lambda specs, keep: ([], {}))
+    monkeypatch.setattr(G, "_orthogonality_floor", lambda specs, keep: ([], {}))
+    specs = ([{"family": "a", "sym": f"A{i}"} for i in range(400)]
+             + [{"family": "b", "sym": f"B{i}"} for i in range(400)])
+    keep, report = G.allocate_by_yield(specs)
+    n_a = sum(1 for s in keep if s["family"] == "a")
+    n_b = sum(1 for s in keep if s["family"] == "b")
+    assert n_b > n_a >= int(G.YIELD_MIN_SHARE * 400)
+    assert report["a"]["elog_multiplier"] < 1.0 < report["b"]["elog_multiplier"]
+    assert report["a"]["yield_per_1k_ruled"] == report["b"]["yield_per_1k_ruled"]
+    doc = json.loads((tmp_path / "RESEARCH_ALLOCATION.json").read_text("utf-8"))
+    assert doc["elog_blend"]["status"] == "MEASURED"
+
+
+def test_contract_the_publishers_real_build_output_moves_the_blend(tmp_path):
+    """Auditor M1: run the reader over a file `docket_elog_priority.build()` actually wrote.
+
+    The fixture is #979's real output at 47302cd89 (two families, cpu MEASURED, d_elog PRIOR,
+    32 scored cells each), copied verbatim; only `at` is refreshed so the age check admits it.
+    """
+    src = DESK / "tests" / "fixtures" / "docket_elog_priority_build_47302cd89.json"
+    doc = json.loads(src.read_text("utf-8"))
+    doc["at"] = datetime.now(tz=UTC).isoformat()
+    p = tmp_path / "DOCKET_ELOG_PRIORITY.json"
+    p.write_text(json.dumps(doc), "utf-8")
+    fams = sorted(doc["families"])
+    m, st = G._elog_multipliers(fams + ["unlisted"], path=p)
+    assert st["status"] == "MEASURED" and st["n_scored"] == 2
+    assert m["session_range_breakout"] == 1.0 + G.ELOG_BLEND_K
+    assert m["overnight_gap_decay"] == 1.0 - G.ELOG_BLEND_K
+    assert m["unlisted"] == 1.0
diff --git a/desks/mt5/tests/test_gauntlet_fill_minute.py b/desks/mt5/tests/test_gauntlet_fill_minute.py
new file mode 100644
index 0000000000000000000000000000000000000000..e9988a46dff1a9c800a868bba459dc3faaac34e4
--- /dev/null
+++ b/desks/mt5/tests/test_gauntlet_fill_minute.py
@@ -0,0 +1,78 @@
+"""The judge charges a fill its MINUTE's measured spread, not only its hour's (2026-11-11).
+
+EURCHF formula p=494964b2 was certified on 19 symbols for an edge that lives in the first minute
+after the broker 01:00 open, where the tick spread is 62 pts p50 against ~2 for the rest of the
+hour; at the real ask it loses from one minute late. Pinned: a cell whose fills land on a
+published spike minute is charged that minute's spread and its basis says so; a cell that never
+fills there keeps the charge it had; nothing here can lower a charge.
+"""
+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+import pytest
+from desks.mt5.scripts import external_gauntlet as gauntlet
+from mt5desk import families
+from mt5desk.engine import Signal
+
+SYM = "TESTFX"
+META = {SYM: {"symbol": SYM, "asset_class": "Forex", "tick_size": 1e-05, "tick_value": 1.0,
+              "contract_size": 100000.0, "median_spread_pts": 7.0}}
+
+
+def _bars() -> pd.DataFrame:
+    idx = pd.date_range("2026-01-01", periods=24 * 60, freq="h", tz="UTC", name="time")
+    close = 1.0 + np.cumsum(np.full(len(idx), 1e-6))
+    return pd.DataFrame({"open": close, "high": close + 1e-4, "low": close - 1e-4,
+                         "close": close, "tick_volume": np.ones(len(idx), dtype="int64"),
+                         "spread": np.full(len(idx), 7, dtype="int32")}, index=idx)
+
+
+def _family_rollover_probe(df: pd.DataFrame, side: int = 1, **_: object) -> list[Signal]:
+    """Signal on every 00:00 bar; wait_bars=1 fills it at 01:00, minute 0."""
+    return [Signal(time=t, side=int(side), stop=float(df["close"].iloc[i]) - 0.003,
+                   target=float(df["close"].iloc[i]) + 0.006, ttl_bars=24, tag="probe")
+            for i, t in enumerate(df.index) if t.hour == 0]
+
+
+@pytest.fixture
+def judge(monkeypatch: pytest.MonkeyPatch):
+    monkeypatch.setattr(families, "family_rollover_probe", _family_rollover_probe, raising=False)
+    monkeypatch.setattr(gauntlet, "_SURFACE_TRIED", True)
+
+    def surface(minutes: dict) -> None:
+        monkeypatch.setattr(gauntlet, "_COST_SURFACE", {"symbols": {SYM: {
+            "hours": {"1": {"status": "MEASURED", "p50": 2.0}},
+            "tick_hours": {"spike_minutes": minutes}}}})
+    return surface
+
+
+def _cell():
+    return gauntlet.build_cell(SYM, "rollover_probe", {}, META, h1_override=_bars())
+
+
+def test_a_fill_on_the_post_rollover_minute_pays_that_minutes_spread(judge) -> None:
+    judge({"01:00": {"p50": 62.0}})
+    cell = _cell()
+    assert cell is not None, gauntlet.LAST_BUILD_FAILURE
+    assert cell["_fill_hour"] == 1
+    assert cell["_fill_minute"]["spike_share"] == 1.0
+    assert cell["_cost_basis"].startswith("fill_minute_spike_100%_01:00")
+    hour_only = gauntlet.Costs.from_symbol(META[SYM], spread_pts=2.0)
+    assert cell["costs"].per_oz_roundtrip() > hour_only.per_oz_roundtrip()
+
+
+def test_a_cell_that_never_fills_on_a_spike_minute_keeps_its_hour_charge(judge) -> None:
+    judge({"05:00": {"p50": 62.0}})
+    cell = _cell()
+    assert cell is not None, gauntlet.LAST_BUILD_FAILURE
+    assert cell["_cost_basis"] == "fill_hour_01_spread"
+    assert cell["_fill_minute"]["spike_share"] == 0.0
+    same = gauntlet.Costs.from_symbol(META[SYM], spread_pts=2.0)
+    assert cell["costs"].per_oz_roundtrip() == pytest.approx(same.per_oz_roundtrip())
+
+
+def test_a_spike_cheaper_than_the_hour_lowers_nothing(judge) -> None:
+    judge({"01:00": {"p50": 1.0}})
+    cell = _cell()
+    assert cell is not None and cell["_cost_basis"] == "fill_hour_01_spread"
diff --git a/desks/mt5/tests/test_gauntlet_refuses_duplicate_certs.py b/desks/mt5/tests/test_gauntlet_refuses_duplicate_certs.py
new file mode 100644
index 0000000000000000000000000000000000000000..ce982848941d74912c088d41ef2d493019c90b60
--- /dev/null
+++ b/desks/mt5/tests/test_gauntlet_refuses_duplicate_certs.py
@@ -0,0 +1,69 @@
+"""The judge refuses to mint a second certificate for an executable rule it already certified.
+
+BR1 (box 2026-11-11): `{"timeframe": "M30"}` and `{"input_symbol": "CHFNOK", "timeframe": "M30"}`
+are two cell hashes for one carry rule, and both held a certificate. A duplicate counts the same
+evidence twice in the survivor count, the allocator's breadth and the forward roster. These pin
+that the publishing loop asks `_duplicate_of` after the unrunnable refusal and before the row is
+stored, that the identity comes from `research.cert_duplicates.executable_identity`, and that
+the sweep reports what it refused.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+SRC = (Path(__file__).resolve().parents[1] / "scripts" / "external_gauntlet.py").read_text(
+    encoding="utf-8")
+
+
+def _at(needle: str, start: int = 0) -> int:
+    i = SRC.find(needle, start)
+    assert i >= 0, f"{needle!r} missing from external_gauntlet.py"
+    return i
+
+
+def test_duplicate_check_sits_between_the_unrunnable_refusal_and_the_store() -> None:
+    refusal = _at("_why = _certificate_refusal(row)")
+    dup = _at("_dup = _duplicate_of(key, row)", refusal)
+    store = _at("survivors_all[key] = row", dup)
+    assert refusal < dup < store
+    between = SRC[dup:store]
+    assert "REFUSED-DUPLICATE" in between and "continue" in between
+
+
+def test_identity_is_the_shared_reduction_not_a_local_copy() -> None:
+    assert "from research.cert_duplicates import executable_identity" in SRC
+
+
+def test_the_sweep_reports_its_refusals() -> None:
+    assert "CERT_DUPLICATES_REFUSED.json" in SRC
+
+
+def test_identity_reduction_names_the_br1_pair_as_one_rule() -> None:
+    import sys
+    desk = Path(__file__).resolve().parents[1]
+    for p in (str(desk), str(desk.parent.parent)):
+        if p not in sys.path:
+            sys.path.insert(0, p)
+    try:
+        from research.cert_duplicates import executable_identity
+    except ImportError:                       # lands with the cert_duplicates leg
+        import pytest
+        pytest.skip("research.cert_duplicates not on this tree yet")
+
+    def carry(symbol: str = "", lookback: int = 20) -> None:
+        return None
+
+    a = executable_identity("CHFNOK", "carry", {"timeframe": "M30"}, fn=carry)
+    b = executable_identity("CHFNOK", "carry", {"input_symbol": "CHFNOK", "timeframe": "M30"},
+                            fn=carry)
+    c = executable_identity("CHFNOK", "carry", {"timeframe": "M30", "session": "ny"}, fn=carry)
+    assert a == b != c
+
+
+def test_a_retired_or_voided_certificate_owns_no_identity() -> None:
+    owners = _at("def _owner_stands(row: dict) -> bool:")
+    loop = _at("for _k, _r in survivors_all.items():", owners)
+    body = SRC[owners:loop + 200]
+    for k in ("retired_at", "voided_at", "revoked_at", "RETIRED", "VOIDED", "REVOKED"):
+        assert k in body
+    assert "if not _owner_stands(_r):" in SRC[loop:loop + 200]
