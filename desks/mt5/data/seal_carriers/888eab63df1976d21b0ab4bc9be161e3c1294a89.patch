From 888eab63df1976d21b0ab4bc9be161e3c1294a89 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 17:17:43 +0000
Subject: [PATCH] replay2: a gapped-through stop fills at the open, as the
 engine now does

The independent replay paid the stop level on a bar that opened beyond
it -- the optimistic direction. It now exits at that bar's open (bars
after the entry bar), the same rule as engine.run_backtest after
claude/engine-gap-and-bank, so the two replays keep agreeing. Stricter
only; replay-shadow is not weakened.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TM3tMw4CNWqYHM8JZbUkSh

diff --git a/desks/mt5/tests/test_replay2_gap_through.py b/desks/mt5/tests/test_replay2_gap_through.py
new file mode 100644
index 0000000000000000000000000000000000000000..f69f134a5172d6fc4fc12d0df45d5435ff488166
--- /dev/null
+++ b/desks/mt5/tests/test_replay2_gap_through.py
@@ -0,0 +1,49 @@
+"""The independent replay fills a gapped-through stop at the open, as the engine does (2026-11-11).
+
+Paying the stop level on a bar that opened beyond it credits a loss the market never offered;
+both replays now take the open, so they keep agreeing and neither is the optimistic one.
+"""
+from __future__ import annotations
+
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+
+import pandas as pd
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT))
+
+from libs.validation import replay2  # noqa: E402
+
+
+@dataclass
+class _Sig:
+    time: pd.Timestamp
+    side: int
+    stop: float
+    target: float
+    ttl_bars: int = 10
+
+
+def _frame(rows: list[tuple[float, float, float, float]]) -> pd.DataFrame:
+    idx = pd.date_range("2026-01-05", periods=len(rows), freq="1h", tz="UTC")
+    return pd.DataFrame(rows, columns=["open", "high", "low", "close"], index=idx)
+
+
+def test_a_gapped_stop_fills_at_the_open_both_sides() -> None:
+    df = _frame([(100, 100, 100, 100), (100, 100.5, 99.5, 100), (97, 97.5, 96, 97),
+                 (97, 98, 96, 97)])
+    (t,) = replay2.replay(df, [_Sig(df.index[0], 1, 99.0, 102.0)])
+    assert t.exit == 97.0 and abs(t.r - (-3.0)) < 1e-9
+    up = _frame([(100, 100, 100, 100), (100, 100.5, 99.5, 100), (103, 104, 102.5, 103),
+                 (103, 104, 102, 103)])
+    (s,) = replay2.replay(up, [_Sig(up.index[0], -1, 101.0, 98.0)])
+    assert s.exit == 103.0 and abs(s.r - (-3.0)) < 1e-9
+
+
+def test_a_touch_without_a_gap_still_fills_at_the_stop() -> None:
+    df = _frame([(100, 100, 100, 100), (100, 100.5, 99.5, 100), (99.8, 100, 98.5, 99),
+                 (99, 99.5, 98, 99)])
+    (t,) = replay2.replay(df, [_Sig(df.index[0], 1, 99.0, 102.0)])
+    assert t.exit == 99.0
