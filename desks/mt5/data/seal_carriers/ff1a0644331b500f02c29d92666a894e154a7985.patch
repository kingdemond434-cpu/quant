+def measured_peak(equity: float, now: datetime, account: str, path: Path = PEAK_FILE,
+                  write: bool = True, reset_at: datetime | None = None,
+                  reset_why: str = "capital-flow event", equity_at: datetime | None = None
+                  ) -> tuple[float | None, str]:
+    """(peak, why): the high-water mark of MEASURED equity FOR THIS ACCOUNT, ratcheted on disk.
+
+    Never re-anchored lower. An unreadable or torn file, a non-object, a `peaks` that is not an
+    object, or this account's entry being non-finite, <= 0, a string, or stamped after the pass
+    is (None, UNMEASURED why) and NOTHING is written -- the last good peak stays on disk for a
+    human to inspect. A NULL entry is refused the same way. Only an ABSENT file or an absent entry
+    for this account seeds from equity.
+
+    Every write (seed, ratchet, re-anchor) stamps `at` (now) and `anchored_at` (when the run of
+    this peak began: the seed time, carried through ratchets, or the event). A present but
+    garbage or future `anchored_at` is UNMEASURED.
+
+    THE RESET PATH (the only way a peak goes down). `reset_at` is a STAMPED deposit/withdrawal
+    from account_state (see `reset_event`). It re-anchors ONLY when reset_at > max(anchored_at,
+    at) -- an event older than the peak's own measurement never lowers it -- AND the equity was
+    measured strictly after the event (`equity_at` > reset_at); otherwise a pre-event equity
+    would consume the event, so the pass is UNMEASURED and the event stays pending. On a
+    re-anchor the peak becomes current equity and the old one is kept as `previous_peak_eur`.
+    Each event re-anchors once."""
+    p = Path(path)
+    if p.exists():
+        try:
+            doc = json.loads(p.read_text("utf-8"), object_pairs_hook=_reject_dupes)
+        except (OSError, ValueError) as exc:
+            return None, f"UNMEASURED: {p.name} unreadable ({type(exc).__name__}); peak kept"
+        if not isinstance(doc, dict) or not isinstance(doc.get("peaks", {}), dict):
+            return None, f"UNMEASURED: {p.name} is not a keyed peak file; peak kept"
+    else:
+        doc = {}
+    peaks: dict[str, Any] = dict(doc.get("peaks") or {})
+    if account in peaks and peaks[account] is None:
+        return None, (f"UNMEASURED: peak entry for {account} is null; peak kept (a reset is "
+                      "a stamped capital flow in account_state, never a null row)")
+    row = peaks.get(account)
+    stored: float | None = None
+    if row is not None:
+        if not isinstance(row, dict):
+            return None, f"UNMEASURED: peak entry for {account} is not an object; peak kept"
+        stored = _strict(row.get("peak_eur"))
+        at = _ts(row.get("at"))
+        if stored is None or stored <= 0:
+            return None, f"UNMEASURED: peak for {account} non-finite, <= 0 or not a number"
+        if at is None or at > now:
+            return None, f"UNMEASURED: peak for {account} unstamped or stamped after the pass"
+    anchored: datetime | None = None
+    if isinstance(row, dict):
+        at_row = _ts(row.get("at"))
+        if "anchored_at" in row:
+            anchored = _ts(row.get("anchored_at")) if isinstance(row.get("anchored_at"),
+                                                                 str) else None
+            if anchored is None or anchored > now:
+                return None, f"UNMEASURED: anchored_at for {account} garbage or future; kept"
+        else:
+            anchored = at_row             # a pre-v4 row: anchored when it was last stamped
+    reanchor = None
+    if stored is not None and reset_at is not None and reset_at <= now:
+        last = max(t_ for t_ in (anchored, _ts(row.get("at")) if isinstance(row, dict) else None)
+                   if t_ is not None)
+        if reset_at > last:
+            if equity_at is None or not equity_at > reset_at:
+                return None, ("UNMEASURED: a capital flow at " + reset_at.isoformat()
+                              + " is pending an equity measured after it; peak kept")
+            reanchor = reset_at
+    if reanchor is not None:
+        peak = equity
+        peaks[account] = {"peak_eur": peak, "at": now.isoformat(),
+                          "anchored_at": reanchor.isoformat(), "previous_peak_eur": stored,
+                          "source": f"re-anchored on {reset_why}"}
+        try:
+            _write_atomic(p, {**doc, "peaks": peaks})
+        except OSError as exc:
+            return None, f"UNMEASURED: re-anchor write failed ({type(exc).__name__}); peak kept"
+        return peak, f"re-anchored to equity {equity} on {reset_why} (was {stored})"
+    peak = max(equity, stored) if stored is not None else equity
+    if write and (stored is None or peak > stored):
+        peaks[account] = {"peak_eur": peak, "at": now.isoformat(),
+                          "anchored_at": (anchored or now).isoformat(),
+                          "source": "account_state.json equity"}
+        try:
+            _write_atomic(p, {**doc, "peaks": peaks})
+        except OSError as exc:
+            return peak, f"peak {peak} (write failed, {type(exc).__name__}; ratchet not stored)"
+    return peak, ("seeded from equity" if stored is None else f"stored peak {stored}")
+
+
+def cushion_multiplier(equity: float, peak: float, *, floor_frac: float,
+                       floor_eur: float = FUSION_FLOOR_EUR) -> tuple[float, dict[str, Any]]:
+    """Grossman-Zhou: m = ((W - F) / W) / REF_CUSHION, clipped to [SHRINK, GROW]."""
+    floor = max(floor_eur, floor_frac * peak)
+    tol = 1.0 - floor_frac
+    ref_w = 1.0 - REF_DD * tol
+    ref = (ref_w - floor_frac) / ref_w
+    cushion = (equity - floor) / equity
+    m = float(min(GROW, max(SHRINK, cushion / ref))) if ref > 0 else 1.0
+    return m, {"equity": equity, "peak": peak, "floor_eur": round(floor, 4),
+               "floor_basis": "fusion_300" if floor == floor_eur else "frac_of_peak",
+               "cushion_eur": round(equity - floor, 4), "cushion_frac": round(cushion, 6),
+               "ref_cushion_frac": round(ref, 6), "raw_multiplier": round(cushion / ref, 6)
+               if ref > 0 else None}
+
+
+def cushion_apply(book: Mapping[str, float], bounds: Mapping[str, float], m: float, *,
+                  ceiling: float | None, share_cap: float | None,
+                  deploy_total: float | None = None,
+                  hold_at: Mapping[str, float] | None = None
+                  ) -> tuple[dict[str, float], dict[str, Any]]:
+    """Fill the book's total toward total * m, upward only and NEVER above what the gateway
+    deploys: target = min(total * m, ceiling, deploy_total) with deploy_total the resolved heat
+    the allocator publishes (decision_core scales anything above it back). Water-filled within
+    max(bound, held) and the share cap. A shrink is a counterfactual in its own field.
+    info["status"] is set for every outcome that is not a proposal."""
+    base = {k: float(v) for k, v in book.items() if _fin(v) is not None and float(v) > 0}
+    total = sum(base.values())
+    info: dict[str, Any] = {}
+    if total <= 0:
+        info["status"] = "EMPTY_BOOK"
+        return dict(base), info
+    if m < 1.0:
+        info["held_shrink_counterfactual"] = {s: round(h * m, 6) for s, h in base.items()}
+        info["held_by_heat_law"] = ("a cushion shrink would leave the book short of its "
+                                    "resolved heat; published, never applied, never billed")
+        info["status"] = "SHRINK_HELD_BY_HEAT_LAW"
+        return dict(base), info
+    if m <= 1.0:
+        info["status"] = "NOT_BINDING"
+        return dict(base), info
+    if ceiling is None or not math.isfinite(ceiling):
+        info["status"] = "HELD_NO_CEILING"
+        info["held"] = "no operative ceiling measured: no grow"
+        return dict(base), info
+    if deploy_total is None or not math.isfinite(deploy_total):
+        info["status"] = "HELD_NO_DEPLOY_TOTAL"
+        info["held"] = "no resolved heat total to bound the grow: no grow"
+        return dict(base), info
+    want = min(total * m, max(ceiling, total))
+    target = min(want, max(deploy_total, total))
+    info["undeployable_grow"] = round(max(0.0, want - target), 8)
+    if target <= total + EPS:
+        info["status"] = "UNDEPLOYABLE"
+        info["held"] = ("the book already sits at the resolved heat the gateway deploys; a "
+                        "larger total would be scaled back by decision_core.allocator_heat")
+        return dict(base), info
+    def fill(goal: float) -> dict[str, float]:
+        caps = {}
+        for s, h in base.items():
+            b_ = _fin(bounds.get(s))
+            c = max(b_ if b_ is not None else h, h)
+            if share_cap is not None:
+                c = min(c, max(share_cap * goal, h))
+            if hold_at and s in hold_at:
+                c = h        # a tilt shrank it: never topped back up past its tilted value
+            caps[s] = c
+        o = dict(base)
+        for _ in range(len(o) + 1):
+            need = goal - sum(o.values())
+            room = {s: caps[s] - o[s] for s in o if caps[s] - o[s] > EPS}
+            if need <= EPS or not room:
+                break
+            w_tot = sum(o[s] for s in room)
+            for s in room:
+                o[s] += min(room[s], need * o[s] / w_tot)
+        return o
+
+    # the share cap binds on the total ACTUALLY REACHED, not the target: when the fill falls
+    # short the caps are recomputed on what was reached until they agree (monotone, so this
+    # converges from above); a final pass at the reached total guarantees the cap holds
+    goal = target
+    out = fill(goal)
+    for _ in range(50):
+        reached = sum(out.values())
+        if reached >= goal - 1e-12:
+            break
+        goal = reached
+        out = fill(goal)
+    # FINAL CLAMP (audit v5 should-fix 2): the loop above can exit unconverged; no sleeve may
+    # end above share_cap * reached (or its held value, never cut below what it held). The
+    # clamped excess is simply not deployed -- it is reported in `unfilled`, never re-spread.
+    if share_cap is not None and 0.0 < share_cap < 1.0:
+        # solved exactly: with k sleeves pinned at c*R and the rest summing to U,
+        # R = U / (1 - k*c). A sleeve whose held value exceeds c*R keeps its held value.
+        pinned: set[str] = set()
+        for _ in range(len(out) + 1):
+            reached = sum(out.values())
+            new = {s for s in out if s not in pinned
+                   and out[s] > max(share_cap * reached, base[s]) + 1e-12}
+            if not new:
+                break
+            pinned |= new
+            for _j in range(len(out) + 1):
+                free = {s for s in pinned if base[s] < share_cap * reached}
+                for s in pinned - free:
+                    out[s] = base[s]
+                unp = sum(out[s] for s in out if s not in free)
+                if len(free) * share_cap >= 1.0:
+                    break
+                reached = unp / (1.0 - len(free) * share_cap)
+                for s in free:
+                    out[s] = share_cap * reached
+                if {s for s in pinned if base[s] < share_cap * reached} == free:
+                    break
+    if all(abs(out[s] - base[s]) <= 1e-9 for s in base):
+        info["status"] = "HELD_BY_CAPS"
+    info["target_total"] = round(target, 6)
+    info["unfilled"] = round(max(0.0, target - sum(out.values())), 8)
+    return out, info
+
+
+# ------------------------------------------------------------------ the allocator's step
+def _surface_at_book(worlds: Any, book: Mapping[str, float], alpha: float) -> Any:
+    from mt5desk.gateway_config_fallback import MAX_DRAWDOWN_TOLERANCE
+
+    from libs.portfolio.kelly_surface import surface
+    return surface(worlds, book, tolerance=MAX_DRAWDOWN_TOLERANCE, alpha=alpha,
+                   fractions=(1.0,)).get("at_book")
+
+
+def _judge(meta: dict[str, Any], base: dict[str, float], mod: dict[str, float], *,
+           score: Callable[[dict[str, float]], Mapping[str, Any]],
+           at_book: Callable[[dict[str, float]], Any], alpha: float,
+           bounds: Mapping[str, float], share_cap: float | None,
+           survival: Mapping[str, Any] | None, switch: Path) -> Mapping[str, Any] | None:
+    try:
+        sc, sc0 = score(mod), score(base)
+        gw, gwo = _fin(sc.get("mean_log_growth")), _fin(sc0.get("mean_log_growth"))
+    except Exception as exc:
+        sc, gw, gwo = {}, None, None
+        meta["score_error"] = f"{type(exc).__name__}: {exc}"
+    meta["growth_with"], meta["growth_without"] = gw, gwo
+    meta["delta_logw"] = None if gw is None or gwo is None else round(gw - gwo, 10)
+    meta["delta_basis"] = ("IN-SAMPLE on the allocator's own worlds: necessary, never "
+                           "sufficient -- only the switch arms")
+    breach: str | None
+    try:
+        from libs.portfolio.kelly_surface import MAX_MARGIN_USE
+        sv = survival if isinstance(survival, Mapping) else {}
+        mu = sv.get("margin_use") if isinstance(sv.get("margin_use"), Mapping) else {}
+        mc = sv.get("margin_clause") if isinstance(sv.get("margin_clause"), Mapping) else {}
+        # P13: the clause binds only where it is FED (armed AND measured), as in the decay tilt.
+        # Unfed is skipped: the envelope licensed this total under the same unfed clause.
+        armed = mc.get("armed") is not False
+        fed = armed and bool(mc.get("fed")) and mu.get("status") == "MEASURED"
+        breach = survival_breach(at_book(mod), alpha, book=mod, held=base, bounds=bounds,
+                                 share_cap=share_cap,
+                                 margin_by_heat=mu.get("by_heat") if fed else None,
+                                 max_margin_use=MAX_MARGIN_USE if fed else None,
+                                 margin_required=fed)
+        meta["margin_clause_checked"] = fed
+        meta["margin_clause_armed"] = armed
+    except Exception as exc:
+        breach = f"survival re-check failed ({type(exc).__name__}: {exc})"
+    meta["survival_breach"] = breach
+    go, meta["status"] = decide(meta, growth_with=gw, growth_without=gwo, breach=breach,
+                                switch=switch)
+    if not go:
+        return None
+    meta["applied"] = dict(meta["proposed"])
+    return sc
+
+
+def allocator_step(book: Any, funded: Mapping[str, float], bounds: Mapping[str, float], *,
+                   ev: Any = None, cfg: Any = None, worlds: Any = None,
+                   survival: Mapping[str, Any] | None = None, ceiling: float | None = None,
+                   now: datetime | None = None,
+                   score: Callable[[dict[str, float]], Mapping[str, Any]] | None = None,
+                   at_book: Callable[[dict[str, float]], Any] | None = None,
+                   series: Callable[[str], tuple[np.ndarray | None, str]] | None = None,
+                   equity: tuple[float | None, str] | None = None, peak_path: Path = PEAK_FILE,
+                   bocpd_switch: Path = BOCPD_SWITCH, cushion_switch: Path = CUSHION_SWITCH,
+                   share_cap: float | None = None, deploy_total: float | None = None,
+                   account: str | None = None, kelly: Mapping[str, float] | None = None,
+                   hold_at: Mapping[str, float] | None = None,
+                   reset: tuple[datetime | None, str] | None = None,
+                   equity_at: datetime | None = None
+                   ) -> tuple[Any, dict[str, float], dict[str, Any]]:
+    """BOCPD tilt, then the cushion, each proposed, judged and applied only when armed.
+    Returns (book, funded, meta). Never raises: a failure is UNMEASURED and changes nothing."""
+    t = now or datetime.now(tz=UTC)
+    meta: dict[str, Any] = {"bocpd_kelly": {"status": "NOT_RUN"},
+                            "dd_cushion": {"status": "NOT_RUN"}}
+    try:
+        if share_cap is None:
+            from mt5desk.gateway_config_fallback import MAX_SLEEVE_HEAT_SHARE
+            share_cap = float(MAX_SLEEVE_HEAT_SHARE)
+        alpha = float(getattr(cfg, "cvar_alpha", 0.05))
+        if score is None:
+            from libs.portfolio.robust_elog import score_book
+
+            def score(b: dict[str, float]) -> Mapping[str, Any]:
+                return score_book(ev, b, cfg=cfg, worlds=worlds)
+        if at_book is None:
+            def at_book(b: dict[str, float]) -> Any:
+                return _surface_at_book(worlds, b, alpha)
+        cur = {k: float(v) for k, v in funded.items() if float(v) > 0}
+        applied_sc: Mapping[str, Any] | None = None
+        kw = {"score": score, "at_book": at_book, "alpha": alpha, "bounds": bounds,
+              "share_cap": share_cap, "survival": survival}
+        # 1. BOCPD run-length Kelly, per sleeve, total conserved.
+        prop, bm = bocpd_apply(cur, bounds, now=t, series=series, kelly=kelly,
+                               share_cap=share_cap, hold_at=hold_at)
+        meta["bocpd_kelly"] = bm
+        if bm.get("proposed"):
+            sc = _judge(bm, cur, prop, switch=bocpd_switch, **kw)  # type: ignore[arg-type]
+            if sc is not None:
+                cur, applied_sc = prop, sc
+        # 2. Grossman-Zhou cushion on the book total.
+        eq, why = equity if equity is not None else read_equity(t)
+        cm: dict[str, Any] = {"modifier": "dd_cushion", "equity_why": why, "proposed": {},
+                              "applied": {}, "fusion_floor_eur": FUSION_FLOOR_EUR,
+                              "deploy_total": deploy_total, "ceiling": ceiling}
+        meta["dd_cushion"] = cm
+        acct, acct_why = (account, "given") if account else account_key_of()
+        cm["account"], cm["account_why"] = acct, acct_why
+        peak, peak_why = (None, "not read")
+        if eq is not None and acct:
+            r_at, r_why = reset_event(t) if reset is None else reset
+            cm["reset_why"] = r_why
+            e_at = equity_at if equity_at is not None else equity_stamp(now=t)
+            if r_why.startswith("UNMEASURED"):
+                peak, peak_why = None, r_why
+            else:
+                peak, peak_why = measured_peak(eq, t, acct, peak_path, reset_at=r_at,
+                                               reset_why=r_why, equity_at=e_at)
+        cm["peak_why"] = peak_why
+        if eq is None or not acct or peak is None:
+            cm.update(status="UNMEASURED", multiplier=1.0,
+                      why=why if eq is None else acct_why if not acct else peak_why)
+        else:
+            m, info = cushion_multiplier(eq, peak, floor_frac=floor_fraction())
+            # a sleeve the decay/cluster tilt SHRANK is held at its tilted value (never topped
+            # back up); after a BOCPD shrink the same holds for that sleeve
+            held = {k: v for k, v in (hold_at or {}).items() if k in cur}
+            if bm.get("applied"):
+                # only sleeves BOCPD itself SHRANK (multiplier < 1); a donor conservation drew
+                # from is not a verdict on that sleeve and stays free to refill
+                held.update({k: cur[k] for k, v in (bm.get("by_sleeve") or {}).items()
+                             if k in cur and isinstance(v, dict)
+                             and (_fin(v.get("multiplier")) or 1.0) < 1.0})
+            prop2, info2 = cushion_apply(cur, bounds, m, ceiling=ceiling, share_cap=share_cap,
+                                         deploy_total=deploy_total, hold_at=held)
+            cm.update(multiplier=round(m, 6), **info, **info2)
+            cm["proposed"] = {s: {"from": round(cur[s], 6), "to": round(prop2[s], 6)}
+                              for s in cur if abs(prop2[s] - cur[s]) > 1e-9}
+            if "held_shrink_counterfactual" in info2:
+                try:
+                    sh, s0 = score(info2["held_shrink_counterfactual"]), score(cur)
+                    a, b = _fin(sh.get("mean_log_growth")), _fin(s0.get("mean_log_growth"))
+                    cm["held_shrink_growth_with"], cm["held_shrink_growth_without"] = a, b
+                except Exception as exc:
+                    cm["score_error"] = f"{type(exc).__name__}: {exc}"
+            elif cm["proposed"]:
+                sc = _judge(cm, cur, prop2, switch=cushion_switch, **kw)  # type: ignore[arg-type]
+                if sc is not None:
+                    cur, applied_sc = prop2, sc
+        if applied_sc is None:
+            return book, dict(funded), meta
+        new_book = dataclasses.replace(
+            book, heat={k: v for k, v in cur.items() if v > 1e-6},
+            total_heat=float(sum(cur.values())),
+            robust_score=float(applied_sc["robust_score"]),
+            mean_log_growth=float(applied_sc["mean_log_growth"]),
+            cvar_log_growth=float(applied_sc["cvar_log_growth"]),
+            annual_growth_pct=float(applied_sc["annual_growth_pct"]),
+            prob_annual_loss=float(applied_sc["prob_annual_loss"]),
+            note=f"{book.note}; sizing modifiers applied".strip("; "))
+        return new_book, {k: round(v, 6) for k, v in cur.items() if v > 1e-5}, meta
+    except Exception as exc:
+        meta["error"] = f"{type(exc).__name__}: {exc}"
+        return book, dict(funded), meta
