+"""The Judge's cluster verdict (CLUSTER_JUDGE.json) as a two-sided tilt on the allocator's book."""
+from __future__ import annotations
+
+import json
+import sys
+from datetime import UTC, datetime, timedelta
+from pathlib import Path
+
+DESK = Path(__file__).resolve().parents[1]
+ROOT = DESK.parent.parent
+for _p in (str(DESK / "research"), str(DESK), str(ROOT)):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+from libs.portfolio.capital_modifiers import REGISTRY  # noqa: E402
+from libs.portfolio.rails import RAILS  # noqa: E402
+from research import decay_sizing as ds  # noqa: E402
+from research import missed_growth as mg  # noqa: E402
+
+NOW = datetime(2026, 10, 20, 12, 0, tzinfo=UTC)
+BOUNDS = dict.fromkeys("abcde", 0.10)
+
+
+def _row(flag: str, *, age: timedelta = timedelta(minutes=10), **kw) -> dict:
+    return {"concentration_flag": flag, "generated_utc": (NOW - age).isoformat(),
+            "ledger_status": "MEASURED", **kw}
+
+
+def _reader(rows: dict):
+    return lambda s: rows.get(s, {"concentration_flag": "UNMEASURED", "why": "no row"})
+
+
+def _total(b: dict) -> float:
+    return sum(b.values())
+
+
+def test_duplicate_streams_are_one_bet() -> None:
+    book = {"a": 0.04, "b": 0.03, "c": 0.04}
+    rows = {"a": _row("DUPLICATE_TRADES", duplicate_group="D001"),
+            "b": _row("DUPLICATE_TRADES", duplicate_group="D001")}
+    out, meta = ds.apply_cluster(book, BOUNDS, now=NOW, reader=_reader(rows))
+    assert out["b"] == 0.0 and abs(out["a"] - 0.07) < 1e-12        # sized once, at the pool
+    assert abs(_total(out) - _total(book)) < 1e-12
+    assert meta["duplicate_groups"]["D001"] == {"sized": "a", "zeroed": ["b"]}
+
+
+def test_duplicate_kept_within_its_bound_and_book_full() -> None:
+    book = {"a": 0.08, "b": 0.08, "c": 0.04}
+    rows = {"a": _row("DUPLICATE_TRADES", duplicate_group="D1"),
+            "b": _row("DUPLICATE_TRADES", duplicate_group="D1")}
+    out, meta = ds.apply_cluster(book, BOUNDS, now=NOW, reader=_reader(rows))
+    assert out["a"] <= 0.10 + 1e-12 and out["c"] <= 0.10 + 1e-12
+    assert abs(_total(out) - 0.20) < 1e-12 and meta["unfilled_heat"] == 0.0
+    # c carries 0.06 of the freed 0.06 to its bound; nothing needs to go back to b
+    assert out["b"] == 0.0 and abs(out["c"] - 0.10) < 1e-12
+    tight = {"a": 0.08, "b": 0.08, "c": 0.04}
+    out, meta = ds.apply_cluster(book, tight, now=NOW, reader=_reader(rows))
+    assert abs(_total(out) - 0.20) < 1e-12                           # never short ...
+    assert meta.get("last_resort_returned", 0) > 0                   # ... and it says so
+
+
+def _pairs(*rows: tuple[str, str, float]) -> dict:
+    return {frozenset((a, b)): {"status": "MEASURED", "rho": r, "significant_pos": r > 0.3}
+            for a, b, r in rows}
+
+
+def _member(flag: str = "MODERATE", **kw) -> dict:
+    return _row(flag, measured_pairs=4, unmeasured_pairs=0, **kw)
+
+
+def test_concentrated_shrinks_only_on_a_measured_pair_with_a_funded_partner() -> None:
+    book = {"a": 0.05, "b": 0.03, "c": 0.04, "d": 0.04}
+    rows = {"a": _row("CONCENTRATED", max_pair_corr=0.9, cluster_id="C001"),
+            "b": _row("CONCENTRATED", max_pair_corr=0.9, cluster_id="C001"),
+            "c": _row("CONCENTRATED", max_pair_corr=0.8, cluster_id="C002")}
+    out, meta = ds.apply_cluster(book, BOUNDS, now=NOW, reader=_reader(rows),
+                                 pairs=_pairs(("a", "b", 0.9), ("c", "X_unfunded", 0.8)))
+    assert out["a"] >= 0.05 and out["b"] < 0.03                     # the measured pair a-b
+    assert meta["by_sleeve"]["b"]["concentrated_with"] == "a"
+    assert out["c"] >= 0.04                                         # its partner is not funded
+    assert abs(_total(out) - _total(book)) < 1e-12
+
+
+def test_probe_cluster_membership_alone_never_shrinks() -> None:
+    # s0, s1 share cluster C1 (single linkage) but each is concentrated only with UNFUNDED clocks
+    book = {"s0": 0.05, "s1": 0.03, "s2": 0.04}
+    rows = {"s0": _row("CONCENTRATED", max_pair_corr=0.9, cluster_id="C1"),
+            "s1": _row("CONCENTRATED", max_pair_corr=0.9, cluster_id="C1")}
+    out, _ = ds.apply_cluster(book, BOUNDS, now=NOW, reader=_reader(rows),
+                              pairs=_pairs(("s0", "u0", 0.9), ("s1", "u1", 0.9),
+                                           ("s0", "s1", 0.2)))
+    assert out == book
+    # and an unmeasured pair (status not MEASURED) never shrinks either
+    pr = {frozenset(("s0", "s1")): {"status": "UNMEASURED", "rho": 0.95}}
+    out, _ = ds.apply_cluster(book, BOUNDS, now=NOW, reader=_reader(rows), pairs=pr)
+    assert out == book
+
+
+def test_independent_grows_only_when_every_funded_pair_is_measured_and_below_bar() -> None:
+    book = {"a": 0.06, "b": 0.001}
+    good = {"a": _member("INDEPENDENT", max_pair_corr=0.1), "b": _member()}
+    out, _ = ds.apply_cluster(book, {"a": 0.08, "b": 0.08}, now=NOW, reader=_reader(good),
+                              pairs=_pairs(("a", "b", 0.1)))
+    assert out["a"] <= 0.08 + 1e-12 and out["a"] > 0.06
+    assert out["b"] >= 0.0005 - 1e-15
+    assert abs(_total(out) - _total(book)) < 1e-12
+
+
