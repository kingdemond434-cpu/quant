+#: account_state fields that stamp a capital flow (deposit / withdrawal); the latest wins.
+#: These are the ONLY re-anchor source. (A principal-written reset file was tried in v3 and
+#: removed: a writable state file that can lower the floor names no principal and travels with
+#: the release like any other state, and nothing writes it today.)
+FLOW_FIELDS = ("last_capital_flow_at", "last_deposit_at", "last_withdrawal_at")
+
+
+def equity_stamp(path: Path = ACCOUNT, now: datetime | None = None) -> datetime | None:
+    """When the equity in account_state.json was measured (its updated_at), or None. A stamp
+    after `now` (look-ahead) is None, never a measurement (audit v4/v5 should-fix 3)."""
+    doc = _read(Path(path))
+    at = _ts(doc.get("updated_at")) if isinstance(doc, dict) else None
+    t = now or datetime.now(tz=UTC)
+    return None if at is None or at > t else at
+
+
+def reset_event(now: datetime, acct_path: Path = ACCOUNT) -> tuple[datetime | None, str]:
+    """The latest STAMPED capital flow at or before `now` from account_state.json (FLOW_FIELDS),
+    or (None, why). A flow field that is PRESENT but torn, unparseable, not a string or stamped
+    after the pass makes the whole read UNMEASURED (why starts "UNMEASURED") -- a malformed
+    stamp is neither an event nor the absence of one."""
+    p = Path(acct_path)
+    if not p.exists():
+        return None, "no account_state to read capital flows from"
+    try:
+        # duplicate keys are refused, as every other state read here (audit should-fix 3)
+        doc = json.loads(p.read_text("utf-8"), object_pairs_hook=_reject_dupes)
+    except (OSError, ValueError) as exc:
+        return None, f"UNMEASURED: account_state torn or unreadable ({type(exc).__name__})"
+    if not isinstance(doc, dict):
+        return None, "UNMEASURED: account_state is not an object"
+    best: tuple[datetime, str] | None = None
+    for f in FLOW_FIELDS:
+        if f not in doc or doc[f] is None:
+            continue
+        v = doc[f]
+        t = _ts(v) if isinstance(v, str) else None
+        if t is None:
+            return None, f"UNMEASURED: account_state.{f} is malformed ({v!r})"
+        if t > now:
+            return None, f"UNMEASURED: account_state.{f} stamped after the pass"
+        if best is None or t > best[0]:
+            best = (t, f"account_state.{f}")
+    return (best[0], best[1]) if best else (None, "no stamped capital flow")
+
