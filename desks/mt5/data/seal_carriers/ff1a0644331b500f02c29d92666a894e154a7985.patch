+# ------------------------------------------------------------------ the allocator's step
+@dataclass(frozen=True)
+class _Book:
+    heat: dict
+    total_heat: float
+    robust_score: float = 0.0
+    mean_log_growth: float = 0.0
+    cvar_log_growth: float = 0.0
+    annual_growth_pct: float = 0.0
+    prob_annual_loss: float = 0.0
+    note: str = ""
+
+
+def _score(b: dict) -> dict:
+    g = sum(b.values())            # a fake world where more heat is more growth
+    return {"mean_log_growth": g, "robust_score": g, "cvar_log_growth": g,
+            "annual_growth_pct": g, "prob_annual_loss": 0.0}
+
+
+FED = {"margin_clause": {"armed": True, "fed": True},
+       "margin_use": {"status": "MEASURED", "by_heat": {0.2: 0.1}}}
+
+
+def _step(tmp_path: Path, equity: float, *, arm: bool, deploy_total: float = 0.25,
+          survival: dict | None = FED, reset: tuple | None = (None, "no stamped capital flow"),
+          hold_at: dict | None = None):
+    bs, cs = tmp_path / "B.json", tmp_path / "C.json"
+    if arm:
+        bs.write_text('{"enabled": true}', "utf-8")
+        cs.write_text('{"enabled": true}', "utf-8")
+    peak = tmp_path / "peak.json"
+    peak.write_text(json.dumps({"peaks": {"1@S": {
+        "peak_eur": 1000.0, "at": (NOW - timedelta(days=2)).isoformat()}}}), "utf-8")
+    return sm.allocator_step(
+        _Book(heat=dict(BOOK), total_heat=0.2), dict(BOOK), BOUNDS, ceiling=0.27, now=NOW,
+        score=_score, at_book=lambda b: SURV_OK, series=_series({"a": _stable()}),
+        equity=(equity, "test"), peak_path=peak, bocpd_switch=bs, cushion_switch=cs,
+        share_cap=0.25, deploy_total=deploy_total, account="1@S", survival=survival,
+        reset=reset, equity_at=NOW, hold_at=hold_at)
+
