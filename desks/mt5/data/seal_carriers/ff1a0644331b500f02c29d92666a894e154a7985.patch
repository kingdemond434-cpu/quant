+# ------------------------------------------------------------------ shared helpers
+def _fin(v: Any) -> float | None:
+    if isinstance(v, bool):
+        return None
+    try:
+        x = float(v)
+    except (TypeError, ValueError):
+        return None
+    return x if math.isfinite(x) else None
+
+
+def _strict(v: Any) -> float | None:
+    if isinstance(v, bool) or not isinstance(v, (int, float)):
+        return None
+    return float(v) if math.isfinite(v) else None
+
+
+def _ts(v: Any) -> datetime | None:
+    if not v:
+        return None
+    try:
+        t = datetime.fromisoformat(str(v).replace("Z", "+00:00"))
+    except (TypeError, ValueError):
+        return None
+    return t if t.tzinfo else t.replace(tzinfo=UTC)
+
+
+def _reject_dupes(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    keys = [k for k, _ in pairs]
+    if len(keys) != len(set(keys)):
+        raise ValueError(f"duplicate key(s): {sorted({k for k in keys if keys.count(k) > 1})}")
+    return dict(pairs)
+
+
+def switch_state(path: Path) -> tuple[bool, str]:
+    """(armed, why). Only a file that is EXACTLY {"enabled": true} arms; everything else --
+    absent, unreadable, duplicate keys, extra keys, "true", 1 -- is REPORT-ONLY."""
+    p = Path(path)
+    try:
+        doc = json.loads(p.read_text("utf-8"), object_pairs_hook=_reject_dupes)
+    except FileNotFoundError:
+        return False, f"REPORT_ONLY: {p.name} absent (no forward evidence armed it)"
+    except (OSError, ValueError) as exc:
+        return False, f"REPORT_ONLY: {p.name} unreadable ({type(exc).__name__}: {exc})"
+    if isinstance(doc, dict) and list(doc) == ["enabled"] and doc["enabled"] is True:
+        return True, f"ARMED by {p.name}"
+    return False, f'REPORT_ONLY: {p.name} is not exactly {{"enabled": true}}'
+
+
+def survival_breach(at_book: Mapping[str, Any] | None, alpha: float, *,
+                    book: Mapping[str, float], held: Mapping[str, float],
+                    bounds: Mapping[str, float], share_cap: float | None,
+                    margin_by_heat: Mapping[Any, Any] | None = None,
+                    max_margin_use: float | None = None,
+                    margin_required: bool = False) -> str | None:
+    """Why the modified book breaches the survival clauses, or None. Re-checks the book (p_ruin,
+    P(DD > tol)), each sleeve's bound and the share cap (each allowed up to what it already
+    held, never more), and margin use when the clause is FED (`margin_required`): a fed clause
+    with no finite slope is a breach; an unfed one is skipped, as the decay tilt skips it."""
+    if not isinstance(at_book, Mapping):
+        return "survival surface unmeasured for the modified book"
+    p_ruin, p_dd = _strict(at_book.get("p_ruin")), _strict(at_book.get("p_dd_over_tolerance"))
+    if p_ruin is None or p_dd is None:
+        return "survival surface row non-finite or not a number"
+    if p_ruin > 0.0:
+        return f"p_ruin {p_ruin:.4f} > 0 on the sampled worlds"
+    if p_dd > alpha:
+        return f"P(DD > tolerance) {p_dd:.4f} > alpha {alpha}"
+    total = sum(float(v) for v in book.values())
+    for s, h in book.items():
+        h0 = float(held.get(s, 0.0))
+        b_ = _strict(bounds.get(s))
+        if b_ is not None and h > max(b_, h0) + 1e-9:
+            return f"{s} at {h:.6f} exceeds its per-sleeve bound {b_:.6f}"
+        if share_cap is not None and total > 0 and h > max(share_cap * total, h0) + 1e-9:
+            return f"{s} carries {h / total:.1%} of the book > share cap {share_cap:.0%}"
+    if margin_required and (not margin_by_heat or max_margin_use is None):
+        return "margin clause armed but unmeasured this pass"
+    if margin_by_heat and max_margin_use is not None:
+        slopes = []
+        for k, v in margin_by_heat.items():
+            hk, u = _fin(k), _strict(v)
+            if hk and hk > 0 and u is not None:
+                slopes.append(u / hk)
+        if margin_required and not slopes:
+            return "margin clause armed but no finite margin slope measured"
+        if slopes and max(slopes) * total > max_margin_use:
+            return f"margin use {max(slopes) * total:.3f} > max {max_margin_use}"
+    return None
+
+
+def decide(meta: Mapping[str, Any], *, growth_with: float | None, growth_without: float | None,
+           breach: str | None, switch: Path) -> tuple[bool, str]:
+    """(apply?, status). ARMED switch AND dE[log W] > 0 AND no breach. The in-sample delta is
+    checked first and can only REFUSE; it can never arm."""
+    if not meta.get("proposed"):
+        return False, str(meta.get("status") or "NOT_BINDING")
+    if growth_with is None or growth_without is None or not (
+            math.isfinite(growth_with) and math.isfinite(growth_without)):
+        return False, "NOT_APPLIED: growth pair non-finite"
+    if not growth_with - growth_without > 0.0:
+        return False, (f"NOT_APPLIED: dE[log W] {growth_with - growth_without:+.3e} <= 0 "
+                       "(Rule 1: a change that does not raise E[log W] is not applied)")
+    if breach:
+        return False, f"NOT_APPLIED: modified book breaches the survival envelope ({breach})"
+    armed, why = switch_state(switch)
+    if not armed:
+        return False, why
+    return True, "APPLIED"
