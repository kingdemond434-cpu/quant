+def test_future_rows_never_move_the_past_run_length(tmp_path: Path):
+    """CAUSALITY, end to end on the sizing path: appending ledger rows stamped after the pass
+    (a crash, then a boom) leaves the run-length posterior and the multiplier the pass reads
+    bit-identical; the same rows stamped BEFORE the pass do move it (so the test can fail)."""
+    start = NOW - timedelta(days=10)
+    (tmp_path / "shadow_state.json").write_text(json.dumps({
+        "EURUSD.london": {"n": 30, "forward_start": start.isoformat()}}), "utf-8")
+    past = [{"entry_time": (start + timedelta(hours=i + 1)).isoformat(), "r_multiple": float(v)}
+            for i, v in enumerate(_stable(40))]
+    shock = [-6.0] * 5 + [6.0] * 5
+
+    def judged(rows: list[dict]) -> tuple[np.ndarray, dict]:
+        _write_ledger(tmp_path, "EURUSD.london", rows)
+        idx = sm.ledger_index(tmp_path, tmp_path / "none.json")
+        r, _ = sm.forward_returns("EURUSD.london", NOW, shadow_dir=tmp_path, index=idx)
+        assert r is not None
+        _, meta = sm.bocpd_apply({"EURUSD.london": 0.05, "b": 0.05}, BOUNDS, now=NOW,
+                                 series=lambda s: (r, "t") if s == "EURUSD.london" else
+                                 (None, "UNMEASURED"))
+        return bocpd_run_length(r), meta["by_sleeve"]["EURUSD.london"]
+
+    p0, m0 = judged(past)
+    fut = [{"entry_time": (NOW + timedelta(hours=i + 1)).isoformat(), "r_multiple": v}
+           for i, v in enumerate(shock)]
+    p1, m1 = judged(past + fut)
+    assert np.array_equal(p0, p1) and m0 == m1
+    inside = [{"entry_time": (NOW - timedelta(minutes=20 - i)).isoformat(), "r_multiple": v}
+              for i, v in enumerate(shock)]
+    p2, _ = judged(past + inside)
+    assert p2.size != p0.size
