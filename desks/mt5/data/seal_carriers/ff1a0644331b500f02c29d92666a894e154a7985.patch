+def read_equity(now: datetime, path: Path = ACCOUNT) -> tuple[float | None, str]:
+    doc = _read(Path(path))
+    if not isinstance(doc, dict):
+        return None, f"UNMEASURED: {Path(path).name} absent or unreadable"
+    eq = _strict(doc.get("equity"))
+    at = _ts(doc.get("updated_at"))
+    if eq is None or eq <= 0:
+        return None, "UNMEASURED: equity missing, non-finite or <= 0"
+    if at is None:
+        return None, "UNMEASURED: account_state carries no readable updated_at"
+    if at > now:
+        return None, f"UNMEASURED: account_state stamped {at.isoformat()} after the pass"
+    if now - at > ACCOUNT_FRESH_FOR:
+        return None, f"UNMEASURED: account_state stale ({now - at})"
+    return eq, f"equity {eq} EUR at {at.isoformat()}"
