+def test_probe_b_truncated_pairs_top_is_unmeasured_not_a_free_zero(tmp_path: Path) -> None:
+    # funded S-P at 0.78, significant, both CONCENTRATED; fourteen unfunded clocks at 0.95 fill
+    # the top 50, so the S-P pair is measured but not published
+    book = {"S": 0.05, "P": 0.04, "z": 0.03}
+    rows = {k: _row("CONCENTRATED", max_pair_corr=0.95, cluster_id="C1") for k in ("S", "P")}
+    top: dict = {}
+    for i in range(14):
+        for j in range(i + 1, 14):
+            if len(top) < 50:
+                top[frozenset((f"u{i}", f"u{j}"))] = {"status": "MEASURED", "rho": 0.95,
+                                                      "significant_pos": True}
+    summ = {"truncated": True, "published": len(top), "measured": 140, "rho_floor": 0.95}
+    out, meta = ds.apply_cluster(book, BOUNDS, now=NOW, reader=_reader(rows), pairs=top,
+                                 pairs_summary=summ)
+    assert out == book
+    st = meta["by_sleeve"]["P"]["status"]
+    assert st.startswith("UNMEASURED") and "not published" in st and "50 of 140" in st
+    r = mg.MEASURES["measure_cluster_judge"](None, {"cluster_judge_tilt": meta}, {})
+    assert r["verdict"] == mg.UNMEASURED and not r.get("sample")
+    # the same artifact read from disk carries the truncation through the default loader
+    doc = {"generated_utc": NOW.isoformat(),
+           "pairs_summary": {"pairs_measured": 140, "top_k": 50},
+           "pairs_top": {" || ".join(sorted(k)): v for k, v in top.items()}}
+    f = tmp_path / "CLUSTER_JUDGE.json"
+    f.write_text(json.dumps(doc), "utf-8")
+    sm = ds.cluster_pairs_summary(f)
+    assert sm["truncated"] is True and sm["published"] == 50 and sm["rho_floor"] == 0.95
+    # control: the pair published -> the smaller-held member shrinks
+    top2 = {**top, frozenset(("S", "P")): {"status": "MEASURED", "rho": 0.78,
+                                           "significant_pos": True}}
+    out, _ = ds.apply_cluster(book, BOUNDS, now=NOW, reader=_reader(rows), pairs=top2,
+                              pairs_summary=summ)
+    assert out["P"] < 0.04 and abs(_total(out) - _total(book)) < 1e-12
