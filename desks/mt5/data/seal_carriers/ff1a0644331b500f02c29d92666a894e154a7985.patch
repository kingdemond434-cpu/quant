+    f.write_text(json.dumps(_judge_doc(desc, 10, top_k=3)), "utf-8")
+    assert ds.cluster_pairs_summary(f)["rho_floor"] == 0.2
+    # ascending (adversarial) order: no floor, so U1' cannot grow on it
+    asc = dict(reversed(list(desc.items())))
+    f.write_text(json.dumps(_judge_doc(asc, 10, top_k=3)), "utf-8")
+    sm = ds.cluster_pairs_summary(f)
+    assert sm["rho_floor"] is None and "non-increasing" in sm["rho_floor_why"]
+    # len != top_k, top_k missing, a non-finite rho: no floor
+    for doc in (_judge_doc(desc, 10, top_k=5), _judge_doc(desc, 10, top_k=None)):
+        f.write_text(json.dumps(doc), "utf-8")
+        assert ds.cluster_pairs_summary(f)["rho_floor"] is None
+    nan = {**desc, frozenset(("c", "d")): p | {"rho": float("nan")}}
+    f.write_text(json.dumps(_judge_doc(nan, 10, top_k=4)), "utf-8")
