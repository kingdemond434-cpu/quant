+def test_peak_reanchors_once_on_a_stamped_capital_flow(tmp_path: Path):
+    p = tmp_path / "peak.json"
+    t0 = NOW - timedelta(days=3)
+    sm.measured_peak(600.0, t0, "1@S", p)
+    row = json.loads(p.read_text("utf-8"))["peaks"]["1@S"]
+    assert row["anchored_at"] == t0.isoformat() and row["at"] == t0.isoformat()
+    flow = NOW - timedelta(hours=2)
+    peak, why = sm.measured_peak(400.0, NOW, "1@S", p, reset_at=flow, reset_why="withdrawal",
+                                 equity_at=NOW - timedelta(hours=1))
+    assert peak == 400.0 and "re-anchored" in why
+    row = json.loads(p.read_text("utf-8"))["peaks"]["1@S"]
+    assert row["previous_peak_eur"] == 600.0 and row["anchored_at"] == flow.isoformat()
+    # the same event never re-anchors twice; a later higher equity still ratchets
+    e_at = NOW - timedelta(minutes=5)
+    assert sm.measured_peak(350.0, NOW, "1@S", p, reset_at=flow, equity_at=e_at)[0] == 400.0
+    assert sm.measured_peak(450.0, NOW, "1@S", p, reset_at=flow, equity_at=e_at)[0] == 450.0
+    assert sm.measured_peak(300.0, NOW, "1@S", p, reset_at=flow, equity_at=e_at)[0] == 450.0
+    assert sm.measured_peak(100.0, NOW, "1@S", p, reset_at=NOW + timedelta(hours=1),
+                            equity_at=e_at)[0] == 450.0
