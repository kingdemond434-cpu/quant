+def _measure_tilt(alloc: dict, block: str) -> dict[str, Any]:
+    """A Judge's two-sided tilt (`block` = decay_verdict_tilt or cluster_judge_tilt): the tilted
+    book against the untilted one, same worlds, same total heat.
+
+    BILLED WHETHER OR NOT IT WAS APPLIED. `pf_allocator` PROPOSES the tilt every pass and applies
+    it only when its OWN switch arms it -- `data/DECAY_TILT_APPLY.json` for the decay tilt,
+    `data/CLUSTER_TILT_APPLY.json` for the cluster tilt -- and dE[log W] > 0; the default is
+    REPORT-ONLY. So the sample is the PROPOSED tilt's growth pair -- that is the evidence that
+    decides whether it is ever armed, and it accrues while the tilt sizes nothing. No sleeve
+    proposed is a real zero; a pass that did not run the tilt, or proposed one without a growth
+    pair, is UNMEASURED -- never a free zero.
+    """
+    if not alloc:
+        return {"verdict": UNMEASURED, "why": "no allocator pass on this host"}
+    dt = alloc.get(block) or {}
+    if not dt or str(dt.get("status")) in ("NOT_RUN", "UNMEASURED"):
+        return {"verdict": UNMEASURED,
+                "why": (f"pf_allocation.json carries no run {block} block; needs "
+                        ".growth_with/.growth_without and .proposed {sleeve: {from, to}}"),
+                "status": dt.get("status")}
+    proposed = dt.get("proposed") or dt.get("applied") or {}
+    if not proposed and _num(dt.get("n_judged")) is None:
+        # A block that does not say how many sleeves it judged cannot prove a zero (audit v3).
+        return {"verdict": UNMEASURED, "why": f"{block} carries no n_judged: a zero is unprovable"}
+    if not proposed and dt.get("unmeasured_binding"):
+        # a sleeve the tilt WOULD have moved had its pair been readable (a truncated pairs_top,
+        # a grow blocked on an unshown pair): the pass measured nothing it can bill as zero
+        ub = dt["unmeasured_binding"]
+        return {"verdict": UNMEASURED, "n_unmeasured_binding": len(ub),
+                "why": f"{block}: {len(ub)} sleeve(s) unmeasured where it could bind: "
+                       f"{sorted(ub)[:5]}"}
+    if not proposed and (dt.get("all_unmeasured") or (
+            _num(dt.get("n_judged")) and dt.get("n_unmeasured") == dt.get("n_judged"))):
+        # Every judged sleeve was UNMEASURED (absent artifact, reader error, all stale): no
+        # verdict reached the tilt, so nothing was measured -- never a free zero (L1.28a).
+        return {"verdict": UNMEASURED, "n_unmeasured": dt.get("n_unmeasured"),
+                "n_judged": dt.get("n_judged"),
+                "why": f"every judged sleeve's verdict was UNMEASURED this pass ({block})"}
+    if not proposed:
+        return {"verdict": NOT_BINDING, "value_logw_per_day": 0.0, "sample": True,
+                "n_unmeasured": dt.get("n_unmeasured"),
+                "why": "no sleeve carried a fresh, measured verdict that moved it"}
+    with_, without = _num(dt.get("growth_with")), _num(dt.get("growth_without"))
+    if with_ is None or without is None:
+        return {"verdict": UNMEASURED, "n_tilted": len(proposed),
+                "why": f"{block} proposed a tilt but carries no growth pair"}
+    return {"verdict": "SAMPLE", "value_logw_per_day": round(with_ - without, 8), "sample": True,
+            "n_tilted": len(proposed), "applied": bool(dt.get("applied")),
+            "status": dt.get("status"),
+            "why": "growth of the tilted book minus the untilted one, same worlds, same heat"}
+
+
+def measure_decay_verdict(r, alloc: dict, _fv: dict) -> dict[str, Any]:
+    """Rail `decay_verdict`: the Judge's decay tilt (see `_measure_tilt`)."""
+    return _measure_tilt(alloc, "decay_verdict_tilt")
+
+
+def measure_cluster_judge(r, alloc: dict, _fv: dict) -> dict[str, Any]:
+    """Rail `cluster_judge`: the Judge's cluster tilt -- duplicate streams one bet, concentrated
+    sleeves shrunk, independent ones grown -- billed exactly as the decay tilt is."""
+    return _measure_tilt(alloc, "cluster_judge_tilt")
+def _sizing_modifier(alloc: dict, name: str) -> dict[str, Any]:
+    """Bill one of research/sizing_modifiers' modifiers from pf_allocation.json.
+
+    An UNMEASURED input never reads as a measured zero (L1.28a), and a malformed block is
+    UNMEASURED for THIS rail only -- it never raises into `run()`. The only measured zero is a
+    status of exactly NOT_BINDING (input measured, no change wanted). Everything that held a
+    change for another reason -- a BOCPD tilt conservation HANDED_BACK, an EMPTY_BOOK, a hold for
+    want of a ceiling or a deploy total, a grow that was UNDEPLOYABLE above the resolved heat, a
+    proposal refused for a survival breach -- is UNMEASURED with its status. The dd_cushion's
+    held shrink is a counterfactual and is published in its own field
+    (`held_shrink_counterfactual`), never as the rail's value."""
+    if not isinstance(alloc, dict) or not alloc:
+        return {"verdict": UNMEASURED, "why": "no allocator pass on this host"}
+    block = alloc.get("sizing_modifiers")
+    if block is not None and not isinstance(block, dict):
+        return {"verdict": UNMEASURED,
+                "why": f"sizing_modifiers is a {type(block).__name__}, not an object"}
+    m = (block or {}).get(name)
+    if m is not None and not isinstance(m, dict):
+        return {"verdict": UNMEASURED,
+                "why": f"sizing_modifiers.{name} is a {type(m).__name__}, not an object"}
+    m = m or {}
+    status = str(m.get("status") or "")
+    if not m or status in ("NOT_RUN", "UNMEASURED") or m.get("all_unmeasured"):
+        return {"verdict": UNMEASURED, "status": status or None,
+                "why": f"sizing_modifiers.{name} carries no measured input this pass "
+                       f"({m.get('equity_why') or m.get('why') or status or 'absent'})"}
+    out: dict[str, Any] = {}
+    if status == "SHRINK_HELD_BY_HEAT_LAW":
+        a, b = _num(m.get("held_shrink_growth_with")), _num(m.get("held_shrink_growth_without"))
+        out["held_shrink_counterfactual"] = {
+            "value_logw_per_day": None if a is None or b is None else round(a - b, 8),
+            "why": "counterfactual shrunk book minus the held book, same worlds; never applied"}
+        return {"verdict": UNMEASURED, "status": status, **out,
+                "why": "the cushion's shrink is held by the heat law: nothing was proposed for "
+                       "deployment, so the rail bills no line (counterfactual published apart)"}
+    if "undeployable_grow" in m:
+        out["undeployable_grow"] = m.get("undeployable_grow")
+    proposed = m.get("proposed")
