+def test_cushion_never_refills_a_sleeve_a_tilt_shrank():
+    # share_cap 0.30 leaves room to grow b, c, d around the held a. (At 0.25 on four equal
+    # sleeves no grow is consistent with the cap on the reached total: the v4 fill used to land
