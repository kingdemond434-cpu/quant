+def ledger_index(shadow_dir: Path = SHADOW_DIR, sleeves: Path = SLEEVES
+                 ) -> dict[str, dict[str, Any]]:
+    """ledger file name -> {"keys": clock keys writing it, "forward_start": the LATEST start any
+    of them declares (the conservative one) or None}."""
+    idx: dict[str, dict[str, Any]] = {}
+
+    def add(key: str, fs: Any) -> None:
+        row = idx.setdefault(_ledger_name(key), {"keys": set(), "forward_start": None})
+        row["keys"].add(str(key))
+        t = _ts(fs)
+        if t is not None and (row["forward_start"] is None or t > row["forward_start"]):
+            row["forward_start"] = t
+
+    for name in STATE_FILES:
+        doc = _read(Path(shadow_dir) / name)
+        for k, v in (doc.items() if isinstance(doc, dict) else ()):
+            if isinstance(v, dict) and ("n" in v or "forward_start" in v or "status" in v):
+                add(k, v.get("forward_start") or v.get("enrolled_at"))
+    doc = _read(Path(sleeves))
+    rows = doc.get("sleeves") if isinstance(doc, dict) else doc
+    for r in rows if isinstance(rows, list) else []:
+        if isinstance(r, dict) and r.get("name"):
+            add(str(r["name"]), r.get("forward_start") or r.get("enrolled_at"))
+    return idx
+
+
+def forward_returns(sleeve: str, now: datetime, *, shadow_dir: Path = SHADOW_DIR,
+                    index: Mapping[str, Mapping[str, Any]] | None = None
+                    ) -> tuple[np.ndarray | None, str]:
+    """(forward R series in time order, why) or (None, the UNMEASURED reason)."""
+    idx = index if index is not None else ledger_index(shadow_dir)
+    name = _ledger_name(sleeve)
+    row = idx.get(name) or {"keys": {sleeve}, "forward_start": None}
+    # ONE LEDGER PER CLOCK KEY (libs.research.forward_ledger): the clock's OWN file is its series
+    # even when siblings share its legacy name; a frozen shared legacy file never is.
+    from libs.research import forward_ledger as fl
+    # Every legacy name the index holds under more than one key counts as frozen even before the
+    # box writes its registry, so a base key never reads its cell's mixed file as its own.
+    held = {n: {"members": sorted(r.get("keys") or ())} for n, r in idx.items()
+            if len(r.get("keys") or ()) > 1}
+    own, status, _why = fl.resolve(str(sleeve), [Path(shadow_dir)], held)
+    if status == fl.UNMEASURED_SHARED_LEDGER:
+        return None, f"UNMEASURED_SHARED_LEDGER: {name} is shared by several clock keys"
+    if own is None and len(row.get("keys") or ()) > 1:
+        return None, (f"UNMEASURED_SHARED_LEDGER: {name} is written by "
+                      f"{len(row['keys'])} clock keys")
+    fs = row.get("forward_start")
+    if fs is None:
+        return None, "UNMEASURED: no forward_start for this clock (look-ahead not excludable)"
+    raw = _read(own if own is not None else Path(shadow_dir) / name)
+    if not isinstance(raw, list):
+        return None, f"UNMEASURED: {name} absent or unreadable"
+    out: list[tuple[datetime, float]] = []
+    for t in raw:
+        if not isinstance(t, dict) or str(t.get("phase") or "") == "historical":
+            continue
+        when = _ts(t.get("entry_time") or t.get("opened_at"))
+        r = _fin(t.get("r_multiple"))
+        if r is None:
+            r = _fin(t.get("r"))
+        if when is None or r is None or not (fs < when <= now):
+            continue
+        out.append((when, r))
+    if len(out) < MIN_TRADES:
+        return None, f"UNMEASURED: {len(out)} forward trade(s) after forward_start < {MIN_TRADES}"
+    out.sort(key=lambda x: x[0])
+    return np.asarray([r for _, r in out], dtype=float), f"{len(out)} forward trades"
+
+
+def bocpd_multiplier(r: np.ndarray) -> tuple[float, dict[str, Any]]:
+    """Two-sided multiplier from the run-length posterior of `r` (len >= MIN_TRADES)."""
+    from libs.research.adapters.kats import bocpd_run_length
+    post = bocpd_run_length(r, hazard_lambda=HAZARD_LAMBDA)
+    rl = np.arange(post.size, dtype=float)
+    p_reset = float(post[:RESET_RL].sum())
+    e_rl = float((rl * post).sum())
+    map_rl = int(post.argmax())
+    seg = r[-map_rl:] if map_rl > 0 else r[-1:]
+    seg_mean = float(seg.mean())
+    stab = min(1.0, e_rl / STABLE_RL)
+    m = (1.0 - (1.0 - SHRINK) * p_reset
+         + (GROW - 1.0) * stab * (1.0 - p_reset) * (1.0 if seg_mean > 0 else 0.0))
+    m = float(min(GROW, max(SHRINK, m)))
+    return m, {"p_reset": round(p_reset, 6), "e_run_length": round(e_rl, 3),
+               "map_run_length": map_rl, "segment_mean_r": round(seg_mean, 6), "n": int(r.size)}
+
+
+def conserve(base: Mapping[str, float], out: dict[str, float],
+             bounds: Mapping[str, float], *, hold: Mapping[str, float] | None = None,
+             share_cap: float | None = None) -> tuple[dict[str, float], float]:
+    """Re-balance a per-sleeve tilt to the base total: grows draw from untilted sleeves (never
+    below SHRINK of what they held, else the grows are scaled back); shrinks refill untilted
+    sleeves up to max(bound, held) -- and never above the share cap of the total (unless they
+    already held more) nor above a tilt-held value in `hold` -- and what they cannot carry goes
+    back to the shrunk, again never above its held value."""
+    hold = hold or {}
+    total = sum(base.values())
+    shrunk = {s for s in base if out[s] < base[s] - EPS}
+    grown = {s for s in base if out[s] > base[s] + EPS}
+    free = [s for s in base if s not in shrunk and s not in grown]
+    delta = total - sum(out.values())
+    if delta < -EPS:
+        need = -delta
+        f_tot = sum(out[s] for s in free)
+        take = min(need, f_tot * (1.0 - SHRINK))
+        if take > 0:
+            for s in free:
+                out[s] -= take * out[s] / f_tot
+        short = need - take
+        if short > EPS:
+            g = {s: out[s] - base[s] for s in grown}
+            g_tot = sum(g.values())
+            for s in grown:
+                out[s] -= short * g[s] / g_tot
+        delta = total - sum(out.values())
+    back = 0.0
+    if delta > EPS:
+        room = {}
+        for s in free:
+            b_ = _fin(bounds.get(s))
+            c = max(b_ if b_ is not None else out[s], base[s])
+            if share_cap is not None:
+                c = min(c, max(share_cap * total, base[s]))
+            if s in hold:
+                c = min(c, hold[s])
+            room[s] = max(0.0, c - out[s])
+        r_tot = sum(room.values())
+        if r_tot > 0:
+            put = min(delta, r_tot)
+            for s in free:
+                out[s] += put * room[s] / r_tot
+            delta -= put
+        if delta > EPS:
+            give = {s: max(0.0, min(base[s], hold.get(s, base[s])) - out[s]) for s in shrunk}
+            g_tot = sum(give.values())
+            back = min(delta, g_tot)
+            if g_tot > 0:
+                for s in shrunk:
+                    out[s] += back * give[s] / g_tot
+    return out, back
+
+
+def bocpd_apply(book: Mapping[str, float], bounds: Mapping[str, float], *, now: datetime,
+                kelly: Mapping[str, float] | None = None,
+                series: Callable[[str], tuple[np.ndarray | None, str]] | None = None,
+                share_cap: float | None = None, hold_at: Mapping[str, float] | None = None
+                ) -> tuple[dict[str, float], dict[str, Any]]:
+    """PROPOSE the BOCPD-tilted book (total conserved). Never raises."""
+    base = {k: float(v) for k, v in book.items() if _fin(v) is not None and float(v) > 0}
+    book_total = sum(base.values())
+    hold = {k: float(v) for k, v in (hold_at or {}).items() if _fin(v) is not None}
+    meta: dict[str, Any] = {"modifier": "bocpd_kelly", "shrink": SHRINK, "grow": GROW,
+                            "min_trades": MIN_TRADES, "reset_rl": RESET_RL,
+                            "stable_rl": STABLE_RL, "hazard_lambda": HAZARD_LAMBDA,
+                            "by_sleeve": {}, "proposed": {}, "applied": {}}
+    try:
+        if series is None:
+            idx = ledger_index()
+
+            def series(s: str) -> tuple[np.ndarray | None, str]:
+                return forward_returns(s, now, index=idx)
+        out = dict(base)
+        for s, h in base.items():
+            try:
+                r, why = series(s)
+            except Exception as exc:
+                r, why = None, f"UNMEASURED: {type(exc).__name__}: {exc}"
+            if r is None or r.size < MIN_TRADES:
+                meta["by_sleeve"][s] = {"status": why if r is None else
+                                        f"UNMEASURED: n={r.size} < {MIN_TRADES}",
+                                        "multiplier": 1.0}
+                continue
+            m, info = bocpd_multiplier(r)
+            meta["by_sleeve"][s] = {"status": "MEASURED", "multiplier": round(m, 6), **info}
+            if m < 1.0:
+                out[s] = h * m
+            elif m > 1.0:
+                # the 0.25 share cap of the CONSERVED total, applied here so a grow is never
+                # refused later at survival_breach (and billed UNMEASURED) for crossing it
+                caps = [c for c in (_fin(bounds.get(s)), _fin((kelly or {}).get(s)),
+                                    None if share_cap is None else share_cap * book_total,
+                        _fin(hold.get(s)))
+                        if c is not None]
+                cap = max(h, min(caps)) if caps else h
+                if s in hold:
+                    cap = min(cap, max(0.0, hold[s]))    # a tilt-held sleeve never grows past it
+                out[s] = max(h, min(h * m, cap))
+                meta["by_sleeve"][s]["cap"] = cap
+        out, back = conserve(base, out, bounds, hold=hold, share_cap=share_cap)
+        meta["returned_to_shrunk"] = round(back, 8)
+        meta["proposed"] = {s: {"from": round(base[s], 6), "to": round(out[s], 6)}
+                            for s in base if abs(out[s] - base[s]) > 1e-9}
+        meta["total_before"] = round(sum(base.values()), 6)
+        meta["total_after"] = round(sum(out.values()), 6)
+        meta["n_judged"] = len(meta["by_sleeve"])
+        meta["n_unmeasured"] = sum(1 for v in meta["by_sleeve"].values()
+                                   if str(v["status"]).startswith("UNMEASURED"))
+        meta["all_unmeasured"] = bool(meta["n_judged"]) and meta["n_unmeasured"] == meta[
+            "n_judged"]
+        tilted = any(v.get("multiplier", 1.0) != 1.0 for v in meta["by_sleeve"].values())
+        meta["status"] = "PROPOSED" if meta["proposed"] else (
+            "UNMEASURED" if meta["all_unmeasured"] or not meta["by_sleeve"] else
+            # a tilt conservation handed straight back could not move heat: that is not a
+            # measured "no change", so it is billed UNMEASURED, never 0.0
+            "HANDED_BACK" if tilted else "NOT_BINDING")
+        return out, meta
+    except Exception as exc:
+        meta.update(status="UNMEASURED", why=f"{type(exc).__name__}: {exc}", proposed={})
+        return dict(base), meta
+
