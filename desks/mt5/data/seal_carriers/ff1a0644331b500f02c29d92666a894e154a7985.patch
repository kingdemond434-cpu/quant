@@ -0,0 +1,692 @@
+"""The Judge's decay verdict as a TWO-SIDED sizing input to the allocator's book.
+
+`decay_verdicts.py` writes reports/DECAY_VERDICTS.json hourly and exposes `decay_input(sleeve)`;
+this is its reader. Its SIZING_HOOK is WIRED to `pf_allocator.run` through here.
+
+THE RULE, per funded sleeve, applied to the solved book's heat fraction h:
+
+    DECAYING       h -> h * SHRINK                       (0.5x)
+    STRENGTHENING  h -> min(h * GROW, cap)              (up to 1.5x), cap = the tighter of the
+                   survival-derived per-sleeve bound the allocator already solved under and the
+                   max-E[log W] (Kelly) per-sleeve heat when one is supplied. Never above either,
+                   and never pulls a sleeve already past its cap DOWN (a grow can only grow).
+    anything else  h unchanged
+
+NO CHANGE, NAMED, for: every UNMEASURED_* verdict -- including 9dd343f69's per-key
+UNMEASURED_SHARED_LEDGER, so a ledger several clocks write sizes NOTHING, neither down nor up --
+fewer than MIN_TRADES realised trades, an artifact that is absent, malformed, older than
+FRESH_FOR, or stamped after the pass (look-ahead), and any non-finite heat, bound or count.
+
+THE BOOK IS NEVER LEFT SHORT (heat law). The total the heat law resolved is the total returned:
+  * heat freed by a shrink goes to the untilted funded sleeves, each only up to
+    max(its bound, what it already held) -- never past it, so no sleeve is pushed beyond its
+    drawdown/concentration bound. Whatever they cannot carry goes BACK pro rata to the shrunk
+    sleeves, so the shrink is partial and the book stays full. (Every sleeve DECAYING: it all
+    goes back, and the book is unchanged -- a uniform shrink is not a tilt.)
+  * heat a grow takes is drawn pro rata from the untilted sleeves, never cutting one below
+    SHRINK of what it held (an untilted sleeve is never cut harder than a DECAYING one, and is
+    never zeroed); what cannot be drawn is given back by scaling the grows down.
+
+IN-SAMPLE dE[log W] CAN NEVER ARM THE TILT. The growth pair is scored on the allocator's own
+worlds, so a positive delta is necessary but never evidence of forward growth: `decide` also
+requires the switch, and arming the switch is the principal's act on forward evidence.
+
+RULE 1 AND THE SWITCH. `apply` only PROPOSES. `decide` arms the proposal only when (a) the
+switch file `data/DECAY_TILT_APPLY.json` reads {"enabled": true} -- absent or anything else is
+REPORT-ONLY, because no forward evidence yet says this tilt raises robust forward E[log W] --
+(b) the tilted book's E[log W] minus the untilted one's, same worlds, is strictly positive, and
+(c) the tilted book passes the survival envelope's own clauses. The shrink and the grow are
+behind the same switch. The proposal and its growth pair are published every pass either way,
+so `missed_growth.measure_decay_verdict` (rail `decay_verdict`) accrues the evidence.
+"""
+from __future__ import annotations
+
+import json
+import math
+from collections.abc import Mapping
+from datetime import UTC, datetime, timedelta
+from pathlib import Path
+from typing import Any
+
+SHRINK = 0.5
+GROW = 1.5
+#: The verdict leg runs hourly; two hours tolerates one missed leg and nothing older.
+FRESH_FOR = timedelta(hours=2)
+MIN_TRADES = 20
+DECAYING, STRENGTHENING = "DECAYING", "STRENGTHENING"
+EPS = 1e-12
+#: Absent means REPORT-ONLY. {"enabled": true} arms the tilt (both sides), the
+#: ALLOCATOR_SOVEREIGN.json convention.
+SWITCH = Path(__file__).resolve().parents[1] / "data" / "DECAY_TILT_APPLY.json"
+#: The cluster tilt's OWN switch, same exact-match rule. Arming the decay tilt on ITS forward
+#: evidence never arms the cluster tilt (audit of v4, must-fix 3).
+CLUSTER_SWITCH = Path(__file__).resolve().parents[1] / "data" / "CLUSTER_TILT_APPLY.json"
+
+
+def _fin(v: Any) -> float | None:
+    try:
+        x = float(v)
+    except (TypeError, ValueError):
+        return None
+    return x if math.isfinite(x) else None
+
+
+def _ts(v: Any) -> datetime | None:
+    try:
+        t = datetime.fromisoformat(str(v).replace("Z", "+00:00"))
+    except (TypeError, ValueError):
+        return None
+    return t if t.tzinfo else t.replace(tzinfo=UTC)
+
+
+def multiplier(row: Mapping[str, Any] | None, now: datetime) -> tuple[float, str]:
+    """(multiplier, status) for one `decay_input` row at pass time `now`. Never raises."""
+    if not isinstance(row, Mapping):
+        return 1.0, "UNMEASURED: malformed row"
+    v = str(row.get("verdict") or "")
+    if v.startswith("UNMEASURED"):
+        return 1.0, f"{v}: {row.get('why') or ''}".rstrip(": ")
+    if str(row.get("basis") or "") == "shared_legacy":
+        return 1.0, "UNMEASURED_SHARED_LEDGER: basis shared_legacy"
+    gen = _ts(row.get("generated_utc"))
+    if gen is None:
+        return 1.0, "UNMEASURED: artifact carries no readable generated_utc"
+    if gen > now:
+        return 1.0, f"UNMEASURED: artifact stamped {gen.isoformat()} after the pass (look-ahead)"
+    if now - gen > FRESH_FOR:
+        return 1.0, f"UNMEASURED: stale ({now - gen} old > {FRESH_FOR})"
+    n = _fin(row.get("n"))
+    if n is None or n < MIN_TRADES:
+        return 1.0, f"UNMEASURED: n={row.get('n')!r} < {MIN_TRADES}"
+    if v == DECAYING or row.get("demote_input") is True:
+        return SHRINK, DECAYING
+    if v == STRENGTHENING or row.get("strengthen_input") is True:
+        return GROW, STRENGTHENING
+    return 1.0, v or "UNMEASURED: no verdict"
+
+
+def _reader(path: Path | None) -> Any:
+    from research.decay_verdicts import decay_input
+    return lambda s: decay_input(s, path)
+
+
+def switch_state(path: Path | None = None) -> tuple[bool, str]:
+    """(armed, why). Absent, unreadable or anything but {"enabled": true} is REPORT-ONLY."""
+    p = Path(path or SWITCH)
+    try:
+        doc = json.loads(p.read_text("utf-8"), object_pairs_hook=_reject_dupes)
+    except FileNotFoundError:
+        return False, f"REPORT_ONLY: {p.name} absent (no forward evidence armed it)"
+    except (OSError, ValueError) as exc:
+        return False, f"REPORT_ONLY: {p.name} unreadable ({type(exc).__name__})"
+    if isinstance(doc, dict) and list(doc) == ["enabled"] and doc["enabled"] is True:
+        return True, f"ARMED by {p.name}"
+    return False, f'REPORT_ONLY: {p.name} is not exactly {{"enabled": true}}'
+
+
+def _reject_dupes(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    keys = [k for k, _ in pairs]
+    if len(keys) != len(set(keys)):
+        dupes = sorted({k for k in keys if keys.count(k) > 1})
+        raise ValueError(f"duplicate key(s) in switch: {dupes}")
+    return dict(pairs)
+
+
+def _conserve(base: dict[str, float], out: dict[str, float], shrunk: set[str],
+              grown: set[str], bounds: Mapping[str, float],
+              meta: dict[str, Any], *,
+              return_last: frozenset[str] = frozenset()) -> dict[str, float]:
+    """Hold the total at the base total: grows draw from the untilted (never below SHRINK of
+    what each held), freed heat refills the untilted only up to max(bound, held), and what they
+    cannot carry goes back to the shrunk sleeves. Shared by every tilt in this module."""
+    total = sum(base.values())
+    free = [s for s in base if s not in shrunk and s not in grown]
+    delta = total - sum(out.values())        # >0 freed by shrinks, <0 taken by grows
+    if delta < -EPS:                         # grows took heat: draw it from the untilted
+        need = -delta
+        f_tot = sum(out[s] for s in free)
+        take = min(need, f_tot * (1.0 - SHRINK))   # never below SHRINK of what it held
+        if take > 0:
+            for s in free:
+                drawn = take * out[s] / f_tot
+                out[s] -= drawn
+                row = meta.get("by_sleeve", {}).get(s)
+                if (drawn > 1e-12 and isinstance(row, dict)
+                        and str(row.get("status", "")).startswith("UNMEASURED")):
+                    # an UNMEASURED sleeve is not sized ON its verdict, but it does FUND the
+                    # others' grows; say so (audit v5, should-fix 5)
+                    row["status"] += f" (drawn {drawn:.6f} to fund other sleeves' grows)"
+                    row["funded_grows"] = round(drawn, 8)
+        short = need - take
+        if short > EPS:                      # what cannot be drawn: scale the grows back
+            g = {s: out[s] - base[s] for s in grown}
+            g_tot = sum(g.values())
+            for s in grown:
+                out[s] -= short * g[s] / g_tot
+        delta = total - sum(out.values())
+    if delta > EPS:                          # shrinks freed heat: refill up to the bounds
+        if free:
+            room = {}
+            for s in free:
+                b_ = _fin(bounds.get(s))
+                lim = max(b_ if b_ is not None else out[s], base[s])
+                room[s] = max(0.0, lim - out[s])
+            r_tot = sum(room.values())
+            if r_tot > 0:
+                put = min(delta, r_tot)
+                for s in free:
+                    out[s] += put * room[s] / r_tot
+                delta -= put
+        if delta > EPS:                      # the rest goes BACK: the shrink is partial
+            back_tot = 0.0
+            for tier in (sorted(shrunk - return_last), sorted(shrunk & return_last)):
+                give = {s: base[s] - out[s] for s in tier}
+                g_tot = sum(give.values())
+                if delta <= EPS or g_tot <= 0:
+                    continue
+                back = min(delta, g_tot)
+                for s in tier:
+                    out[s] += back * give[s] / g_tot
+                delta -= back
+                back_tot += back
+                if tier and set(tier) <= return_last:
+                    meta["last_resort_returned"] = round(back, 8)
+            meta["returned_to_shrunk"] = round(back_tot, 8)
+    meta["proposed"] = {s: {"from": round(base[s], 6), "to": round(out[s], 6)}
+                        for s in base if abs(out[s] - base[s]) > 1e-9}
+    meta["total_before"] = round(total, 6)
+    meta["total_after"] = round(sum(out.values()), 6)
+    meta["spilled_past_bounds"] = 0.0
+    meta["unfilled_heat"] = round(max(delta, 0.0), 8)
+    meta["n_judged"] = len(meta["by_sleeve"])
+    meta["n_unmeasured"] = sum(1 for r in meta["by_sleeve"].values()
+                               if str(r["status"]).startswith("UNMEASURED"))
+    meta["all_unmeasured"] = bool(meta["n_judged"]) and (
+        meta["n_unmeasured"] == meta["n_judged"])
+    return out
+
+
+def apply(book: Mapping[str, float], bounds: Mapping[str, float], *,
+          now: datetime | None = None, kelly: Mapping[str, float] | None = None,
+          path: Path | None = None, reader: Any = None) -> tuple[dict[str, float], dict[str, Any]]:
+    """PROPOSE the tilted book. Returns (proposed book, meta). Never raises; on any error the
+    book comes back unchanged with the error named. The total is conserved exactly."""
+    t = now or datetime.now(tz=UTC)
+    base = {k: float(v) for k, v in book.items() if _fin(v) is not None and float(v) > 0}
+    meta: dict[str, Any] = {"mode": "decay_verdict_tilt", "shrink": SHRINK, "grow": GROW,
+                            "fresh_for_h": FRESH_FOR.total_seconds() / 3600,
+                            "min_trades": MIN_TRADES, "by_sleeve": {}, "proposed": {},
+                            "applied": {}, "kelly_cap": "supplied" if kelly else "not supplied"}
+    try:
+        read = reader or _reader(path)
+        out = dict(base)
+        shrunk: set[str] = set()
+        grown: set[str] = set()
+        for s, h in base.items():
+            try:
+                row = read(s)
+            except Exception as exc:          # a reader failure is UNMEASURED, never a size
+                row = {"verdict": "UNMEASURED", "why": f"{type(exc).__name__}: {exc}"}
+            m, status = multiplier(row, t)
+            meta["by_sleeve"][s] = {"status": status, "multiplier": m}
+            if m < 1.0:
+                out[s] = h * m
+            elif m > 1.0:
+                caps = [c for c in (_fin(bounds.get(s)), _fin((kelly or {}).get(s)))
+                        if c is not None]
+                cap = min(caps) if caps else h   # no measured cap -> no grow
+                out[s] = max(h, min(h * m, cap))
+                meta["by_sleeve"][s]["cap"] = cap
+            if out[s] < h:
+                shrunk.add(s)
+            elif out[s] > h:
+                grown.add(s)
+        out = _conserve(base, out, shrunk, grown, bounds, meta)
+        meta["status"] = "PROPOSED" if meta["proposed"] else "NOT_BINDING"
+        return out, meta
+    except Exception as exc:
+        meta.update(status="UNMEASURED", why=f"{type(exc).__name__}: {exc}", proposed={})
+        return dict(book), meta
+
+
+def _strict(v: Any) -> float | None:
+    """A finite real number, and never a bool or a string ("0" is not a measurement)."""
+    if isinstance(v, bool) or not isinstance(v, (int, float)):
+        return None
+    return float(v) if math.isfinite(v) else None
+
+
+def survival_breach(at_book: Mapping[str, Any] | None, alpha: float, *,
+                    book: Mapping[str, float] | None = None,
+                    untilted: Mapping[str, float] | None = None,
+                    bounds: Mapping[str, float] | None = None,
+                    share_cap: float | None = None,
+                    margin_by_heat: Mapping[Any, Any] | None = None,
+                    max_margin_use: float | None = None,
+                    report: dict[str, Any] | None = None) -> str | None:
+    """Why the tilted book breaches the envelope's clauses, or None when it passes. Checks the
+    book (p_ruin, P(DD > tol)) AND each sleeve: its drawdown-derived bound and the concentration
+    share (each allowed up to what the untilted book already held, never more), and the margin
+    clause when it is measured. An unreadable row is a breach: a missing measurement is never a
+    licence."""
+    if not isinstance(at_book, Mapping):
+        return "survival surface unmeasured for the tilted book"
+    p_ruin = _strict(at_book.get("p_ruin"))
+    p_dd = _strict(at_book.get("p_dd_over_tolerance"))
+    if p_ruin is None or p_dd is None:
+        return "survival surface row non-finite or not a number"
+    if p_ruin > 0.0:
+        return f"p_ruin {p_ruin:.4f} > 0 on the sampled worlds"
+    if p_dd > alpha:
+        return f"P(DD > tolerance) {p_dd:.4f} > alpha {alpha}"
+    if book:
+        held = dict(untilted or {})
+        total = sum(float(v) for v in book.values())
+        for s, h in book.items():
+            h0 = float(held.get(s, 0.0))
+            b_ = _strict((bounds or {}).get(s))
+            if b_ is not None and h > max(b_, h0) + 1e-9:
+                return f"{s} at {h:.6f} exceeds its per-sleeve bound {b_:.6f}"
+            if share_cap is not None and total > 0:
+                cap_h = max(share_cap * total, h0)
+                if h > cap_h + 1e-9:
+                    return f"{s} carries {h / total:.1%} of the book > share cap {share_cap:.0%}"
+    rep_ = report if report is not None else {}
+    rep_["margin_checked"] = False
+    if max_margin_use is not None and book:
+        # FED: the clause binds. A fed clause with no finite slope is a refusal, never a pass --
+        # an unreadable margin measurement is not permission (audit of v3, should-fix 1).
+        pts = [(_strict(_num_key(k)), _strict(v)) for k, v in (margin_by_heat or {}).items()]
+        slopes = [u / h for h, u in pts if h is not None and u is not None and h > 0]
+        slopes = [x for x in slopes if math.isfinite(x)]
+        if not slopes:
+            return "margin clause fed but no finite margin slope: UNMEASURED, not applied"
+        rep_["margin_checked"] = True
+        # Linear in TOTAL heat (the only form the clause is measured in), so on a heat-conserving
+        # tilt it binds only when the book was already at the line; named, not hidden.
+        rep_["margin_basis"] = "linear in total heat; composition changes are not resolved"
+        use = max(slopes) * sum(float(v) for v in book.values())
+        if use > max_margin_use:
+            return f"margin use {use:.3f} > max {max_margin_use}"
+    return None
+
+
+def _num_key(k: Any) -> Any:
+    try:
+        return float(k)
+    except (TypeError, ValueError):
+        return None
+
+
+def decide(meta: Mapping[str, Any], *, growth_with: float | None,
+           growth_without: float | None, breach: str | None,
+           switch: Path | None = None) -> tuple[bool, str]:
+    """(apply?, status) for a proposed tilt. Applies only when ARMED, dE[log W] > 0 strictly,
+    and the tilted book survives. Every refusal is named; the proposal stays published."""
+    if not meta.get("proposed"):
+        return False, str(meta.get("status") or "NOT_BINDING")
+    if growth_with is None or growth_without is None or not (
+            math.isfinite(growth_with) and math.isfinite(growth_without)):
+        return False, "NOT_APPLIED: growth pair non-finite"
+    if not growth_with - growth_without > 0.0:
+        return False, (f"NOT_APPLIED: dE[log W] {growth_with - growth_without:+.3e} <= 0 "
+                       "(Rule 1: a tilt that does not raise E[log W] is not applied)")
+    if breach:
+        return False, f"NOT_APPLIED: tilted book breaches the survival envelope ({breach})"
+    # The positive in-sample delta above is NECESSARY, never sufficient: the tilt arms only on
+    # the switch, which is the principal's act on forward evidence.
+    if switch is None:
+        # every tilt names its own switch; an unknown mode fails CLOSED (audit v5, should-fix 1)
+        by_mode = {"cluster_judge_tilt": CLUSTER_SWITCH, "decay_verdict_tilt": SWITCH}
+        switch = by_mode.get(str(meta.get("mode")))
+        if switch is None:
+            return False, f"NOT_APPLIED: unknown tilt mode {meta.get('mode')!r} has no switch"
+    armed, why = switch_state(switch)
+    if not armed:
+        return False, why
+    return True, "APPLIED"
+
+
+# ------------------------------------------------------------------ the cluster judge, two-sided
+#
+# reports/CLUSTER_JUDGE.json (desks/mt5/research/cluster_judge.py, hourly) publishes a per-clock
+# `promotion_input` row: concentration_flag (INDEPENDENT / MODERATE / CONCENTRATED /
+# DUPLICATE_TRADES / UNMEASURED), max_pair_corr, cluster_id, duplicate_group(_size),
+# independent_bets and ledger_status. Read through `cluster_judge.promotion_input`, the organ's
+# own reader, so the census counts this module as its consumer; until that organ is in the tree
+# every row is UNMEASURED by name and the book is untouched.
+#
+# THE RULE, its OWN switch (data/CLUSTER_TILT_APPLY.json, same exact-match rule), the same
+# conservation and the same survival re-check as the decay tilt:
+#   DUPLICATE_TRADES  one bet: the largest-held member of the group carries the group's heat (up
+#                     to max(its bound, what it held)); every other member goes to 0.
+#   CONCENTRATED      a MEASURED, significant pair (pairs_top) at or above CONCENTRATED_RHO with
+#                     an already-sized FUNDED sleeve (largest-held first): SHRINK. Cluster
+#                     membership and a max over unfunded clocks never shrink anything. A pair
+#                     with a sized funded sleeve that is NOT published is UNMEASURED (it goes to
+#                     unmeasured_binding) whether or not pairs_top is complete -- pairs_top
+#                     publishes measured pairs only -- except on a truncated list whose verified
+#                     rho_floor is below CONCENTRATED_RHO, where the omitted pair is shown weaker.
+#   INDEPENDENT       no unmeasured pairs on the row, every OTHER funded sleeve is a judged
+#                     member, and this sleeve's pair with each is SHOWN below INDEPENDENT_RHO
+#                     (published with a measured rho under the bar, or omitted from a truncated
+#                     list whose verified rho_floor is under it): GROW up to its bound. The
+#                     sleeve's max_pair_corr over unfunded clocks never blocks a grow. Anything
+#                     less is UNMEASURED and nothing moves.
+#   otherwise         unchanged; UNMEASURED (absent, stale, future, shared ledger) never sizes.
+#: The bar a funded pair must sit BELOW for a grow, on the measured rho itself: the judge's
+#: INDEPENDENT means "no significant pair" over Tier-S members only, and a non-significant
+#: rho_hat of 0.5 still reads INDEPENDENT there, so the flag alone never grows a sleeve.
+INDEPENDENT_RHO = 0.3
+#: A measured, significant pair at or above this with a FUNDED partner is the same bet.
+CONCENTRATED_RHO = 0.7
+CLUSTER_SHRINK = SHRINK
+CLUSTER_GROW = GROW
+CLUSTER_JUDGE = Path(__file__).resolve().parents[1] / "reports" / "CLUSTER_JUDGE.json"
+FLAG_INDEPENDENT, FLAG_CONCENTRATED, FLAG_DUPLICATE = (
+    "INDEPENDENT", "CONCENTRATED", "DUPLICATE_TRADES")
+
+
+def _cluster_reader(path: Path | None) -> Any:
+    try:
+        from research.cluster_judge import promotion_input
+    except ImportError:
+        why = "research/cluster_judge.py is not in this tree (CLUSTER_JUDGE.json unread)"
+        return lambda _s: {"concentration_flag": "UNMEASURED", "why": why}
+    return lambda s: promotion_input(s, path or CLUSTER_JUDGE)
+
+
+def read_cluster_doc(path: Path | None = None) -> dict[str, Any] | None:
+    """CLUSTER_JUDGE.json parsed ONCE (audit v6, should-fix 3): the pairs and their summary are
+    both derived from this one document, so a replace between two reads can never pair the
+    summary of one doc with the pairs of another. None when absent or unreadable."""
+    try:
+        doc = json.loads(Path(path or CLUSTER_JUDGE).read_text("utf-8"))
+    except Exception:
+        return None
+    return doc if isinstance(doc, dict) else None
+
+
+def cluster_pairs(path: Path | None = None, *, doc: Mapping[str, Any] | None = None
+                  ) -> dict[frozenset[str], dict[str, Any]]:
+    """The judge's published measured pairs (`pairs_top`, "a || b" -> pair), keyed by the pair.
+    Absent or unreadable is an empty map: every pair is then UNMEASURED, never a zero rho."""
+    try:
+        if doc is None:
+            doc = read_cluster_doc(path)
+        if doc is None:
+            return {}
+        out: dict[frozenset[str], dict[str, Any]] = {}
+        for k, v in (doc.get("pairs_top") or {}).items():
+            a, _, b = str(k).partition(" || ")
+            if a and b and isinstance(v, dict):
+                out[frozenset((a, b))] = v
+        return out
+    except Exception:
+        return {}
+
+
+def cluster_pairs_summary(path: Path | None = None,
+                          pairs: Mapping[frozenset[str], Mapping[str, Any]] | None = None,
+                          *, doc: Mapping[str, Any] | None = None) -> dict[str, Any]:
+    """Whether `pairs_top` is the WHOLE measured set or the judge's top-k by |rho|.
+
+    truncated  pairs_summary.pairs_measured > len(pairs_top): a pair missing from the list may
+               have been measured and simply not published -- UNMEASURED, never "no pair".
+    rho_floor  the smallest |rho| published when truncated: every unpublished measured pair has
+               |rho| at or below it (the list is the strongest k), which is the only thing an
+               absent pair can be said to show. It is VERIFIED, never assumed (audit v6,
+               should-fix 1): None unless every published pair carries a finite rho, the |rho|
+               run is non-increasing in published order, and len(pairs_top) == pairs_summary.top_k.
+    """
+    try:
+        if doc is None:
+            doc = read_cluster_doc(path)
+        if doc is None:
+            raise ValueError("unreadable")
+        ps = doc.get("pairs_summary") or {}
+        measured = _strict(ps.get("pairs_measured"))
+        top_k = _strict(ps.get("top_k"))
+        top = doc.get("pairs_top") or {}
+        published = len(top)
+        raw = [_pair_rho(v) for v in top.values()]
+    except Exception:
+        return {"truncated": None, "published": len(pairs or {}), "measured": None,
+                "rho_floor": None, "why": "CLUSTER_JUDGE.json absent or unreadable"}
+    trunc = None if measured is None else measured > published
+    floor = None
+    why = None
+    if trunc:
+        if not raw or any(r is None for r in raw):
+            why = "a published pair carries no finite measured rho"
+        elif any(abs(raw[i + 1]) > abs(raw[i]) for i in range(len(raw) - 1)):
+            why = "published |rho| is not non-increasing: the list is not the strongest k"
+        elif top_k is None or published != top_k:
+            why = f"len(pairs_top) {published} != pairs_summary.top_k {ps.get('top_k')!r}"
+        else:
+            floor = abs(raw[-1])
+    out = {"truncated": trunc, "published": published, "measured": measured, "rho_floor": floor}
+    if why:
+        out["rho_floor_why"] = f"rho_floor unverified: {why}"
+    return out
+
+
+def _pair_rho(pair: Mapping[str, Any] | None) -> float | None:
+    """The pair's rho when it is MEASURED (a finite rho, not marked UNMEASURED), else None."""
+    if not isinstance(pair, Mapping) or str(pair.get("status") or "MEASURED") != "MEASURED":
+        return None
+    return _strict(pair.get("rho"))
+
+
+def _member(row: Any) -> bool:
+    """A Tier-S member row of the judge (only those carry a pair count), with its own series."""
+    return (isinstance(row, Mapping) and _strict(row.get("measured_pairs")) is not None
+            and not str(row.get("ledger_status") or "").startswith("UNMEASURED"))
+
+
+def cluster_status(row: Mapping[str, Any] | None, now: datetime) -> tuple[str, str]:
+    """(flag, status) for one promotion_input row; flag is "" whenever it is UNMEASURED."""
+    if not isinstance(row, Mapping):
+        return "", "UNMEASURED: malformed row"
+    flag = str(row.get("concentration_flag") or "")
+    led = str(row.get("ledger_status") or "")
+    if not flag or flag.startswith("UNMEASURED"):
+        why = row.get("flag_why") or row.get("why") or flag or "no flag"
+        return "", f"UNMEASURED: {why}"
+    if led.startswith("UNMEASURED"):
+        return "", f"{led}: the clock's correlation evidence is not its own ledger"
+    gen = _ts(row.get("generated_utc"))
+    if gen is None:
+        return "", "UNMEASURED: artifact carries no readable generated_utc"
+    if gen > now:
+        return "", f"UNMEASURED: artifact stamped {gen.isoformat()} after the pass (look-ahead)"
+    if now - gen > FRESH_FOR:
+        return "", f"UNMEASURED: stale ({now - gen} old > {FRESH_FOR})"
+    if flag == FLAG_DUPLICATE and not row.get("duplicate_group"):
+        return "", "UNMEASURED: duplicate flag with no group"
+    if flag == FLAG_CONCENTRATED and (_strict(row.get("max_pair_corr")) is None
+                                      or not row.get("cluster_id")):
+        return "", "UNMEASURED: concentrated flag with no measured max_pair_corr/cluster"
+    return flag, flag
+
+
+def apply_cluster(book: Mapping[str, float], bounds: Mapping[str, float], *,
+                  now: datetime | None = None, kelly: Mapping[str, float] | None = None,
+                  path: Path | None = None, reader: Any = None,
+                  pairs: Mapping[frozenset[str], Mapping[str, Any]] | None = None,
+                  pairs_summary: Mapping[str, Any] | None = None
+                  ) -> tuple[dict[str, float], dict[str, Any]]:
+    """PROPOSE the cluster-judge tilt on `book`. Never raises; the total is conserved."""
+    t = now or datetime.now(tz=UTC)
+    base = {k: float(v) for k, v in book.items() if _fin(v) is not None and float(v) > 0}
+    meta: dict[str, Any] = {"mode": "cluster_judge_tilt", "shrink": CLUSTER_SHRINK,
+                            "grow": CLUSTER_GROW, "fresh_for_h": FRESH_FOR.total_seconds() / 3600,
+                            "by_sleeve": {}, "proposed": {}, "applied": {},
+                            "duplicate_groups": {}, "kelly_cap": ("supplied" if kelly
+                                                                  else "not supplied")}
+    try:
+        read = reader or _cluster_reader(path)
+        if pairs is None:
+            doc = read_cluster_doc(path)        # one parse feeds both (audit v6, should-fix 3)
+            pairs = cluster_pairs(path, doc=doc) if doc is not None else {}
+            if pairs_summary is None:
+                pairs_summary = cluster_pairs_summary(path, pairs, doc=doc)
+        summ = dict(pairs_summary or {"truncated": False, "published": len(pairs),
+                                      "measured": len(pairs), "rho_floor": None})
+        meta["pairs_published"] = summ
+        truncated = summ.get("truncated")
+        rho_floor = _strict(summ.get("rho_floor"))
+        # Sleeves whose measurement, had it been readable, could have MOVED them: a nothing-
+        # proposed pass with any of these is UNMEASURED, never a 0.0 sample (L1.28a).
+        blocked: dict[str, str] = {}
+        meta["unmeasured_binding"] = blocked
+        rows: dict[str, Mapping[str, Any]] = {}
+        partner_rows: dict[str, Any] = {}
+        flags: dict[str, str] = {}
+        for s in base:
+            try:
+                row = read(s)
+            except Exception as exc:
+                row = {"concentration_flag": "UNMEASURED",
+                       "why": f"{type(exc).__name__}: {exc}"}
+            flag, status = cluster_status(row, t)
+            rows[s] = row if isinstance(row, Mapping) else {}
+            partner_rows[s] = row if flag else None     # a stale/unmeasured row is no member
+            flags[s] = flag
+            meta["by_sleeve"][s] = {"status": status, "multiplier": 1.0}
+        out = dict(base)
+        shrunk: set[str] = set()
+        grown: set[str] = set()
+
+        def _lead(members: list[str]) -> str:
+            return sorted(members, key=lambda k: (-base[k], k))[0]
+
+        groups: dict[str, list[str]] = {}
+        for s, f in flags.items():
+            if f == FLAG_DUPLICATE:
+                groups.setdefault(str(rows[s]["duplicate_group"]), []).append(s)
+        for g, members in groups.items():
+            if len(members) < 2:              # its twin is not funded: nothing counted twice
+                meta["by_sleeve"][members[0]]["status"] += " (only funded member: unchanged)"
+                continue
+            keep = _lead(members)
+            pooled = sum(base[m] for m in members)
+            b_ = _fin(bounds.get(keep))
+            out[keep] = min(pooled, max(b_ if b_ is not None else base[keep], base[keep]))
+            for m in members:
+                if m != keep:
+                    out[m] = 0.0
+                    shrunk.add(m)
+                    meta["by_sleeve"][m]["multiplier"] = 0.0
+            if out[keep] > base[keep]:
+                grown.add(keep)
+            meta["by_sleeve"][keep]["multiplier"] = round(out[keep] / base[keep], 6)
+            meta["duplicate_groups"][g] = {"sized": keep, "zeroed": sorted(set(members) - {keep})}
+        dup_touched = {m for ms in groups.values() if len(ms) > 1 for m in ms}
+        # CONCENTRATED, PAIRWISE: walk the funded book largest-first; a sleeve whose MEASURED,
+        # significant pair with an ALREADY-SIZED funded sleeve is at or above CONCENTRATED_RHO is
+        # shrunk. Cluster membership (single linkage) and a max over unfunded clocks never count.
+        sized: list[str] = []
+        for s in sorted(base, key=lambda k: (-base[k], k)):
+            if s in dup_touched:
+                continue
+            hit = None
+            if flags.get(s) == FLAG_CONCENTRATED:
+                for p in sized:
+                    pr = pairs.get(frozenset((s, p)))
+                    rho = _pair_rho(pr)
+                    # a missing significant_pos is NOT significant (audit v5, should-fix 3)
+                    if (rho is not None and rho >= CONCENTRATED_RHO
+                            and (pr or {}).get("significant_pos") is True):
+                        hit = (p, rho)
+                        break
+            if hit:
+                out[s] = base[s] * CLUSTER_SHRINK
+                shrunk.add(s)
+                meta["by_sleeve"][s].update(multiplier=CLUSTER_SHRINK,
+                                            concentrated_with=hit[0], rho=round(hit[1], 4))
+            else:
+                if flags.get(s) == FLAG_CONCENTRATED:
+                    # pairs_top publishes MEASURED pairs only: an omitted pair with a sized
+                    # funded sleeve is UNMEASURED whether or not the list is complete (audit v6
+                    # must-fix). The one exception: a truncated list whose verified rho_floor is
+                    # below CONCENTRATED_RHO shows the omitted pair is not concentrated.
+                    shown_weak = (truncated is True and rho_floor is not None
+                                  and rho_floor < CONCENTRATED_RHO)
+                    # EVERY funded partner, sized yet or not (audit v7 must-fix, probe H2): the
+                    # verdict on an unpublished funded pair never depends on which is larger.
+                    missing = [p for p in sorted(base, key=lambda k: (-base[k], k))
+                               if p != s and frozenset((s, p)) not in pairs]
+                    if missing and not shown_weak:
+                        if truncated is True:
+                            why = (f"pair with funded {missing[0]} not published (pairs_top "
+                                   f"top_k: {summ.get('published')} of {summ.get('measured')} "
+                                   f"measured, weakest published |rho| {rho_floor})")
+                        elif truncated is False:
+                            why = (f"pair with funded {missing[0]} not published on a complete "
+                                   "pairs_top: the judge did not measure it")
+                        else:
+                            why = (f"pair with funded {missing[0]} not readable (pairs_top "
+                                   "completeness unknown)")
+                        meta["by_sleeve"][s]["status"] = f"UNMEASURED: {why}"
+                        blocked[s] = why
+                    else:
+                        meta["by_sleeve"][s]["status"] += (
+                            " (no measured concentrated pair with a funded sleeve: unchanged)")
+                sized.append(s)
+        # INDEPENDENT, PAIRWISE, OVER THE FUNDED BOOK ONLY (audit v5, should-fix 4): every OTHER
+        # funded sleeve must be a judged member, and this sleeve's pair with it must be shown
+        # below INDEPENDENT_RHO -- published with a measured rho under the bar, or, when the
+        # list is truncated, unpublished while the smallest published |rho| is itself under the
+        # bar (an unpublished pair is no stronger than the weakest one published). A rho to an
+        # UNFUNDED clock never blocks a grow; one unjudged funded partner or one unshown pair is
+        # UNMEASURED and nothing moves.
+        for s, f in flags.items():
+            if f != FLAG_INDEPENDENT:
+                continue
+            why = None
+            if _strict(rows[s].get("unmeasured_pairs")) != 0:
+                why = f"{rows[s].get('unmeasured_pairs')!r} unmeasured pair(s)"
+            else:
+                for p in base:
+                    if p == s:
+                        continue
+                    if not _member(partner_rows.get(p)):
+                        why = f"funded partner {p} is not a judged member: its pair is unmeasured"
+                        break
+                    key = frozenset((s, p))
+                    if key in pairs:
+                        rho = _pair_rho(pairs[key])
+                        if rho is None:
+                            why = f"pair with funded {p} published but not measured"
+                            break
+                        if rho >= INDEPENDENT_RHO:
+                            why = (f"measured rho {rho:.3f} with funded {p} not below "
+                                   f"{INDEPENDENT_RHO}")
+                            break
+                    elif not (truncated and rho_floor is not None
+                              and rho_floor < INDEPENDENT_RHO):
+                        why = (f"pair with funded {p} not published (pairs_top "
+                               f"{summ.get('published')} of {summ.get('measured')} measured, "
+                               f"weakest published |rho| {rho_floor})")
+                        break
+            if why:
+                meta["by_sleeve"][s].update(status=f"UNMEASURED: independence not shown ({why})",
+                                            multiplier=1.0)
+                blocked[s] = f"grow blocked: {why}"
+                continue
+            caps = [c for c in (_fin(bounds.get(s)), _fin((kelly or {}).get(s))) if c is not None]
+            cap = min(caps) if caps else base[s]
+            out[s] = max(base[s], min(base[s] * CLUSTER_GROW, cap))
+            meta["by_sleeve"][s].update(cap=cap, multiplier=CLUSTER_GROW)
+            if out[s] > base[s]:
+                grown.add(s)
+        zeroed = frozenset(m for g in meta["duplicate_groups"].values() for m in g["zeroed"])
+        # a zeroed duplicate gets heat back only when no other place can hold it inside its
+        # bound: the book is never short, and that case is named (last_resort_returned).
+        out = _conserve(base, out, shrunk, grown, bounds, meta, return_last=zeroed)
+        meta["status"] = "PROPOSED" if meta["proposed"] else "NOT_BINDING"
+        return out, meta
+    except Exception as exc:
+        meta.update(status="UNMEASURED", why=f"{type(exc).__name__}: {exc}", proposed={})
+        return dict(book), meta
