+def test_probe_s1_nine_decaying_worst_dd_free_stays_in_bounds() -> None:
+    from research.heat_policy import MAX_SLEEVE_HEAT_SHARE, per_sleeve_bounds
+    names = [f"s{i}" for i in range(10)]
+    dd = dict.fromkeys(names, 10.0)
+    dd["s9"] = 300.0                                        # the worst drawdown, left free
+    bounds = per_sleeve_bounds(dd, 0.30)
+    book = {n: min(0.03, bounds[n]) for n in names}
+    book["s0"] += 0.30 - _total(book)                       # resolved 0.30 exactly
+    rows = {n: _row("DECAYING") for n in names[:9]}
+    out, meta = ds.apply(book, bounds, now=NOW, reader=_reader(rows))
+    assert abs(_total(out) - _total(book)) < 1e-12 and meta["unfilled_heat"] == 0.0
+    assert out["s9"] <= max(bounds["s9"], book["s9"]) + 1e-12
+    assert out["s9"] / _total(out) <= MAX_SLEEVE_HEAT_SHARE + 1e-12
+    assert ds.survival_breach({"p_ruin": 0.0, "p_dd_over_tolerance": 0.0}, 0.2, book=out,
+                              untilted=book, bounds=bounds,
+                              share_cap=MAX_SLEEVE_HEAT_SHARE) is None
+    # and the v2 spill (all of it onto s9) is now caught by the per-sleeve re-check
+    spilled = {**{n: book[n] * 0.5 for n in names[:9]}}
+    spilled["s9"] = 0.30 - _total(spilled)
+    assert ds.survival_breach({"p_ruin": 0.0, "p_dd_over_tolerance": 0.0}, 0.2, book=spilled,
+                              untilted=book, bounds=bounds, share_cap=MAX_SLEEVE_HEAT_SHARE)
