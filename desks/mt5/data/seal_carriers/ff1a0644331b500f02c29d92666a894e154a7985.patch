+def account_key_of(path: Path = ACCOUNT) -> tuple[str | None, str]:
+    """The account the equity belongs to: "<login>@<server>" (account_profile.account_key's
+    shape), or "withheld@<server>/<currency>" when the publisher withholds the login. A file
+    that names no server identifies no account: (None, why)."""
+    doc = _read(Path(path))
+    if not isinstance(doc, dict):
+        return None, f"UNMEASURED: {Path(path).name} absent or unreadable"
+    server = doc.get("server")
+    if not isinstance(server, str) or not server:
+        return None, "UNMEASURED: account_state names no server (account not identifiable)"
+    login = doc.get("login")
+    ch = doc.get("challenge_id")
+    tail = ""
+    if ch is not None:
+        if isinstance(ch, bool) or not isinstance(ch, (str, int)) or not str(ch).strip():
+            return None, "UNMEASURED: account_state challenge_id is blank or not a str/int"
+        tail = f"#{str(ch).strip()}"
+    if isinstance(login, (str, int)) and not isinstance(login, bool) and str(login):
+        return f"{login}@{server}{tail}", "login@server" + (" #challenge" if tail else "")
+    cur = doc.get("currency")
+    return (f"withheld@{server}/{cur if isinstance(cur, str) else '?'}{tail}",
+            "login withheld" + (" #challenge" if tail else ""))
