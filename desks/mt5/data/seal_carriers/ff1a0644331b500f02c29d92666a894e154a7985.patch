+def test_cushion_grow_never_above_what_the_gateway_deploys():
+    """decision_core scales a book above the published heat.total back onto it, so a grow is
+    bounded by the resolved total; a book already AT it has nothing to grow into."""
+    rng = np.random.default_rng(7)
+    for _ in range(500):
+        book = {k: float(v) for k, v in zip("abcd", rng.uniform(0.01, 0.08, 4), strict=True)}
+        tot = sum(book.values())
+        dep = tot * float(rng.uniform(0.9, 1.3))
+        out, info = sm.cushion_apply(book, BOUNDS, float(rng.uniform(1.0, 1.5)),
+                                     ceiling=float(rng.uniform(0.15, 0.40)), share_cap=0.25,
+                                     deploy_total=dep)
+        assert sum(out.values()) <= max(dep, tot) + 1e-9
+    out, info = sm.cushion_apply(BOOK, BOUNDS, 1.5, ceiling=0.27, share_cap=0.25,
+                                 deploy_total=0.2)
+    assert out == BOOK and info["status"] == "UNDEPLOYABLE" and info["undeployable_grow"] > 0
