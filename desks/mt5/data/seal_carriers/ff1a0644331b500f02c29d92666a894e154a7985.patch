+SHADOW_DIR = DESK / "reports" / "shadow"
+SLEEVES = DESK / "data" / "sleeves.json"
+ACCOUNT = DESK / "data" / "account_state.json"
+PEAK_FILE = DESK / "data" / "DD_CUSHION_PEAK.json"
+BOCPD_SWITCH = DESK / "data" / "BOCPD_KELLY_APPLY.json"
+CUSHION_SWITCH = DESK / "data" / "DD_CUSHION_APPLY.json"
+STATE_FILES = ("shadow_state.json", "qquant_shadow_state.json", "scalp_shadow_state.json",
+               "external_shadow_state.json")
+
+SHRINK, GROW = 0.5, 1.5
+MIN_TRADES = 20
+RESET_RL = 6
+STABLE_RL = 60.0
+HAZARD_LAMBDA = 50.0
+FUSION_FLOOR_EUR = 300.0
+#: The reference state the resolved heat is read as calibrated for: REF_DD of the drawdown
+#: tolerance below peak. At peak the cushion is larger and the book grows; near the floor smaller.
+REF_DD = 0.5
+ACCOUNT_FRESH_FOR = timedelta(hours=6)
+EPS = 1e-12
