+def _ledger_name(key: str) -> str:
+    return f"ledger_{str(key).split('#')[0].replace('.', '_')}.json"
+
+
+def _read(p: Path) -> Any:
+    try:
+        return json.loads(p.read_text("utf-8"))
+    except (OSError, ValueError):
+        return None
