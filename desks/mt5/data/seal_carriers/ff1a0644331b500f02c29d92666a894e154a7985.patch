+def test_fuzz_no_tilt_held_sleeve_ever_ends_above_its_tilted_value():
+    rng = np.random.default_rng(11)
+    names = list("abcdefg")
+    for _ in range(600):
+        k = int(rng.integers(2, 8))
+        book = {n: float(v) for n, v in zip(names[:k], rng.uniform(0.005, 0.08, k), strict=True)}
+        bounds = {n: float(v) * float(rng.uniform(0.8, 3.0)) for n, v in book.items()}
+        hold = {n: v for n, v in book.items() if rng.random() < 0.4}
+        rows = {n: (_stable(80, float(rng.normal(0.3, 0.3))) if rng.random() < 0.5 else _reset())
+                for n in book if rng.random() < 0.7}
+        out, _m = sm.bocpd_apply(book, bounds, now=NOW, series=_series(rows), share_cap=0.25,
+                                 hold_at=hold)
+        assert abs(sum(out.values()) - sum(book.values())) < 1e-9
+        for n, h in hold.items():
+            assert out[n] <= h + 1e-12, (n, out[n], h)
+        tot = sum(book.values())
+        for n, v in out.items():
+            assert v <= max(0.25 * tot, book[n]) + 1e-9, (n, v)
+        c_out, _ = sm.cushion_apply(out, bounds, float(rng.uniform(1.0, 1.5)),
+                                    ceiling=float(rng.uniform(0.1, 0.6)), share_cap=0.25,
+                                    deploy_total=tot * float(rng.uniform(1.0, 1.4)),
+                                    hold_at=hold)
+        r = sum(c_out.values())
+        for n, h in hold.items():
+            assert c_out[n] <= max(h, out[n]) + 1e-12
+        for n, v in c_out.items():
+            assert v <= max(0.25 * r, out[n]) + 1e-9, (n, v, r)
+
