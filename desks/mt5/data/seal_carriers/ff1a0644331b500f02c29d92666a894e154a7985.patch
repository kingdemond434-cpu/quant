+#: Above this magnitude a squared deviation can overflow a float64 (1e300 ** 2 = inf); such a
+#: series is not a return series and is refused as non-finite.
+MAX_ABS_OBS = 1e100
+
+
+def _lgamma(v: Any) -> Any:
+    import numpy as np
+    return np.fromiter((math.lgamma(float(t)) for t in v), dtype=float, count=len(v))
+
+
+def bocpd_run_length(x: Any, *, hazard_lambda: float = 50.0, mu0: float = 0.0,
+                     kappa0: float = 1.0, alpha0: float = 1.0, beta0: float = 1.0) -> Any:
+    """Run-length posterior P(r_t | x_1..t) after the LAST observation, as a numpy array whose
+    index is the run length (0 = a change point at the last step). Normal observations with an
+    unknown mean and precision (Normal-Gamma prior), constant hazard 1/hazard_lambda. Causal by
+    construction: step t sees x_1..x_t only. Computed in LOG space (log-sum-exp normalisation),
+    so no predictive density under- or overflows. An empty series, a non-finite one, or one with
+    |x| > MAX_ABS_OBS returns [1.0]."""
+    import numpy as np
+    xs = np.asarray(x, dtype=float).ravel()
+    if xs.size == 0 or not np.all(np.isfinite(xs)) or float(np.max(np.abs(xs))) > MAX_ABS_OBS:
+        return np.array([1.0])
+    lh, l1h = math.log(1.0 / float(hazard_lambda)), math.log1p(-1.0 / float(hazard_lambda))
+    logpost = np.array([0.0])
+    mu, kap = np.array([mu0]), np.array([kappa0])
+    al, be = np.array([alpha0]), np.array([beta0])
+    for v in xs:
+        df = 2.0 * al
+        scale2 = be * (kap + 1.0) / (al * kap)
+        z = (v - mu) ** 2 / (df * scale2)
+        logp = (_lgamma((df + 1.0) / 2.0) - _lgamma(df / 2.0)
+                - 0.5 * np.log(np.pi * df * scale2) - (df + 1.0) / 2.0 * np.log1p(z))
+        joint = logpost + logp
+        m = float(np.max(joint))
+        cp = m + math.log(float(np.sum(np.exp(joint - m)))) + lh
+        logpost = np.concatenate(([cp], joint + l1h))
+        top = float(np.max(logpost))
+        logpost = logpost - (top + math.log(float(np.sum(np.exp(logpost - top)))))
+        mu_n = (kap * mu + v) / (kap + 1.0)
+        be_n = be + kap * (v - mu) ** 2 / (2.0 * (kap + 1.0))
+        mu = np.concatenate(([mu0], mu_n))
+        be = np.concatenate(([beta0], be_n))
+        kap = np.concatenate(([kappa0], kap + 1.0))
+        al = np.concatenate(([alpha0], al + 0.5))
+    post = np.exp(logpost)
+    return post / post.sum()
+
+
