+def _sha(obj: Any) -> str:
+    """sha256 over CANONICAL JSON: sorted keys, no whitespace, floats at full repr precision."""
+    import hashlib
+    blob = json.dumps(obj, sort_keys=True, separators=(",", ":"), default=str, allow_nan=True)
