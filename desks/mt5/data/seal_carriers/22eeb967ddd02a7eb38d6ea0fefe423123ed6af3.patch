+               "The one family whose output is a scored claim about a sleeve's return."),
+    FamilySpec("garch_vol", _f(R.VOLATILITY_SCALE, R.UNCERTAINTY_WIDTH, R.VETO_STALENESS),
+               1 * DAY, 2 * DAY, True, True,
