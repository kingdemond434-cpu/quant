+def measured_bar(heat: dict[str, Any], floor: float) -> tuple[float, str]:
+    """The bar the GATEWAY binds at, read through the gateway's own rule (`live_heat_ceiling`):
+    one rule, two readers. An unmeasured survival surface holds the fallback; the floor is never
+    flagged as a ceiling breach."""
+    from mt5desk.decision_core import live_heat_ceiling
+    cap, why = live_heat_ceiling(heat)
+    return max(float(cap), floor), why
+
