diff --git a/tests/test_check_heat_floor_wiring.py b/tests/test_check_heat_floor_wiring.py
new file mode 100644
index 0000000000000000000000000000000000000000..42c59893a5112539ee87edbb8a799353bad67aba
--- /dev/null
+++ b/tests/test_check_heat_floor_wiring.py
@@ -0,0 +1,55 @@
+"""THE HEAT FENCE READS THE GATEWAY'S BAR, NOT A FLAT 30% (#1013, BACKLOG W0).
+
+With the 30% cap removed ("no cap, fallback 20%"), a measured heat above 30% that sits inside the
+allocator's MEASURED operative ceiling is the law working, not a breach. The fence reads that bar
+through `decision_core.live_heat_ceiling`, the same rule the gateway sizes by, so the two can never
+disagree: an UNMEASURED survival surface holds the recorded fallback in both.
+"""
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+from types import ModuleType
+
+ROOT = Path(__file__).resolve().parents[1]
+DESK = ROOT / "desks" / "mt5"
+if str(DESK) not in sys.path:
+    sys.path.insert(0, str(DESK))
+
+from mt5desk import decision_core as dc  # noqa: E402
+
+
+def _fence() -> ModuleType:
+    spec = importlib.util.spec_from_file_location(
+        "check_heat_floor_wiring", ROOT / "scripts" / "check_heat_floor_wiring.py")
+    assert spec and spec.loader
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _heat(op: object, surv: str) -> dict[str, object]:
+    return {"envelope": {"operative_ceiling": op, "survival": {"status": surv}}}
+
+
+def test_a_measured_bar_above_thirty_is_the_bar() -> None:
+    bar, _ = _fence().measured_bar(_heat(0.36, "MEASURED"), 0.20)
+    assert bar == min(0.36, dc.ABSOLUTE_SIM_MAX)
+
+
+def test_unmeasured_survival_holds_the_gateways_fallback() -> None:
+    bar, _ = _fence().measured_bar(_heat(0.36, "UNMEASURED"), 0.20)
+    assert bar == max(float(dc.MAX_HEAT_CEILING), 0.20)
+    assert bar == max(dc.live_heat_ceiling(_heat(0.36, "UNMEASURED"))[0], 0.20)
+
+
+def test_fence_and_gateway_read_one_rule() -> None:
+    f = _fence()
+    for heat in (_heat(0.36, "MEASURED"), _heat(0.36, "UNMEASURED"), _heat("nan", "MEASURED"),
+                 _heat(0.15, "MEASURED"), {}):
+        assert f.measured_bar(heat, 0.20)[0] == max(dc.live_heat_ceiling(heat)[0], 0.20)
+
+
+def test_a_bar_below_the_floor_never_flags_the_floor_itself() -> None:
+    assert _fence().measured_bar(_heat(0.15, "MEASURED"), 0.20)[0] == 0.20
